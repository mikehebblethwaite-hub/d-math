// Dc: an apple moves to Bob, then breaks down. Nothing vanishes.
int main(int argc, char **argv)
{
    int apple = $D, mike = 1, bob = 1;
    int sugar = 1, energy = 1, heat = 1, poo = 1;
    move 1 from mike to bob;
    say("apple %d, before: sugar %d energy %d heat %d poo %d\n", apple, sugar, energy, heat, poo);
    apple D> sugar + energy + heat + poo ~;
    say("apple %d, after:  sugar %d energy %d heat %d poo %d, ~ %d\n", apple, sugar, energy, heat, poo, ~);
    return 1;
}
