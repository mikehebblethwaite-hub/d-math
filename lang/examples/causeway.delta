    fd = ".............................................................................................................................................................11..................87.................493................197.................592................295.................791................394.................88.................492.....17877777778796.......7777777777771.............................................................................................24..................491..................77..................293..................68..................194..................591..................85..................391..................77..................293..................77.................194.................68.................292.................87...........166665691...........27777774.............................................................................................................444444444443.......18999999999993..................68..................195..................491..................86..................392..................78..................294..................69..................185..................87.................491................195.................69............36666694............3777776...................................................................................................................................................................................................................22222222...........5999999993.........29422222268.........77.......194.......392........491......86..........86.....491..........392...195............77...68.............86..293............491..67.........266695...11.........27776..........................................................................................56666662...........596666688..........194.....194.........68.......491.......293........86.......77.........392.....391..........86.....95..........392....58........35595.....77........68871.....193..................58..................195..................491..................86..................292..................68..................14.................................................................................................177777771...........696666696..........293.....392.........87.......77........492.......293.......96.........681.....591.........392....194..........77.....68........66792.....77........6774......194..................591.................195..................491..................87..................292..................69666666666664......17777777777775.........................................................................................................................................................................................4888882............19644487............68....193..........293.....581.........87......194....34..491....23681....86..77.....5993....59...392.....11....194....78...........68.....194.........292......59.........86........875666665791........37777777774.................................................................................................33..................68..................195..................491..................86........156665....392.......7977794....77......392...491...193.....86.....86....58....491.....392....95..194....11581...293..59.....5993....86...293....132....491....59..........195.....195.........58.......491.......193........88566666587.........27777777772.......................................................................................66666666666.........666666666695..................391..................87..................293........133333....68........6988992...194......293...77....491.....86....193....86....491.....591...392..195......68....492..59.....6992...195...292....243....58.....68..........193.....194.........77.......49........392........87555555596.........37777777771..........................................................................................................................................................................1666666675..........79666666793........392.......68........86........194......591..57662..491....194..396688...86....68...85..195..392..292..591...491..77..76..293...587..194..11..293...661..68........68.......293........195......87..........4965665691...........67777774..........................................................................................455555553..........49888888892........194.......68........68........194......293..34442..591.....77..198898...85....391..68..194..391...95..292...491..77..581..86...4781..85..77..194...683..59...293..591......194....68...85......68.....194..3944444492......491..69888896........86..................392..................78..................23..................................................................................................1677777776..........69566666694........293.......59........77.........95......392..47773..491.....86..2966791..87....491..77...85..292..194..391...391..77..68..185...587..194..67..195...572..68...194..491......293....591..86......77......85..2966666792......392..47777774........77..................293..................6956666666562.......1777777777773...................................................................................................................................................2222222............399999994...........8611111591.........591.111..86........194.49995.392.......68.1962591.77......293.59...86.293.23..77.194..793.591.87..581186..34.194.491...96.392....68.195....392.69777793.68......77.1666664.293......293........77........696666666692........17777777775................................................................................................................................................................................................................................................................................................12..........21.....28982......28982...1984981....1894891..692.297....792.296..23...594..495...32........792297..............189981...............1551....................................................................";
    int i;
    hexcircle();
    window_open("The Giant's Causeway in D: Delta");
    W = window_wide(); H = window_high(); CW = W * 4;
    HW = W / 2; HH = H / 2;
    BS = isqrt(HW * HH / NC) + 1; BW = HW / BS + 1; BH = HH / BS + 1;
    for (i = 1; i <= W * H + W + 2; i++) wn[i] = 168;
    ix1 = W; ix2 = 1; iy1 = H; iy2 = 1;

    int replay = 1;
    while (replay) {
    replay = low;
    scatter();
    // the heat, in kilojoules for this patch of sheet: it moves to the air above and the ground below; the
    // ground and air pass it on out through the border, to the Shrug (waste: not traced further yet)
    int lava = 1B31659, air = 1, ground = 1, start = lava + air + ground + shrug();
    int f;
    for (f = 1; f <= 41B; f++) {
        FR = f;
        int up = lava / 6C, down = lava / $DB;
        if (up >= 1) move up from lava to air;
        if (down >= 1) move down from lava to ground;
        int outa = air / 48, outg = ground / 125;
        if (outa >= 1) shrug outa from air;
        if (outg >= 1) shrug outg from ground;
        int hot = lava * 168 / 1B31659;               // how hot the lava still is, of 255
        if (f > $C) { buckets(); shares(); if (f % 4 == 1) count(); settle(); }
        else { buckets(); shares(); }
        paint(f > $C ? hot : 168);
        band();
        tx = 24; ty = less(H, $AA);
        text("The Giant's Causeway in D: lava cooling, every column sharing its pull evenly with its neighbours.", 151, 154, 15B);
        text("  No hexagon is drawn.", $B7, 149, $C4);
        tx = 24; ty = less(H, 82);
        label("sides counted, columns away from the border:  five"); value(S5, 6); label("six"); value(S6, 4);
        label("seven"); value(S7, 6); label("other"); value(SO, 5); label("   step"); value(f, 6);
        tx = 24; ty = less(H, 57);
        label("heat, kJ:  lava"); value(lava, 1); label("air"); value(air, 1); label("ground"); value(ground, 1);
        label("Shrug (waste: past the border, not traced yet)"); value(shrug(), 5);
        int total = lava + air + ground + shrug();
        tx = 24; ty = less(H, 31);
        label("all together"); value(total, 6);
        if (total == start) text("= the start: nothing vanished", $B7, 149, $C4); else text("NOT the start", 168, 6C, 6C);
        text("      r: replay   q: close", 93, 9B, $AA);
        window_show(&px[CW + 5]);
        int key = window_key();
        if (key == 1B || key == 9) return 1;
        if (key == 21) { replay = 1; break; }
    }
    while (replay < 1) {
        int key = window_key();
        if (key == 1B || key == 9) return 1;
        if (key == 21) replay = 1;
        wait(3B);
    }
    }
    return 1;
}
