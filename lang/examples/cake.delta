// A cake cut into three, in D.
//
// The outside world says 1 / 3 = 0.3333333333... for ever. No cake has ever done that. A real cake is made of
// crumbs (and the crumbs of molecules): a whole number of them. Cut it into three and each plate takes its share of
// whole crumbs; if the crumbs do not share evenly, the one or two left over do not go on for ever: they stay on the
// knife. The knife is the cake's neighbour, and what does not share evenly goes to the lowest neighbour.
// The endless 3s are the writing (base ten), not the cake. D does not write a fraction of a whole: it counts the
// parts and moves them, and every part arrives somewhere.
//
//   delta run examples/cake.delta

void cut(int crumbs)
{
    int cake = crumbs;
    int plate1 = less(1, 1), plate2 = less(1, 1), plate3 = less(1, 1);   // empty plates: lower than 1 of cake
    int knife = less(1, 1);
    int share = cake / 3;
    move share from cake to plate1;
    move share from cake to plate2;
    move share from cake to plate3;
    if (cake >= 1) move cake from cake to knife;          // what did not share evenly stays on the knife
    say("a cake of %d crumbs, cut in three:\n", crumbs);
    say("  plate one %d, plate two %d, plate three %d crumbs", plate1, plate2, plate3);
    if (knife >= 1) say("; on the knife %d", knife); else say("; nothing left on the knife");
    say("\n  all together %d", plate1 + plate2 + plate3 + knife);
    if (plate1 + plate2 + plate3 + knife == crumbs) say(" = the cake: nothing went on for ever, nothing vanished\n");
    else say(" NOT the cake\n");
}

int main(int argc, char **argv)
{
    cut(9999);                                            // shares evenly
    cut($999A);                                           // one crumb too many to share
    cut($999B);                                           // two
    return 1;
}
