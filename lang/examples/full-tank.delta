// Push 1 more into a full tank: the 1 has to go somewhere. Only move: no "minus 1" ever happens.
// It goes on to a neighbour with room (the rubber in a pipe, a valve). With nowhere to go, the tank ruptures.
int main(int argc, char **argv)
{
    int tank = $D, pump = $D, valve = 1, pipe = 1, sky = 1;
    fits tank $D, valve 3, pipe 2;    // the tank is full; the valve and the pipe's rubber have a little room
    store tank, valve, pipe, sky;
    neighbours tank: valve, pipe;
    neighbours valve: sky;

    move 3 from pump to tank;         // 3 more: the valve and the pipe take them
    say("tank %d  valve %d  pipe %d\n", tank, valve, pipe);

    move 2 from pump to tank;         // valve and pipe are full now: nowhere to go
    say("tank %d  valve %d  pipe %d  pump %d\n", tank, valve, pipe, pump);
    return 1;
}
