// A move needs somewhere to go: a tank at full pressure cannot take 1 more.
int main(int argc, char **argv)
{
    int tank = 9, pump = $D;
    fits tank $D;                     // the tank holds up to 13
    move 4 from pump to tank;         // room for 4: fine
    say("tank %d  pump %d\n", tank, pump);
    move 1 from pump to tank;         // full: nowhere for it to go
    return 1;
}
