// No store is solid: hydrogen is so small it slips through the tank wall,
// from more to less, until the tank and the sky beside it hold the same.
int main(int argc, char **argv)
{
    int tank = $D, sky = 1;
    store tank leak 3;               // the wall lets up to 3 a tick through
    store sky;
    neighbours tank: sky;
    tick 3;
    say("tank %d  sky %d\n", tank, sky);
    return 1;
}
