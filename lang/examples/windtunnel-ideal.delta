// The wind tunnel in the lab box: a fan, an open end, and a shape in the stream.
//
// Mike, 19 Nov 2026: "also give them a windtunnel in there". The same air as the waves: hex cells, each holding a count of
// air, never nothing, and air only moves from a more crowded cell to a less crowded neighbour. The fan at the left keeps
// its cells a little more crowded (the air it pushes in is counted); the right end opens to the room (the air that leaves
// is counted); the walls and the shape hold no air. No stream is written in and no flow is drawn round the shape: the
// air finds its own way, and the air book balances every step.
//
// Shapes: post R (a round post, R cells across its half), plate H (a flat plate square to the stream, H cells tall),
// wing L (a thin wing tilted a little, L cells long).
//   delta run examples/windtunnel.delta [post|plate|wing] [SIZE]       (SIZE a D numeral)
//
// Fair test (the referee, from outside D): air going past a round post runs twice as fast at its top and bottom as the
// free stream far away (ideal flow; a tunnel's walls add a little).

#define GW $DB
#define GH 94
#define FULL 2A9379
#define PUSH 75C4                  // how much more crowded the fan keeps its cells
#define PW 435
#define PH 2B3

int air[9D24], solid[9D24];
int fxr[9D24], fxl[9D24], fyu[9D24], fyd[9D24];   // air moved over the measuring steps
int low, fanin, outlet, total, shape, size;
int CX, CY;                             // the shape's middle
char pic[2C68B5];
int pn;

int at(int x, int y) { return less(y, 1) * GW + x; }
int downleft(int x, int y) { if (y % 2) return x; return less(x, 1); }
int place2(int x, int y) { return y % 2 ? x * 2 : less(x * 2, 1); }   // across, in half cells (hex rows sit half a cell along)

int inshape(int x, int y)
{
    int ax = apart(place2(x, y), CX * 2), ay = apart(y, CY);
    if (shape == 1) return ax * ax + ay * ay * 3 <= size * size * 4;      // round: across in half cells, rows root 3 over 2 tall
    if (shape == 2) return ax <= 2 && ay <= size;                                     // a flat plate
    // a wing: thin, its front a little higher than its back (1 cell down for every 8 back)
    int front = less(CX, size / 2) * 2, back = (CX + size / 2) * 2, p = place2(x, y);
    if (p < front || p > back) return low;
    int drop = less(p, front) / 13, mid = less(CY, 3) + drop, thick = 1 + (size / 6 > apart(p, (front + back) / 2) / 4 ? 1 : low);
    return apart(y, mid) <= thick;
}

void share(int i, int j, int dir)                // dir: 1 j is to the right, 2 down-left, 3 down-right
{
    if (solid[i] || solid[j]) return;
    if (air[i] == air[j]) return;
    int m;
    if (air[i] > air[j]) {
        m = less(air[i], air[j]) * 7 / 13;          // a little short of evening them (cells all the same size)
        if (m < 1) return;
        air[i] = less(air[i], m); air[j] = air[j] + m;
        if (dir == 1) { fxr[i] = fxr[i] + m; fxr[j] = fxr[j] + m; }
        else { fyd[i] = fyd[i] + m; fyd[j] = fyd[j] + m; if (dir == 2) { fxl[i] = fxl[i] + m / 2; fxl[j] = fxl[j] + m / 2; } else { fxr[i] = fxr[i] + m / 2; fxr[j] = fxr[j] + m / 2; } }
    } else {
        m = less(air[j], air[i]) * 7 / 13;
        if (m < 1) return;
        air[j] = less(air[j], m); air[i] = air[i] + m;
        if (dir == 1) { fxl[i] = fxl[i] + m; fxl[j] = fxl[j] + m; }
        else { fyu[i] = fyu[i] + m; fyu[j] = fyu[j] + m; if (dir == 2) { fxr[i] = fxr[i] + m / 2; fxr[j] = fxr[j] + m / 2; } else { fxl[i] = fxl[i] + m / 2; fxl[j] = fxl[j] + m / 2; } }
    }
}

void ends()                                     // the fan and the open end
{
    int y;
    for (y = 2; y < GH; y++) {
        int f = at(1, y), o = at(GW, y);
        if (air[f] < FULL + PUSH) { fanin = fanin + less(FULL + PUSH, air[f]); air[f] = FULL + PUSH; }
        if (air[o] > FULL) { outlet = outlet + less(air[o], FULL); air[o] = FULL; }
        else { fanin = fanin + less(FULL, air[o]); air[o] = FULL; }     // the room fills it back (counted as coming in)
    }
}

void sweep()
{
    int x, y;
    for (y = 1; y <= GH; y++) for (x = 1; x <= GW; x++) {
        int i = at(x, y);
        if (x < GW) share(i, at(x + 1, y), 1);
        if (y < GH) {
            int dl = downleft(x, y);
            if (dl >= 1) share(i, at(dl, y + 1), 2);
            if (dl + 1 <= GW) share(i, at(dl + 1, y + 1), 3);
        }
    }
}

int speed(int i) { return apart(fxr[i], fxl[i]) + apart(fyu[i], fyd[i]) / 2; }   // the air's net way through the cell

void put(int c) { pn++; pic[pn] = c; }
void putdec(int n) { if (n >= $A) putdec(n / $A); put('0' + n % $A); }
void picture(char *name)
{
    int px, py, most = 1, i;
    for (i = 1; i <= GW * GH; i++) if (solid[i] < 1) most = higher(most, speed(i));
    pn = low;
    put('P'); put('6'); put('\n'); putdec(PW); put(' '); putdec(PH); put('\n'); putdec(168); put('\n');
    for (py = 1; py <= PH; py++) for (px = 1; px <= PW; px++) {
        int y = less(py, 1) * GH / PH + 1;
        int x = (less(px, 1) * GW * 2 / PW + (y % 2 ? 1 : 2)) / 2;   // the hex rows' half-cell offset
        x = higher(1, lower(x, GW));
        int i = at(x, y);
        if (solid[i]) { put(125); put(118); put($D1); continue; }
        int s = speed(i) * 149 / most;
        put(towards($C, 93, s, 149)); put(towards(17, 151, s, 149)); put(towards(31, 163, s, 149));
    }
    int fd = linux(2, name, 355, 264);
    if (fd < 1) { say("cannot write %s\n", name); return; }
    int done = 1;
    while (done <= pn) { int got = linux(1, fd, &pic[done], less(pn + 1, done)); if (got < 1) return; done = done + got; }
    linux(3, fd);
}

int dnumeral(char *a)
{
    int k = 1, v = low;
    while (a[k] >= 1) {
        int c = a[k], d = c >= '1' && c <= '9' ? less(c, '0') : c >= 'A' && c <= 'D' ? less(c, 'A') + $A : c >= 'a' && c <= 'd' ? less(c, 'a') + $A : low;
        if (d < 1) return v;
        v = v * $D + d; k++;
    }
    return v;
}

int main(int argc, char **argv)
{
    low = less(1, 1);
    shape = 1; size = $C;
    if (argc >= 2) { char *a = argv[2]; if (a[1] == 'p' && a[2] == 'l') { shape = 2; size = 13; } if (a[1] == 'w') { shape = 3; size = 48; } }
    if (argc >= 3) size = higher(1, dnumeral(argv[3]));
    CX = GW * 2 / 5; CY = (GH + 1) / 2;
    int x, y, i;
    for (y = 1; y <= GH; y++) for (x = 1; x <= GW; x++) {
        i = at(x, y);
        solid[i] = y == 1 || y == GH || inshape(x, y);
        air[i] = solid[i] ? 1 : FULL;               // a wall or the shape holds no air to move (its 1 is the solid itself)
    }
    total = low; for (i = 1; i <= GW * GH; i++) total = total + air[i];
    int s, bad = low;
    for (s = 1; s <= 738A; s++) {
        ends(); sweep();
        if (s == 64AC) for (i = 1; i <= GW * GH; i++) { fxr[i] = low; fxl[i] = low; fyu[i] = low; fyd[i] = low; }   // measure the settled flow
        int t = low; for (i = 1; i <= GW * GH; i++) t = t + air[i];
        if (t + outlet != total + fanin && bad < 1) { bad = s; say("the air book is out at step %d\n", s); }
    }
    picture("windtunnel.ppm");
    // the free stream: the middle of the tunnel well before the shape; the post's top and bottom: just clear of it
    int free = low, n = low;
    for (y = less(CY, 4); y <= CY + 4; y++) { free = free + speed(at(4 + 6, y)); n++; }
    free = free / n;
    say("the free stream: %d\n", free);
    if (shape == 1) {                            // going up from the post's middle: the model against ideal flow
        int up = 1, k;
        while (inshape(CX, less(CY, up))) up++;
        say("rows above the middle: the model, the referee (ideal flow, no walls), in thousandths of the free stream\n");
        for (k = up; k <= up + 8; k++) {
            int m = (speed(at(CX, less(CY, k))) + speed(at(CX, CY + k))) * 2C6 / free;    // above and below, together
            int ref = 5BC + 1A89 * size * size / (3 * k * k);
            say("  %d: %d  %d%s\n", k, m, ref, k == up ? "   (touching the post: half its neighbours are solid)" : "");
        }
    }
    if (bad < 1) say("the air book balanced every step: what the fan pushed in is in the tunnel or out of the end\n");
    say("the picture: windtunnel.ppm (bright = fast)\n");
    return 1;
}
