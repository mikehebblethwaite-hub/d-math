// The classic simple motor, standing on Faraday's shoulders (Michael Faraday, 1821: the first
// electric motor was a homopolar motor like this). A 1.5 V AA battery stands on a neodymium magnet;
// a bent copper wire touches the battery's top and the magnet's side.
//
// Current runs battery -> wire -> sliding contact -> magnet -> battery. Each part it passes through
// turns a share into heat in proportion to its resistance (typical values):
//   battery's own resistance 0.15 ohm, sliding contact 0.1 ohm, copper wire (10 cm, 0.5 mm) 0.009 ohm,
//   magnet 0.001 ohm: about 0.26 ohm in all, so about 5.8 A and 8.7 W.
// Only the push on the wire, F = B I L (B about 0.3 T, I 5.8 A, L 2 cm: 0.035 N), turns it:
//   at 1 cm and about 10 turns a second that is about 22 mW, roughly 1 part in 400.
// So the shares, as weights: battery 232 (14B), contact 152 (B9), wire 14 (11), magnet 2, spin 1.

int main(int argc, char **argv)
{
    int chemistry = $DDDD;                   // the energy the battery holds
    int current = 1;                         // the current, passing through
    int cell = 1, contact = 1, wire = 1, magnet = 1, spin = 1, air = 1, drag = 3;

    store chemistry, cell, contact, wire, magnet, spin, air;
    conduct current loss 1 per $DDD;         // even the current's path loses a little: there is always some

    neighbours chemistry: current;
    neighbours current: cell $14B, contact $B9, wire 11, magnet 2, spin 1;
    store cell leak 9, contact leak 9, wire leak 9, magnet leak 9;
    neighbours cell: air heat;               // the warm parts warm the air, from more to less
    neighbours contact: air heat;
    neighbours wire: air heat;
    neighbours magnet: air heat;
    wear spin by drag D> air ~;              // air drag slows the wire: its spin becomes warm air

    int start = cell + contact + wire + magnet + spin + air + current;
    say("== a moment of current: DDD units of the battery's energy\n");
    spend $DDD from chemistry;
    say("   in each part: battery %d, contact %d, wire %d, magnet %d, spin %d\n", cell, contact, wire, magnet, spin);

    say("== then the warmth spreads to the air and the air slows the wire\n");
    tick 3;

    say("\nof DDD spent: spin %d; still warm: battery %d, contact %d, wire %d, magnet %d; air %d\n",
        spin, cell, contact, wire, magnet, air);
    say("all together: %d = DDD spent + the %d the parts started with: nothing vanished\n",
        cell + contact + wire + magnet + spin + air + current, start);
    return 1;
}
