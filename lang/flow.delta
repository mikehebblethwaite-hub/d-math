// Delta flow: spent energy goes to its neighbours. Written in Delta, so it keeps D's rules.
// store     = a neighbour that absorbs what it gets
// conductor = passes energy on to its other neighbours, less its loss; the loss is heat,
//             and heat goes to all its neighbours, and so on.
// A share less than 1 is ~ (unknown energy). Every step is shown.

int *dl_val[$DDD];
char *dl_name[$DDD];
int dl_kind[$DDD];             // 1 store, 2 conductor
int dl_loss[$DDD];
char dl_link[$DDD][$DDD];      // 1 = neighbours
int dl_next = 1;               // the next thing's number

int dl_thing(int *v, char *nm, int kind, int loss)
{
    for (int i = 1; i < dl_next; i++)
        if (dl_val[i] == v) {
            if (kind != 3) { dl_kind[i] = kind; dl_loss[i] = loss; }
            return i;
        }
    if (dl_next > $DDD) { say("Delta: more things than this machine has places for\n"); stop(2); }
    int id = dl_next;
    dl_val[id] = v; dl_name[id] = nm; dl_loss[id] = loss;
    dl_kind[id] = kind == 3 ? 1 : kind;      // new and not said: a store
    dl_next++;
    return id;
}

void dl_link2(int a, int b) { dl_link[a][b] = (char)1; dl_link[b][a] = (char)1; }

void dl_pad(int depth) { for (int i = 1; i <= depth; i++) say("  "); }

void dl_flow(int id, int came, int a, int depth)
{
    dl_pad(depth);
    if (depth > $DD) {                    // safety: energy circling round conductors
        say("energy is still going round at %s: stopped here\n", dl_name[id]); stop(2);
    }
    if (dl_kind[id] == 1) {
        int room = dl_room(dl_val[id]), take = a, back = a, sink;
        if (take > room) take = room;
        if (take >= 1) {
            *dl_val[id] += take; move take from back to sink;
            say("%s takes %d (store, now %d)\n", dl_name[id], take, *dl_val[id]);
        }
        if (back >= 1) {                     // it is full: the rest goes back where it came from
            if (take >= 1) dl_pad(depth);
            *dl_val[came] += back;
            say("%s is full: %d goes back to %s\n", dl_name[id], back, dl_name[came]);
        }
        return;
    }
    int on = a; int heat;
    if (a > dl_loss[id]) move dl_loss[id] from on to heat;
    else move a from on to heat;
    say("%s gets %d: passes %d on, %d to heat\n", dl_name[id], a, on, heat);
    if (on >= 1) dl_share(id, came, on, depth + 1, "on");
    dl_share(id, id, heat, depth + 1, "heat");
}

void dl_share(int id, int skip, int amount, int depth, char *what)
{
    int k;
    for (int j = 1; j < dl_next; j++) if (dl_link[id][j] && j != skip) k++;
    if (k < 1) {
        dl_pad(depth); say("%d %s stays in %s as ~ (no neighbour to take it)\n", amount, what, dl_name[id]);
        move amount from amount to ~; return;
    }
    int share = amount / k, rest = amount % k;
    if (share < 1) {
        dl_pad(depth); say("%d %s is too thin to share %d ways: ~\n", amount, what, k);
        move amount from amount to ~; return;
    }
    if (rest >= 1) {
        dl_pad(depth); say("%d %s does not share evenly: ~\n", rest, what);
        move rest from rest to ~;
    }
    for (int j = 1; j < dl_next; j++) if (dl_link[id][j] && j != skip) dl_flow(j, id, share, depth);
}

void dl_spend(int id, int n)
{
    int out;
    move n from *dl_val[id] to out;
    say("spend %d from %s (now %d)\n", n, dl_name[id], *dl_val[id]);
    dl_share(id, id, out, 1, "spent");
}

// Leaks: no store is solid. Each tick a leaking store loses up to its leak, through its wall,
// to its neighbours (small things like hydrogen slip through fastest: give them a bigger leak).
int dl_leak[$DDD];

void dl_setleak(int id, int n) { dl_leak[id] = n; }

// Wear: outside forces (sunlight's photons on rubber, weather, use) break a thing down each tick.
// Never presume the amount placed stays that amount. How much wears depends on its neighbour:
// wear rubber by sun per 4  ->  each tick the rubber wears (the sun's amount / 4).
int dl_wfrom[$DDD], dl_wby[$DDD], dl_wper[$DDD], dl_wparts[$DDD][$D], dl_wn[$DDD];
int dl_wnext = 1;

void dl_wear(int id, int by, int per) { dl_wfrom[dl_wnext] = id; dl_wby[dl_wnext] = by; dl_wper[dl_wnext] = per; dl_wnext++; }

void dl_wear_part(int id)
{
    int w;
    for (int i = 1; i < dl_wnext; i++) w = i;          // the last wear made
    if (dl_wn[w] >= $D) { say("Delta: a wear has more than D parts\n"); stop(2); }
    dl_wn[w]++;
    dl_wparts[w][dl_wn[w]] = id;
}

void dl_wear1()
{
    for (int w = 1; w < dl_wnext; w++) {
        int id = dl_wfrom[w], by = dl_wby[w];
        if (*dl_val[id] < 1) continue;
        int amount = *dl_val[by] / dl_wper[w];
        if (amount < 1) { dl_pad(1); say("%s: %s is too weak to wear it this tick\n", dl_name[id], dl_name[by]); continue; }
        if (amount > *dl_val[id]) amount = *dl_val[id];
        int out;
        move amount from *dl_val[id] to out;
        dl_pad(1); say("%s wears %d by %s (now %d)\n", dl_name[id], out, dl_name[by], *dl_val[id]);
        int share = out / dl_wn[w], rest = out % dl_wn[w];
        if (share < 1) { dl_pad(2); say("%d is too thin to share %d ways: ~\n", out, dl_wn[w]); move out from out to ~; continue; }
        for (int k = 1; k <= dl_wn[w]; k++) {
            int part = dl_wparts[w][k], room = dl_room(dl_val[part]), take = share, back = share, sink;
            if (take > room) take = room;
            if (take >= 1) {
                *dl_val[part] += take; move take from back to sink;
                dl_pad(2); say("%s takes %d (now %d)\n", dl_name[part], take, *dl_val[part]);
            }
            if (back >= 1) {                 // no room in that part: it stays in the whole
                *dl_val[id] += back;
                dl_pad(2); say("%s is full: %d stays in %s\n", dl_name[part], back, dl_name[id]);
            }
        }
        if (rest >= 1) { dl_pad(2); say("%d left over: ~\n", rest); move rest from rest to ~; }
    }
}

// how much more a holds than b (1 or more), or ~ when it holds no more
int dl_more(int a, int b)
{
    int d = a, sink;
    if (b >= 1) { if (b >= a) return d / (d + 1); move b from d to sink; }
    return d;
}

int dl_clock;                  // time so far: it only runs on

void dl_tick1(int t)
{
    dl_clock++;
    say("tick %d\n", dl_clock);
    for (int i = 1; i < dl_next; i++) {
        if (dl_leak[i] < 1 || *dl_val[i] < 1) continue;
        int lower;
        for (int j = 1; j < dl_next; j++) if (dl_link[i][j] && dl_more(*dl_val[i], *dl_val[j]) >= 2) lower++;
        if (lower < 1) { dl_pad(1); say("%s holds: no neighbour holds less\n", dl_name[i]); continue; }
        int budget = dl_leak[i], per = dl_leak[i] / lower, given;
        if (per < 1) per = 1;
        for (int j = 1; j < dl_next && budget >= 1; j++) {
            if (!dl_link[i][j]) continue;
            int half = dl_more(*dl_val[i], *dl_val[j]) / 2;
            if (half < 1) continue;
            int g = per, room = dl_room(dl_val[j]);
            if (g > half) g = half;
            if (g > budget) g = budget;
            if (g > room) g = room;
            if (g < 1) { dl_pad(1); say("%s cannot leak to %s: it is full\n", dl_name[i], dl_name[j]); continue; }
            move g from *dl_val[i] to *dl_val[j] and g from budget to given;
            dl_pad(1); say("%s leaks %d to %s (now %d, %s now %d)\n", dl_name[i], g, dl_name[j], *dl_val[i], dl_name[j], *dl_val[j]);
        }
    }
    dl_wear1();
}
