// Delta flow: spent energy goes to its neighbours. Written in Delta, so it keeps D's rules.
// store     = a neighbour that absorbs what it gets
// conductor = passes energy on to its other neighbours, less its loss; the loss is heat,
//             and heat goes to all its neighbours, and so on.
// A share less than 1 is ~ (unknown energy). Every step is shown.

int *dl_val[$DDD];
char *dl_name[$DDD];
int dl_kind[$DDD];             // 1 store, 2 conductor
int dl_loss[$DDD];
char dl_link[$DDD][$DDD];      // 1 = neighbours
int dl_next = 1;               // the next thing's number

int dl_thing(int *v, char *nm, int kind, int loss)
{
    for (int i = 1; i < dl_next; i++)
        if (dl_val[i] == v) {
            if (kind != 3) { dl_kind[i] = kind; dl_loss[i] = loss; }
            return i;
        }
    if (dl_next > $DDD) { say("Delta: more things than this machine has places for\n"); stop(2); }
    int id = dl_next;
    dl_val[id] = v; dl_name[id] = nm; dl_loss[id] = loss;
    dl_kind[id] = kind == 3 ? 1 : kind;      // new and not said: a store
    dl_next++;
    return id;
}

void dl_link2(int a, int b) { dl_link[a][b] = (char)1; dl_link[b][a] = (char)1; }

void dl_pad(int depth) { for (int i = 1; i <= depth; i++) say("  "); }

void dl_flow(int id, int came, int a, int depth)
{
    dl_pad(depth);
    if (depth > $DD) {                    // safety: energy circling round conductors
        say("energy is still going round at %s: stopped here\n", dl_name[id]); stop(2);
    }
    if (dl_kind[id] == 1) {
        int room = dl_room(dl_val[id]), take = a, back = a, sink;
        if (take > room) take = room;
        int others;
        for (int j = 1; j < dl_next; j++) if (dl_link[id][j] && j != came) others++;
        if (take >= 2 && others >= 1) {          // it warms: its vibration passes half on to its other neighbours
            int pass = take / 2, keep = take;
            move pass from keep to sink;
            *dl_val[id] += keep; move take from back to sink;
            say("%s takes %d (store, now %d): its vibration passes %d on\n", dl_name[id], keep, *dl_val[id], pass);
            dl_share(id, came, pass, depth + 1, "heat");
        } else if (take >= 1) {
            *dl_val[id] += take; move take from back to sink;
            say("%s takes %d (store, now %d)\n", dl_name[id], take, *dl_val[id]);
        }
        if (back >= 1) {                     // it is full: the rest goes back where it came from
            if (take >= 1) dl_pad(depth);
            *dl_val[came] += back;
            say("%s is full: %d goes back to %s\n", dl_name[id], back, dl_name[came]);
        }
        return;
    }
    int on = a; int heat;
    if (a > dl_loss[id]) move dl_loss[id] from on to heat;
    else move a from on to heat;
    say("%s gets %d: passes %d on, %d to heat\n", dl_name[id], a, on, heat);
    if (on >= 1) dl_share(id, came, on, depth + 1, "on");
    dl_share(id, id, heat, depth + 1, "heat");
}

void dl_share(int id, int skip, int amount, int depth, char *what)
{
    int k;
    for (int j = 1; j < dl_next; j++) if (dl_link[id][j] && j != skip) k++;
    if (k < 1) { dl_hand(id, amount, skip, depth, what); return; }
    int share = amount / k, rest = amount % k;
    if (share < 1) { dl_hand(id, amount, skip, depth, what); return; }
    for (int j = 1; j < dl_next; j++) if (dl_link[id][j] && j != skip) dl_flow(j, id, share, depth);
    if (rest >= 1) dl_hand(id, rest, skip, depth, what);     // what does not share evenly: 1 at a time
}

// The base rule: 1 less in a thing is 1 more in its lowest neighbour. Nothing disappears.
// n has already left id; it goes 1 at a time to the lowest neighbour (not skip) that has room.
// No neighbour has room: to the lowest one, which passes it on. No neighbours at all: the unknown world, ~.
void dl_hand(int id, int n, int skip, int depth, char *what)
{
    int got[$DDD], last, sink;
    while (n >= 1) {
        int best, full;
        for (int j = 1; j < dl_next; j++) {
            if (!dl_link[id][j] || j == skip) continue;
            if (dl_room(dl_val[j]) >= 1) { if (best < 1 || *dl_val[j] < *dl_val[best]) best = j; }
            else if (full < 1 || *dl_val[j] < *dl_val[full]) full = j;
        }
        if (best < 1 && full < 1 && skip != id && dl_link[id][skip] && skip >= 1) best = skip;   // only back where it came from
        if (best < 1 && full >= 1) {
            dl_pad(depth); say("%d %s%sgoes to %s, the lowest neighbour (full: it passes it on)\n", n, what, what[1] ? " " : "", dl_name[full]);
            int all = n;
            move all from n to *dl_val[full];
            dl_overflow(dl_val[full], dl_name[full]);
            break;
        }
        if (best < 1) {
            dl_pad(depth); say("%d %s%s: %s has no neighbours: it goes out to the unknown world, ~\n", n, what, what[1] ? " " : "", dl_name[id]);
            move n from n to ~;
            break;
        }
        move 1 from n to *dl_val[best];
        got[best]++;
    }
    for (int j = 1; j < dl_next; j++)
        if (got[j] >= 1) { dl_pad(depth); say("%d %s%sto %s, the lowest neighbour (now %d)\n", got[j], what, what[1] ? " " : "", dl_name[j], *dl_val[j]); }
}

// move N from x;  (no "to"): it goes to x's lowest neighbour
void dl_moveout(int *at, int n, char *nm)
{
    int id;
    for (int i = 1; i < dl_next; i++) if (dl_val[i] == at) id = i;
    if (id < 1) { say("Delta: %s has no neighbours: say where it goes (move N from %s to y;)\n", nm, nm); stop(2); }
    int out;
    move n from *at to out;
    say("%s gives %d (now %d)\n", nm, out, *at);
    dl_hand(id, out, id, 1, "");
}

// a thing set lower (x = 3 when it held 9): the 6 goes to its lowest neighbours. Nothing vanishes.
void dl_lower(int *at, int now)
{
    int id;
    for (int i = 1; i < dl_next; i++) if (dl_val[i] == at) id = i;
    if (id < 1 || now >= *at) return;
    int d = *at, sink;
    if (now >= 1) move now from d to sink;
    int out;
    move d from *at to out;
    say("%s is set %d lower (now %d)\n", dl_name[id], out, *at);
    dl_hand(id, out, id, 1, "");
}

void dl_spend(int id, int n)
{
    int out;
    move n from *dl_val[id] to out;
    say("spend %d from %s (now %d)\n", n, dl_name[id], *dl_val[id]);
    dl_share(id, id, out, 1, "spent");
}

// Leaks: no store is solid. Each tick a leaking store loses up to its leak, through its wall,
// to its neighbours (small things like hydrogen slip through fastest: give them a bigger leak).
int dl_leak[$DDD];

void dl_setleak(int id, int n) { dl_leak[id] = n; }

// Wear: outside forces (sunlight's photons on rubber, weather, use) break a thing down each tick.
// Never presume the amount placed stays that amount. How much wears depends on its neighbour:
// wear rubber by sun per 4  ->  each tick the rubber wears (the sun's amount / 4).
int dl_wfrom[$DDD], dl_wby[$DDD], dl_wper[$DDD], dl_wparts[$DDD][$D], dl_wn[$DDD];
int dl_wnext = 1;

void dl_wear(int id, int by, int per) { dl_wfrom[dl_wnext] = id; dl_wby[dl_wnext] = by; dl_wper[dl_wnext] = per; dl_wnext++; }

void dl_wear_part(int id)
{
    int w;
    for (int i = 1; i < dl_wnext; i++) w = i;          // the last wear made
    if (dl_wn[w] >= $D) { say("Delta: a wear has more than D parts\n"); stop(2); }
    dl_wn[w]++;
    dl_wparts[w][dl_wn[w]] = id;
}

void dl_wear1()
{
    for (int w = 1; w < dl_wnext; w++) {
        int id = dl_wfrom[w], by = dl_wby[w];
        if (*dl_val[id] < 1) continue;
        int amount = *dl_val[by] / dl_wper[w];
        if (amount < 1) { dl_pad(1); say("%s: %s is too weak to wear it this tick\n", dl_name[id], dl_name[by]); continue; }
        if (amount > *dl_val[id]) amount = *dl_val[id];
        int out;
        move amount from *dl_val[id] to out;
        dl_pad(1); say("%s wears %d by %s (now %d)\n", dl_name[id], out, dl_name[by], *dl_val[id]);
        int share = out / dl_wn[w], rest = out % dl_wn[w];
        if (share < 1) { int all = out; move all from out to rest; }     // too thin to share: 1 at a time below
        for (int k = 1; k <= dl_wn[w] && share >= 1; k++) {
            int part = dl_wparts[w][k], room = dl_room(dl_val[part]), take = share, back = share, sink;
            if (take > room) take = room;
            if (take >= 1) {
                *dl_val[part] += take; move take from back to sink;
                dl_pad(2); say("%s takes %d (now %d)\n", dl_name[part], take, *dl_val[part]);
            }
            if (back >= 1) {                 // no room in that part: it stays in the whole
                *dl_val[id] += back;
                dl_pad(2); say("%s is full: %d stays in %s\n", dl_name[part], back, dl_name[id]);
            }
        }
        while (rest >= 1) {                  // what does not share evenly: 1 at a time to the lowest part with room
            int best;
            for (int k = 1; k <= dl_wn[w]; k++) {
                int part = dl_wparts[w][k];
                if (dl_room(dl_val[part]) >= 1 && (best < 1 || *dl_val[part] < *dl_val[dl_wparts[w][best]])) best = k;
            }
            if (best < 1) { int all = rest; move all from rest to *dl_val[id];
                            dl_pad(2); say("its parts are full: %d stays in %s\n", all, dl_name[id]); break; }
            int part = dl_wparts[w][best];
            move 1 from rest to *dl_val[part];
            dl_pad(2); say("1 to %s, the lowest part (now %d)\n", dl_name[part], *dl_val[part]);
        }
    }
}

// how much more a holds than b (1 or more), or ~ when it holds no more
int dl_more(int a, int b)
{
    int d = a, sink;
    if (b >= 1) { if (b >= a) return d / (d + 1); move b from d to sink; }
    return d;
}

int dl_clock;                  // time so far: it only runs on

void dl_tick1(int t)
{
    dl_clock++;
    say("tick %d\n", dl_clock);
    for (int i = 1; i < dl_next; i++) {
        if (dl_leak[i] < 1 || *dl_val[i] < 1) continue;
        int lower;
        for (int j = 1; j < dl_next; j++) if (dl_link[i][j] && dl_more(*dl_val[i], *dl_val[j]) >= 2) lower++;
        if (lower < 1) { dl_pad(1); say("%s holds: no neighbour holds less\n", dl_name[i]); continue; }
        int budget = dl_leak[i], per = dl_leak[i] / lower, given;
        if (per < 1) per = 1;
        for (int j = 1; j < dl_next && budget >= 1; j++) {
            if (!dl_link[i][j]) continue;
            int half = dl_more(*dl_val[i], *dl_val[j]) / 2;
            if (half < 1) continue;
            int g = per, room = dl_room(dl_val[j]);
            if (g > half) g = half;
            if (g > budget) g = budget;
            if (g > room) g = room;
            if (g < 1) { dl_pad(1); say("%s cannot leak to %s: it is full\n", dl_name[i], dl_name[j]); continue; }
            move g from *dl_val[i] to *dl_val[j] and g from budget to given;
            dl_pad(1); say("%s leaks %d to %s (now %d, %s now %d)\n", dl_name[i], g, dl_name[j], *dl_val[i], dl_name[j], *dl_val[j]);
        }
    }
    dl_wear1();
}

// Rupture: push 1 into a full tank and it bursts. What it held goes out to its neighbours that hold less,
// one at a time to the lowest, until it is level with them (if the atmosphere holds more, it holds).
void dl_release(int *at, char *nm)
{
    int id;
    for (int i = 1; i < dl_next; i++) if (dl_val[i] == at) id = i;
    if (id < 1) {
        dl_pad(1); say("no neighbours given: %d goes out to the unknown world: ~\n", *at);
        if (*at >= 1) move *at from *at to ~;
        return;
    }
    int got[$DDD];
    while (*at >= 1) {
        int best;
        for (int j = 1; j < dl_next; j++)
            if (dl_link[id][j] && dl_more(*at, *dl_val[j]) >= 2 && dl_room(dl_val[j]) >= 1)
                if (best < 1 || *dl_val[j] < *dl_val[best]) best = j;
        if (best < 1) break;
        move 1 from *at to *dl_val[best];
        got[best]++;
    }
    int any;
    for (int j = 1; j < dl_next; j++)
        if (got[j] >= 1) { dl_pad(1); say("%s takes %d (now %d)\n", dl_name[j], got[j], *dl_val[j]); any++; }
    if (any < 1) { dl_pad(1); say("no neighbour holds less: %s holds %d (its neighbours push back)\n", nm, *at); }
    else { dl_pad(1); say("%s now holds %d\n", nm, *at); }
}

void dl_rupture(int *at, char *nm)
{
    say("BANG! %s ruptured: pushed past full\n", nm);
    dl_unfit(at);
    dl_release(at, nm);
}

// Overflow: pushed past full, the extra has to go somewhere. It moves on to the neighbours that have room
// (the rubber in a pipe, a valve), most room first. Only if no neighbour can take it does the tank rupture.
int dl_busy[$DDD];             // already passing something on (so it never goes round in circles)

void dl_overflow(int *at, char *nm)
{
    int over = *at, cap = dl_capof(at), sink;
    if (over <= cap) return;
    move cap from over to sink;
    say("%s is full: %d has to go somewhere\n", nm, over);
    int id;
    for (int i = 1; i < dl_next; i++) if (dl_val[i] == at) id = i;
    int got[$DDD];
    while (over >= 1 && id >= 1) {
        int best, bestroom;
        for (int j = 1; j < dl_next; j++) {
            if (!dl_link[id][j]) continue;
            int r = dl_room(dl_val[j]);
            if (r >= 1 && (best < 1 || r > bestroom)) { best = j; bestroom = r; }
        }
        if (best < 1) break;
        move 1 from *at to *dl_val[best] and 1 from over to sink;
        got[best]++;
    }
    for (int j = 1; j < dl_next; j++)
        if (got[j] >= 1) { dl_pad(1); say("%s takes %d (now %d)\n", dl_name[j], got[j], *dl_val[j]); }
    // no neighbour has room: pass it on through a full neighbour (a valve to the sky), which overflows in turn
    if (over >= 1 && id >= 1) {
        dl_busy[id] = 1;
        for (int j = 1; j < dl_next && over >= 1; j++) {
            if (!dl_link[id][j] || dl_busy[j]) continue;
            int onward;
            for (int k = 1; k < dl_next; k++) if (dl_link[j][k] && !dl_busy[k]) onward++;
            if (onward < 1) continue;                // nothing beyond it: it cannot pass anything on
            dl_pad(1); say("%s passes %d on through %s\n", nm, over, dl_name[j]);
            int n = over;
            move n from *at to *dl_val[j] and n from over to sink;
            dl_overflow(dl_val[j], dl_name[j]);
        }
        dl_busy[id] = dl_busy[id] / $D;          // done here (LOW)
    }
    if (over >= 1) dl_rupture(at, nm);
}
