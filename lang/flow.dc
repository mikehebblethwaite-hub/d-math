// Dc flow: spent energy goes to its neighbours. Written in Dc, so it keeps D's rules.
// store     = a neighbour that absorbs what it gets
// conductor = passes energy on to its other neighbours, less its loss; the loss is heat,
//             and heat goes to all its neighbours, and so on.
// A share less than 1 is ~ (unknown energy). Every step is shown.

int *dc_val[$DDD];
char *dc_name[$DDD];
int dc_kind[$DDD];             // 1 store, 2 conductor
int dc_loss[$DDD];
char dc_link[$DDD][$DDD];      // 1 = neighbours
int dc_next = 1;               // the next thing's number

int dc_thing(int *v, char *nm, int kind, int loss)
{
    for (int i = 1; i < dc_next; i++)
        if (dc_val[i] == v) {
            if (kind != 3) { dc_kind[i] = kind; dc_loss[i] = loss; }
            return i;
        }
    if (dc_next > $DDD) { say("Dc: more things than this machine has places for\n"); stop(2); }
    int id = dc_next;
    dc_val[id] = v; dc_name[id] = nm; dc_loss[id] = loss;
    dc_kind[id] = kind == 3 ? 1 : kind;      // new and not said: a store
    dc_next++;
    return id;
}

void dc_link2(int a, int b) { dc_link[a][b] = (char)1; dc_link[b][a] = (char)1; }

void dc_pad(int depth) { for (int i = 1; i <= depth; i++) say("  "); }

void dc_flow(int id, int came, int a, int depth)
{
    dc_pad(depth);
    if (depth > $DD) {                    // safety: energy circling round conductors
        say("energy is still going round at %s: stopped here\n", dc_name[id]); stop(2);
    }
    if (dc_kind[id] == 1) {
        *dc_val[id] += a;
        say("%s takes %d (store, now %d)\n", dc_name[id], a, *dc_val[id]);
        return;
    }
    int on = a; int heat;
    if (a > dc_loss[id]) move dc_loss[id] from on to heat;
    else move a from on to heat;
    say("%s gets %d: passes %d on, %d to heat\n", dc_name[id], a, on, heat);
    if (on >= 1) dc_share(id, came, on, depth + 1, "on");
    dc_share(id, id, heat, depth + 1, "heat");
}

void dc_share(int id, int skip, int amount, int depth, char *what)
{
    int k;
    for (int j = 1; j < dc_next; j++) if (dc_link[id][j] && j != skip) k++;
    if (k < 1) {
        dc_pad(depth); say("%d %s stays in %s as ~ (no neighbour to take it)\n", amount, what, dc_name[id]);
        move amount from amount to ~; return;
    }
    int share = amount / k, rest = amount % k;
    if (share < 1) {
        dc_pad(depth); say("%d %s is too thin to share %d ways: ~\n", amount, what, k);
        move amount from amount to ~; return;
    }
    if (rest >= 1) {
        dc_pad(depth); say("%d %s does not share evenly: ~\n", rest, what);
        move rest from rest to ~;
    }
    for (int j = 1; j < dc_next; j++) if (dc_link[id][j] && j != skip) dc_flow(j, id, share, depth);
}

void dc_spend(int id, int n)
{
    int out;
    move n from *dc_val[id] to out;
    say("spend %d from %s (now %d)\n", n, dc_name[id], *dc_val[id]);
    dc_share(id, id, out, 1, "spent");
}
