// The weather balloon in the atmosphere room (floor 2; Mike 21 Nov 2026: "do me a rising balloon expands as it reaches the
// upper atmosphere then pops in real atmosphere see what it does in ours"). The same column of air as lang/lab/runs/atmos.delta
// (which matched: it bursts at 30,580 m), worked out live as it climbs, gravity from the Earth's mass at each height: each 10 m up the pressure drops by the weight of that air;
// air full of water vapour cools as it rises (water condensing gives warmth back); above 11 km the sky's warmth is MEASURED
// (standard atmosphere), not worked out. The balloon: rubber, 2 m across at launch, bursts at its maker's size, 8.63 m; it rises
// about 5 m a second; each picture is 30 seconds of flight (MAGIC: time sped up). The atmosphere room stands for the sky from
// the ground to 100 km, where space is said to begin (Mike: "make sure your room is the right height"): its 20 ft are those
// 100 km, 1 ft for every 5 km (MAGIC: the drawing scale), so the balloon climbs through the room; drawn a fifth of its size.
#define BLEVEL 17CB892A
int GMASS = 5BC;                              // the Earth's mass in thousandths of its own (the gravity changer)
// The Earth's real shape, as lang/lab/runs/atmos.delta (which MATCHES measured gravity to 0.005%): flattened (6,378,137 m to the
// equator, 6,356,752 to a pole) and the bulge's own pull (J2, measured from satellites); the place: 45 degrees, its circle of
// latitude 28,385 km (measured). No cosine, no pi.
int BAXIS, BPLANE2, BSURF;
void bshape() { int ea = 142415C, eb = 14174BC; BAXIS = ea * $CBC6 / 15319; int bx = eb * (BAXIS / 5BC) / (ea / 5BC);
    BPLANE2 = less(eb * eb, bx * bx); BSURF = isqrt(BAXIS * BAXIS + BPLANE2); }
int gpull(int zm)
{
    if (BSURF < 1) bshape();
    int R = BSURF + zm, g = 2B7846B5518 * GMASS / R * 5BC / R * 5BC;      // G x the Earth's mass / R^2, micrometres a second squared
    int aR = 142415C * 5BC / (R / 5BC), lean = BPLANE2 / (R * R / 28D221) * 3;
    int bulge = g / 5BC * 44B21B / 28D221 * (aR * aR / 28D221) / 28D221;   // g x 1.5 J2 x (a/R)^2
    if (lean >= 28D221) g = less(g, bulge * less(lean, 28D221) / 28D221); else g = g + bulge * less(28D221, lean) / 28D221;
    int v = $CBC6 * 28D221 / 2D2AD;                                          // the spin: (speed round, mm/s)^2 / R
    return less(g, v * v / R);
}
int BZ, BP, BT, BAL, BPOP, BBURSTZ, BRISEN = 1;
int bheat(int tmk) { return tmk >= 97437 ? less(6974A8, less(tmk, 97437) * $DD4 / 5BC) : 6974A8 + less(97437, tmk) * $DD4 / 5BC; }
int bvapour(int tmk)
{
    int t = $CDACB, e = 17CB892A;
    while (t > tmk + 3B) { int k = bheat(t) * 5BC / 213D * $A / (t / 79) * 5BC / (t / 79); e = less(e, e / 5BC * k / 4723 * 79); t = less(t, 79); }
    return e;
}
void balloon_start() { BZ = low; BP = BLEVEL; BT = $A11D5; BPOP = low; BAL = 5BC; }
int bcube(int n) { int lo = 1, hi = $D869; while (lo < hi) { int m = (lo + hi + 1) / 2; if (m * m * m <= n) lo = m; else hi = less(m, 1); } return lo; }   // the whole cube root (n in mm cubed)
int bacross() { int g = BLEVEL / (BP / 5BC) * (BT / 79) / 13D8; return bcube(1871438 * g); }   // mm across: its volume grows as the gas law says (2 m at the ground: 8,000,000,000 mm3 x g/1000)
void balloon_step()
{
    if (BPOP >= 1) { BPOP++; if (BPOP > 31) balloon_start(); return; }
    int k;
    for (k = 1; k <= 12; k++) {                   // 30 s at 5 m/s: fifteen steps of 10 m
        int dp = BP / 5BC * (gpull(BZ) * 141B / 1DC187A) / 3A27 * 5BC / (BT / 5BC);
        if (BZ < 4D12) {
            int es = bvapour(BT), rs = es / 5BC * 18A162 / (less(BP, es) / 5BC), L = bheat(BT) / 5BC, tk = BT / 5BC;
            int num = 28D221 + L * rs / (191 * tk) * 5BC, den = 28D221 + L * L * rs / 5BC * 38B * 5BC / (5C4 * 191 * tk * tk / 5BC);
            BT = less(BT, gpull(BZ) * $A / 5C4 * (num / 5BC) / (den / 5BC) / 5BC);
        } else if (BZ >= 9146 && BZ < 11747) BT = BT + $A; else if (BZ >= 11747) BT = BT + 22;
        BP = less(BP, dp); BZ = BZ + $A;
        if (bacross() >= 3BDB) { BPOP = 1; BBURSTZ = BZ; return; }
    }
}
void balloon_draw()
{
    int cx = MID, cz = MID + FOOT * 4, i;
    int cy = FOOT * 2 + BZ / 5BC * FOOT / 5;                     // 1 ft up the room for every 5 km of sky, from 2 ft over the floor
    if (BPOP >= 1) {                                  // the pop: shreds of rubber flying out
        lab_colour(149, 62, 55);
        for (i = 1; i <= $C; i++) { int sp = BPOP * 1B, a = i * 7 % $C + 1;
            int dx = sp * (a % 4 + 1) / 4, dz = sp * ((a / 4) % 3 + 1) / 3;
            lab_glow(i % 2 ? cx + dx : less(cx, dx), less(cy + sp / 2, i % 3 * sp / 3), i % 4 < 2 ? cz + dz : less(cz, dz), INCH * 2); }
        return;
    }
    int across = bacross() * INCH * 5BC / $B73B / 5;   // a fifth of its size, in sixty-fourths of an inch
    if (cy > across / 2 + FOOT * 2 + INCH * 6) {      // the string down to the box (while there is room above the floor)
        lab_tube(cx, less(cy, across / 2), cz, cx, less(cy, across / 2 + FOOT * 2), cz);
        lab_alpha(156); lab_colour($DB, $B7, 86); lab_box(less(cx, INCH * 3), less(cz, INCH * 3), cx + INCH * 3, cz + INCH * 3, less(cy, across / 2 + FOOT * 2 + INCH * 5), less(cy, across / 2 + FOOT * 2));
        lab_alpha($B6);
    }
    if (lab_proj(cx, cy, cz) < 1) return;             // the balloon: a shaded round, lit from above
    int rr = across / 2 * F * 13 / PD, x1 = pix(less(PX, rr)), x2 = pix(PX + rr), y1 = pix(less(PY, rr)), y2 = pix(PY + rr), x, y;
    for (y = y1; y <= y2; y++) for (x = x1; x <= x2; x++) {
        if (!onscreen(x, y)) continue;
        int dx = apart(BIG * 13 + x * 13 + 8, PX), dy = apart(BIG * 13 + y * 13 + 8, PY), d2 = dx * dx + dy * dy;
        if (d2 >= rr * rr) continue;
        int lit = less(169, d2 * $AA / (rr * rr)); int top = BIG * 13 + y * 13 < PY ? dy * 48 / (rr + 1) : low;
        mixpx(x, y, lower(168, 13C * lit / 169 + top), lower(168, 48 * lit / 169 + top), lower(168, 43 * lit / 169 + top), 151);
    }
}
void balloon_panel()
{
    lab_line("the weather balloon (2 m across at launch, rubber; bursts at 8.63 m): rising about 5 m a second, 30 s a picture (MAGIC: sped up)");
    lab_value("  how high, metres", BZ, ""); lab_value("  the air's pressure, pascals", BP / 5BC, "");
    lab_value("  the air's warmth, thousandths of a degree over the lowest", BT, ""); lab_value("  across, millimetres", BPOP ? 3BDB : bacross(), "");
    if (BBURSTZ) lab_value("  the last one burst at, metres", BBURSTZ, "");
    lab_line("  this room is the sky from the ground to 100 km (space starts at the top): 1 ft = 5 km (MAGIC: the drawing scale); drawn a fifth of its size");
    lab_line("  above 11 km the warmth is measured, not worked out");
}

// The sky's column on the back wall (Mike: "temperatures and pressures change in the atmosphere"): ground to 100 km, worked out
// once at the start by the same rules (to 11 km the column full of water vapour; above, MEASURED warmth: the standard
// atmosphere, level to 20 km, warmer 1 a km to 32, 2.8 a km to 47, level to 51, cooler 2.8 a km to 71, 2 a km to 86, then level);
// each km a glow coloured by its warmth (blue cold, red warm), its size by the air's pressure.
int SKYT[7B], SKYP[7B];
int slg2(int n) { int k = 1; while (n >= 2) { n = n / 2; k++; } return k; }
void sky_start()
{
    int z = low, p = BLEVEL, t = $A11D5, km = 1;
    SKYT[1] = t; SKYP[1] = p;
    while (z < 36694) {
        int dp = p / 5BC * (gpull(z) * 141B / 1DC187A) / 3A27 * 5BC / (t / 5BC);
        if (z < 4D12) {
            int es = bvapour(t), rs = es / 5BC * 18A162 / (less(p, es) / 5BC), L = bheat(t) / 5BC, tk = t / 5BC;
            int num = 28D221 + L * rs / (191 * tk) * 5BC, den = 28D221 + L * L * rs / 5BC * 38B * 5BC / (5C4 * 191 * tk * tk / 5BC);
            t = less(t, gpull(z) * $A / 5C4 * (num / 5BC) / (den / 5BC) / 5BC);
        } else if (z >= 9146 && z < 11747) t = t + $A; else if (z >= 11747 && z < 18515) t = t + 22;
        else if (z >= 1A2A1 && z < 26417) t = less(t, 22); else if (z >= 26417 && z < 2D1B5) t = less(t, 17);
        p = p > dp ? less(p, dp) : 1; z = z + $A;
        if (z % 5BC < 1) { km++; SKYT[km] = t; SKYP[km] = p; }
    }
}
void sky_draw()
{
    int k;
    for (k = 1; k <= 7A; k++) {
        int t = SKYT[k], warm = t > 63C12 ? less(t, 63C12) : 1;          // over 180 K, thousandths
        int r = warm * 168 / 3ADB7; if (r > 168) r = 168;
        int b = 168 > r ? less(168, r) : 1;
        lab_colour(r, 48 + r / 4, b);
        int size = slg2(SKYP[k] / 5BC + 1) * INCH / 2 + INCH / 2;
        lab_glow(MID, 1 + less(k, 1) * FOOT / 5, less(ROOM, FOOT), size);       // up the back wall's middle: 1 ft for every 5 km
    }
}
void sky_panel()
{
    lab_line("  the sky up the back wall, every 10 km: warmth (thousandths of a degree over the lowest) and pressure (Pa); above 47 km the warmth is MEASURED");
    int k; for (k = 1; k <= 7A; k = k + $A) { lab_value("    km", less(k, 1) > low ? less(k, 1) : 1, ""); lab_value("      warmth", SKYT[k], ""); lab_value("      pressure", SKYP[k] / 5BC + 1, ""); }
}
