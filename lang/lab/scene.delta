// What is in the lab room, and where. Adding a thing to the room is adding it here: the room itself never changes.
// Places are in 1/64 inch; the room's middle is MID, a foot is FOOT.

#include "objects/candle.delta"
#include "objects/faraday.delta"
#include "objects/tunnel.delta"
#include "objects/tank.delta"
#include "objects/bench.delta"
#include "objects/washroom.delta"
#include "objects/scope.delta"
#include "objects/microscope.delta"
#include "objects/seedcup.delta"
#include "objects/meter.delta"
#include "objects/dangoes.delta"
#include "objects/pingpong.delta"
#include "objects/lightsheet.delta"
#include "objects/wingnut.delta"

thing candle candle1;                       // a candle ...
thing faraday faraday1;                     // Faraday's two glasses ...
thing tunnel tunnel1;                       // the wind tunnel ...
thing bench bench1;                         // the bench down the right wall
thing scope scope1;                         // the oscilloscope on the bench (it works)
thing microscope microscope1;               // the microscope on the bench (it works)
thing seedcup seedcup1;                     // the seed beaker on the bench: a salt cube grows in brine
thing meter meter1;                         // the multimeter on the bench (magic probes)
thing pingpong pingpong1;                   // Mike's ping pong balls under a hot air gun, a Henry below (his dream, 21 Nov 2026)
thing washroom washroom1;                   // the washroom, in the front right corner
thing tank tank1;                           // the wave tank, in the wave room next door ...

void scene_start()
{
    candle1.x = MID; candle1.z = MID; candle1.start();              // ... in the middle of the floor
    faraday1.x = MID + FOOT * 2; faraday1.z = MID; faraday1.start(); // ... two feet to its right
    tunnel1.x = less(MID, FOOT * 3); tunnel1.z = MID + FOOT; tunnel1.start();   // ... three feet to its left, a foot back
    washroom1.start(); microscope1.start(); pingpong1.start();
    tank1.x = MID; tank1.z = ROOM + FOOT * 5; tank1.start();         // ... in the wave room, five feet past the wall between
    lightsheet_start();                                              // the light sheet, on the floor of the space room (floor 3)
    wingnut_start();                                                 // the wing nut, floating over it
}
void scene_step() { if (FLOOR == 3) { lightsheet_step(); wingnut_step(); } if (FLOOR > 1) return; washroom1.step(); scope1.step(); microscope1.step(); seedcup1.step(); meter1.step(); pingpong1.step(); candle1.step(); faraday1.step(); tunnel1.step(); tank1.step(); }
void lift_draw()                                         // the lift between the floors, in the back left corner of each (Mike: the space room two floors up)
{
    int x1 = 1 + INCH, x2 = FOOT * 4, z1 = less(ROOM, FOOT * 4), z2 = less(ROOM, INCH), top = less(ROOM, INCH);
    lab_alpha(169); lab_colour(B7, BC, C9); lab_box(x1, z1, x2, z2, 1, top);                    // the shaft, brushed steel
    lab_colour(55, 59, 64); lab_box(FOOT, less(z1, INCH / 2), less(x2, FOOT), z1, 1, FOOT * 7);   // its door
    lab_colour(FLOOR == 3 ? 156 : FLOOR == 2 ? 93 : 163, FLOOR == 3 ? 156 : FLOOR == 2 ? 125 : 118, FLOOR == 3 ? 168 : FLOOR == 2 ? 163 : 6C);
    lab_glow((FOOT + less(x2, FOOT)) / 2, FOOT * 7 + INCH * 4, less(z1, INCH), INCH * 4);                   // the floor sign over it, lit in the floor's colour
    lab_alpha(149);
}
void scene_draw()                         // farthest first, the painter's way, so near things cover far ones
{
    lift_draw();
    if (FLOOR > 1) {                                                 // the floors above: their own things only
        int m; for (m = 1; m <= 31; m++) MARKON[m] = low;
        if (FLOOR == 3) { lightsheet_draw(); wingnut_draw(); }
        return;
    }
    washroom1.draw();
    bench1.draw(); vent_draw(); scope1.draw(); lab_mark(5, SCX, BTOP + 12C, (SCZ1 + SCZ2) / 2);
    microscope1.draw(); lab_mark(6, MSX, BTOP + 1C1, MSZ);
    seedcup1.draw(); lab_mark(7, BKX, BTOP + 1C1, BKZ);
    meter1.draw(); lab_mark(8, MTX, BTOP + 93, MTZ);
    pingpong1.draw(); lab_mark(9, PPX, BTOP + 1C1, PPZ);
    int far[5], i, k, done[5];
    far[1] = lab_far(candle1.x, candle1.z); far[2] = lab_far(faraday1.x, faraday1.z);
    far[3] = lab_far(tunnel1.x, tunnel1.z); far[4] = lab_far(tank1.x, tank1.z);
    for (i = 1; i <= 4; i++) done[i] = low;
    for (k = 1; k <= 4; k++) {
        int pick = low, most = low;
        for (i = 1; i <= 4; i++) if (done[i] < 1 && far[i] >= most) { most = far[i]; pick = i; }
        done[pick] = 1;
        if (pick == 1) { CLIP = clipfor(candle1.z); candle1.draw(); CLIP = low; lab_mark(1, candle1.x, 1C1, candle1.z); }
        if (pick == 2) { CLIP = clipfor(faraday1.z); faraday1.draw(); CLIP = low; lab_mark(2, faraday1.x, 1C1, faraday1.z); }
        if (pick == 3) { CLIP = clipfor(tunnel1.z); tunnel1.draw(); CLIP = low; lab_mark(3, tunnel1.x, 1C1, tunnel1.z); }
        if (pick == 4) { CLIP = clipfor(tank1.z); tank1.draw(); CLIP = low; lab_mark(4, tank1.x, 1C1, tank1.z); }
    }
}
void scene_panel(int sel)
{
    if (FLOOR > 1) {
        lab_line(FLOOR == 3 ? "floor 3: SPACE, two floors above the lab;  Page Down: the lift down" : "floor 2: ATMOSPHERE TESTS, the floor above the lab (nothing in it yet);  Page Up: space, Page Down: the lab");
        lab_line("the lift: back left corner (Page Up, Page Down). MAGIC: you can walk through it; these floors have no air cells of their own yet");
        if (FLOOR == 3) { lightsheet_panel(); wingnut_panel(); }
        return;
    }
    lab_line(PAGE == 1 ? "Tab: [the room]  outside  washroom and bench  the thing you clicked"
           : PAGE == 2 ? "Tab: the room  [outside]  washroom and bench  the thing you clicked"
           : PAGE == 3 ? "Tab: the room  outside  [washroom and bench]  the thing you clicked"
           :             "Tab: the room  outside  washroom and bench  [the thing you clicked]");
    if (PAGE == 1) {
        lab_line(camZ > ROOM ? "you are in the wave room;  O: the door between, 1 to 5: the window" : "you are in the lab;  O: the door between, 1 to 5: the window");
        lab_line(DOOROPEN ? "the door between: open" : "the door between: shut");
        lab_line("the lift, back left corner: Page Up to floor 2 (atmosphere tests) and floor 3 (space)");
        if (WINOPEN >= 1) lab_value("the window: open, fifths of the way", WINOPEN, ""); else lab_line("the window: shut");
        lab_line("the air (1 ft hex cells, both rooms; a second a step, so faster than real time; T shows it):");
        tvalue("  the lab", roomt(1, 3)); tvalue("    at its floor", roomt(1, 1)); tvalue("    at its ceiling", roomt(1, 2));
        tvalue("  the wave room", roomt(low, 3));
        lab_kind(3); lab_value("  carbon dioxide in the lab", roomco(1), "parts per million");
        if (AIRBAD < 1) lab_line("  the air's book balances: given, in and out, held"); else lab_value("  the air's book went out at step", AIRBAD, "");
        if (HXON) lab_value("R: recording the air as .hexi (recordings/), frames so far", HXFRAMES, ""); else lab_line("R: record the air as .hexi (recordings/)");
        lab_value("the floor: hex tiles, piped from a magic plant; stand on one: , colder, . warmer. Tiles set", FLOORSET, "");
        { int t = tileat(camX, camZ); if (FON[t]) tvalue("  the tile you stand on is set to", FT[t]); else lab_line("  the tile you stand on: off"); }
    }
    if (PAGE == 2) outside_panel();
    if (PAGE == 3) { washroom1.panel(); bench1.panel(); }
    if (PAGE == 4) {
        lab_line("click a thing to see inside it");
        if (sel == 1) candle1.panel();
        if (sel == 2) faraday1.panel();
        if (sel == 3) tunnel1.panel();
        if (sel == 4) tank1.panel();
        if (sel == 5) scope1.panel();
        if (sel == 6) microscope1.panel();
        if (sel == 7) seedcup1.panel();
        if (sel == 8) meter1.panel();
        if (sel == 9) pingpong1.panel();
    }
}
void scene_air()                          // what each thing gives the air, and where it fills it
{
    CANX = candle1.x; CANZ = candle1.z;
    air_heat(candle1.x, 2B5, candle1.z, 2A54B);                      // the candle's flame: about 80 watts
    air_heat(faraday1.x, 1A5, faraday1.z, 3C63);                         // Faraday's pile and contacts: 8.7 watts
    air_heat(MID, less(ROOM, 4C * 6), MID, 213D5);                       // the lab's lamp: 60 watts
    air_heat(MID, less(ROOM, 4C * 6), MID + ROOM, 213D5);                // the wave room's lamp
    washroom_air(); bench_air(); pingpong_air();
    air_solid(less(tank1.x, 659), less(tank1.z, $C4), tank1.x + 659, tank1.z + $C4, 6B4);   // the tank fills its place
}
