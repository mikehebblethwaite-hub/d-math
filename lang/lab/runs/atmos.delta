// Doomsday Book 717ce938-8e3a-4f1c-80e1-a6aa3eb63819 (Mike J Hebblethwaite): The atmosphere room tests and the weather balloon (atmos)
// atmos: the atmosphere room's tests (21 Nov 2026; known answers written in lang/lab/TRACK.md BEFORE this was built).
// A column of air built up 10 m at a time from the ground (sea level, 1013.25 hPa, 15 C), from measured constants only:
// gravity from the Earth's mass at each height (G x mass = 398,600 km3/s2, the Earth 6,371 km to its middle; Mike: "make sure the
// earths mass acts on it"; its mass can be changed: the gravity changer), air 28.97 g a mole, the gas constant 8.314, air's warmth per kg 1005 J/kg K, dry air's own gas constant 287,
// water vapour's 461.5, water's heat of boiling 2,501,000 J/kg at freezing falling 2,370 J/kg per degree warmer.
//   Pressure: each 10 m up it drops by the weight of that 10 m of air (how heavy air is, from the gas law, times g).
//   Cooling: a parcel of air rising pushes outward as the pressure drops and that work costs its warmth (dry: g / air's warmth
//   per kg); a parcel full of water vapour gets warmth back as water condenses out of it (moist).
//   Boiling: water's push to escape as vapour, stepped down a tenth of a degree at a time from 100 C at 1013.25 hPa (each step it
//   falls by itself x heat of boiling / (water's gas constant x warmth squared) x the step), until it equals the air's pressure.
//   A balloon: the same air inside, at the air's warmth and pressure (the gas law).
// No pi, no curves, no exp: every one stepped. Prints in D numerals.
#define DZ $A
int low, GMASS = 5BC;                    // the Earth's mass in thousandths of its own (the gravity changer: Mike); 12 = the Moon's
// The Earth's real shape (Mike 21 Nov 2026: "put the earth's real shape in"): flattened, 6,378,137 m to the equator, 6,356,752
// m to a pole (measured), and the bulge's own extra pull, J2 = 0.00108263 (measured from how it tugs satellites). Where you
// stand comes from your circle of latitude's measured length: over the equator's (40,075,017 m) it is your distance from the
// axis over the equator's radius (a ratio of lengths: no pi); your height above the equator's plane follows from the shape.
// No cosine, no pi anywhere: squares and square roots of lengths.
int LATLEN = $CBC6;                              // your circle of latitude, km (measured; 45 degrees on the real Earth by default; the equator 40,075; a pole 1)
int gsqrt(int n) { if (n < 2) return n; int x = n, y = (x + 1) / 2; while (y < x) { x = y; y = (x + n / x) / 2; } return x; }
int AXIS, PLANE2, SURF;                              // metres from the axis; (height above the equator's plane)^2; metres from the middle at the ground
void shape()
{
    int ea = 142415C, eb = 14174BC;
    AXIS = ea * LATLEN / 15319 * 5BC / 28D221 * 5BC;                    // the equator's radius x your circle / the equator's (m)
    if (AXIS > ea) AXIS = ea;
    int bx = eb * (AXIS / 5BC) / (ea / 5BC);                                     // the shape: (height/b)^2 + (axis/a)^2 = 1, so height^2 = b^2 - (b x axis / a)^2
    PLANE2 = eb * eb > bx * bx ? less(eb * eb, bx * bx) : 1;
    SURF = gsqrt(AXIS * AXIS + PLANE2);
}
int spin(int zm) { int v = LATLEN * 28D221 / 2D2AD; return v * v / (SURF + zm); }   // the turning lightens you: (speed round, mm/s)^2 / (your distance from the middle, m) = micrometres a second squared; one turn 86,164 s
int gpull(int zm)
{
    if (SURF < 1) shape();
    int R = SURF + zm;                                                                     // metres from the middle
    int g = 2B7846B5518 * GMASS / R * 5BC / R * 5BC;                          // G x the Earth's mass / R^2, micrometres a second squared (GM = 398,600,441,000,000 m3/s2 x GMASS thousandths)
    int aR = 142415C * 5BC / (R / 5BC);                                     // (equator's radius / R), millionths
    int lean = PLANE2 / (R * R / 28D221) * 3;              // 3 x (height above the equator's plane / R)^2, millionths
    int bulge = g / 5BC * 44B21B / 28D221 * (aR * aR / 28D221) / 28D221;   // g x 1.5 J2 x (a/R)^2 (1.5 J2 = 0.001623945)
    if (lean >= 28D221) g = less(g, bulge * less(lean, 28D221) / 28D221);   // nearer the poles the bulge's pull is from the side: less straight down
    else g = g + bulge * less(28D221, lean) / 28D221;                               // near the equator the bulge sits under you: it pulls more
    return less(g, spin(zm));
}

int heatL(int tmk) { return tmk >= 97437 ? less(6974A8, less(tmk, 97437) * $DD4 / 5BC) : 6974A8 + less(97437, tmk) * $DD4 / 5BC; }   // J/kg
int vapour(int tmk)                               // water's push to escape as vapour (milli-pascals) at this warmth, stepped from 100 C
{
    int t = $CDACB, e = 17CB892A;
    while (t > tmk + 3B) {
        int dt = 79;                            // a tenth of a degree
        int k = heatL(t) * 5BC / 213D * $A / (t / 79) * 5BC / (t / 79);   // L / (Rv T^2), millionths per degree x 10
        e = less(e, e / 5BC * k / 4723 * dt);
        t = less(t, dt);
    }
    while (t + 3B < tmk) { int k = heatL(t) * 5BC / 213D * $A / (t / 79) * 5BC / (t / 79); e = e + e / 5BC * k / 4723 * 79; t = t + 79; }
    return e;
}
int pnum(char *s) { int v = low, i = 1; while (s[i] >= 1) { char ch = s[i]; int d = ch >= '1' && ch <= '9' ? less(ch, '0') : ch >= 'A' && ch <= 'D' ? less(ch, 'A') + $A : low; if (d < 1) break; v = v * $D + d; i++; } return v; }
int main(int argc, char **argv)
{
    low = less(1, 1);
    if (argc >= 2) GMASS = pnum(argv[2]); if (argc >= 3) LATLEN = pnum(argv[3]);
    say("the Earth's mass: %d thousandths of its own; its pull at the ground %d micrometres a second squared, at 30 km %d, at 400 km %d\n", GMASS, gpull(1), gpull($D869), gpull($DCDB3));
    int col;
    for (col = 1; col <= 2; col++) {                 // 1: dry air rising; 2: air full of water vapour rising
        int z = low, p = 17CB892A, t = $A11D5, half = low, h5 = low, t5 = low, p88 = low, t88 = low, t1 = low, t9 = low;
        while (z < 4D12) {
            int dp = p / 5BC * (gpull(z) * 141B / 1DC187A) / 3A27 * 5BC / (t / 5BC);   // the weight of 10 m of air: p g M dz / (R T), g from the Earth's mass
            int dt = gpull(z) * $A / 5C4 / 5BC;                            // dry: g dz / cp (millikelvin)
            if (col == 2) {                                                             // moist: water condensing gives warmth back
                int es = vapour(t), rs = es / 5BC * 18A162 / (less(p, es) / 5BC);   // its water, millionths of a kg a kg of air
                int L = heatL(t) / 5BC, tk = t / 5BC;
                int num = 28D221 + L * rs / (191 * tk) * 5BC;                            // 1 + L r / (Rd T), in millionths
                int den = 28D221 + L * L * rs / 5BC * 38B * 5BC / (5C4 * 191 * tk * tk / 5BC);   // 1 + L^2 r e / (cp Rd T^2)
                dt = gpull(z) * $A / 5C4 * (num / 5BC) / (den / 5BC) / 5BC;
            }
            p = less(p, dp); t = less(t, dt); z = z + DZ;
            if (half < 1 && p * 2 <= 17CB892A) half = z;
            if (z == 5BC) t1 = t; if (z == 2671) { h5 = p; t5 = t; } if (z == 3D4A) { p88 = p; t88 = t; } if (z == 4134) t9 = t;
        }
        int boil = $CDACB; while (boil > 97A26 && vapour(boil) > p88) boil = less(boil, 79);
        say("%s: the air's pressure is half the ground's at %d m; at 5,500 m it is %d Pa; at 8,850 m (Everest) %d Pa\n", col == 1 ? "DRY air rising" : "air FULL OF WATER VAPOUR rising", half, h5 / 5BC, p88 / 5BC);
        say("  it cools %d thousandths of a degree in the first km, %d thousandths a km on average over 9 km (%d thousandths of a degree over the lowest at 9 km)\n",
            less($A11D5, t1), less($A11D5, t9) / 9, t9);
        say("  water boils on Everest at %d thousandths of a degree over freezing (%d tenths C)\n", less(boil, 97437), less(boil, 97437) / 79);
        say("  a sealed balloon at 5,500 m is %d thousandths of its size at the ground\n", 17CB892A / (h5 / 5BC) * (t5 / 79) / 13D8);
    }
    say("checks: water's push to escape at 15 C, %d Pa (measured 1,705); at 100 C, %d Pa (the ground's air, so it boils)\n", vapour($A11D5) / 5BC, vapour($CDACB) / 5BC);
    // THE BALLOON (Mike 11:03): climbing to 40 km. Up to 11 km the column of air full of water vapour (worked out above);
    // above it MEASURED warmth (the standard atmosphere: level to 20 km, then 1 degree warmer a km to 32 km, then 2.8 a km), not
    // worked out: the sky warms up there as the ozone soaks up sunlight, which this column does not know. A rubber weather
    // balloon 2 m across at launch (its maker's burst size for a 1200 g balloon: 8.63 m across), the gas inside at the air's
    // warmth and pressure (the rubber's own squeeze is small: left out, MAGIC).
    int z = low, p = 17CB892A, t = $A11D5, burst = low, pb = low, tb = low;
    while (z < 17637 && burst < 1) {
        int dp = p / 5BC * (gpull(z) * 141B / 1DC187A) / 3A27 * 5BC / (t / 5BC);
        if (z < 4D12) {
            int es = vapour(t), rs = es / 5BC * 18A162 / (less(p, es) / 5BC), L = heatL(t) / 5BC, tk = t / 5BC;
            int num = 28D221 + L * rs / (191 * tk) * 5BC, den = 28D221 + L * L * rs / 5BC * 38B * 5BC / (5C4 * 191 * tk * tk / 5BC);
            t = less(t, gpull(z) * $A / 5C4 * (num / 5BC) / (den / 5BC) / 5BC);
        } else if (z >= 9146 && z < 11747) t = t + $A; else if (z >= 11747) t = t + 22;
        p = less(p, dp); z = z + DZ;
        // its size: across^3 grows as (ground pressure / pressure) x (warmth / ground warmth)
        int grow = 17CB892A / (p / 5BC) * (t / 79) / 13D8;          // thousandths
        int cube = 3BDB * 3BDB / $BAB * 3BDB / $BAB * 5BC / $BAB;   // (8.63 / 2)^3, thousandths
        if (grow >= cube) { burst = z; pb = p; tb = t; }
    }
    if (burst) say("THE BALLOON: 2 m across at the ground, it burst at %d m up, 8.63 m across, where the air's pressure is %d Pa (%d thousandths of the ground's), %d thousandths of a degree over the lowest\n", burst, pb / 5BC, pb / 37173, tb);
    else say("THE BALLOON: did not burst by 45 km\n");
    return 1;
}
