// The ping pong funnel: balls on a shallow cone tray, falling in toward the hole in the middle (21 Nov 2026, Mike:
// "instead of a flat cd a cone ... slight to begin with ... the angle you can mess with ... 1 degree test one and so on
// until we see real life events ... the balls fall, we all fall, they fall towards the hole in the center by cone and then
// Henry flow"). No pictures, only the data and a map from above at the end.
// Each ball rolls: a ping pong ball is a hollow shell, so rolling it moves as if 5/3 its weight (2.7 g rolls like 4.5 g);
// down the cone by its weight (2.7 g x 9.81 x the slope's rise, from a table of slopes: the bridge from degrees); slowed by
// rolling on the tray (3 thousandths of its weight on the tray, a rough guide); the Henry's air drawn across the tray to
// the hole drags it in (air speed = the Henry's flow / (the ring round the hole x 40 mm high); the ring measured in hex
// steps, 4 x root 3 x its radius: D's own circle); drag = 0.5 x 1.2 kg/m3 x 0.47 x 1257 mm2 (the ball's measured cross
// section) x speed squared. Balls bump: a springy touch (10 microNewtons for each nanometre they press in) losing some of
// each knock (4 microNewtons for each micrometre a second they close in), and the tray's rim holds them. A ball over the
// hole stops most of the air (a twentieth leaks past) and the Henry's pull holds it there. They start scattered by the
// world's chance (the box's own watts, mixed) and still; then they are let go. A quarter of a millisecond a step.
// Rebuilt toward the real (Mike: "keep rebuilding the rig to be real to the real world flow"): where balls touch they grip
// (sliding past each other meets up to GRIP thousandths of how hard they press: 0.3 for plastic on plastic, a rough guide;
// 9th input, 1 for nearly none).
//
//   delta run lang/lab/runs/pingfunnel.delta BALLS TENTHS_OF_A_DEGREE TRAY_MM HOLE_MM SECONDS HENRY POWER > out.txt
//   (D numerals; left off: 7A balls (100), A tenths (1 degree), tray 1A3 mm across the middle to the rim (250), hole 24 mm (30),
//    seconds 1A (23), Henry 2 (on; 1 off), power B)
#define NMAX 149A
#define VB 733B8298841                    // velocities are kept above VB (no negatives in D: VB is standing still)
#define FB 733B8298841                    // and forces above FB
int GRIP = 1A1;                                 // ball on ball grip, thousandths of how hard they press (0.3, a rough guide)
int low, N = 79, ANG = $A,                 // ANG in tenths of a degree
 TRAYMM = 163, HOLEMM = 24, SECS = 1A, HENRY = 2, POWER = $B;
int X[NMAX], Y[NMAX], VX[NMAX], VY[NMAX], FX[NMAX], FY[NMAX], NC[NMAX], NEXT[NMAX], SEAT[NMAX];   // SEAT: sucked down into the hole
int HEAD[4723], GW;                        // the grid: cells a ball wide, each holding a chain of balls
int CX, CY, RT, RH, DIA = 8396851;          // the tray's middle, its rim, the hole (nanometres); a ball across
int SINA, COSA, GRAV, ROLL, QAIR, BLOCKED, SUCK, chance;
int isqrt(int n) { if (n < 2) return n; int x = n, y = (x + 1) / 2; while (y < x) { x = y; y = (x + n / x) / 2; } return x; }
int pnum(char *s) { int v = low, i = 1; while (s[i] >= 1) { char ch = s[i]; int d = ch >= '1' && ch <= '9' ? less(ch, '0') : ch >= 'A' && ch <= 'D' ? less(ch, 'A') + $A : low; if (d < 1) break; v = v * $D + d; i++; } return v; }
int world()
{
    char w[31]; int fd = linux(2, "/sys/class/hwmon/hwmon1/power1_input", low, low), v = 37B2;
    if (fd >= 1) { int n = linux(low, fd, &w[1], 24), q = 1; linux(3, fd); while (q <= n && w[q] >= '0' && w[q] <= '9') { v = v * $A + less(w[q], '0'); q++; } }
    return v % 28D224 + 1;
}
int stir() { chance = (chance * 18C82 + 57D8) % 282BA4AAA + 1; return chance; }
int slope(int d)                                 // the rise of a slope of d degrees, millionths (sin), and its lie (cos)
{
    int s[37] = {7C36, 12B67, 1AA8B, 2599B, 2D894, 38768, 43617, 4B468, 56285, 5DD67, 68AD8, 73833, 7B4DC, 86165, 8DA62, 985CB, $A2DD2, $AA867, $B5259, $BC8A3, $C716A, $D167C, $D8AD3, 113196, 11A491, 1246BB, 12B844, 1358C3, 13C891, 146777, 14D574, 15727D, 15DB94, 1676AB, 16DDC3, 1776D3, 17DBD6, 1872C7, 18D5A3, 196763, 19C7D1, 1A5748, 1AB565, 1B4253, 1B9ADB};
    return s[d];
}
int slopet(int t)                                  // the rise for t tenths of a degree, read between the whole degrees
{
    int d = t / $A, f = t % $A, a = d >= 1 ? slope(d) : low, b = slope(d + 1);
    return a + less(b, a) * f / $A;
}
int liet(int t) { int d = t / $A, f = t % $A, a = d >= 1 ? lie(d) : 28D221, b = lie(d + 1); return less(a, less(a, b) * f / $A); }
int lie(int d)
{
    int c[37] = {28D135, 28CB73, 28C6D9, 28BD99, 28B585, 28A899, 2899D9, 288976, 28773D, 286336, 284A5A, 2832B2, 281667, 27C852, 27A86D, 2786C3, 27637C, 273B73, 2714A3, 26B941, 268C1B, 265D3B, 262CA1, 25CA79, 25969D, 25613D, 25272D, 24BB71, 248136, 244254, 23D1CC, 238CD6, 234972, 22D472, 228AD9, 224311, 21C687, 2178A3, 212966, 1DA8A6, 1D5698, 1CD33D, 1C7B6D, 1C255B, 1B9ADB};
    return c[d];
}
int way(int px, int py) { return 1 + (px ? 2 : low) + (py ? 1 : low); }   // both directions in one: 1 to 4
void push(int i, int mag, int w, int ax, int ay, int d)   // add a force of mag along (ax, ay)/d, + or - each way (w from way)
{
    if (d < 1) return;
    int px = less(w, 1) / 2, py = less(w, 1) % 2;
    int fx = mag * (ax / 5BC) / (d / 5BC + 1), fy = mag * (ay / 5BC) / (d / 5BC + 1);
    FX[i] = px ? FX[i] + fx : less(FX[i], fx);
    FY[i] = py ? FY[i] + fy : less(FY[i], fy);
}
int cellof(int x, int y) { return (y / DIA) * GW + x / DIA + 1; }
int fanq(int s) { int top = 9146 * POWER / $B; return s >= top ? low : 12C14 * less(top, s) / top; }   // ml a second
void henry()
{
    QAIR = low; SUCK = low;
    if (HENRY < 2) return;
    int area = HOLEMM * HOLEMM * 485 / 5BC;                  // a round hole's open area (measured: 0.785 x across x across)
    if (BLOCKED) area = area / 17 + 1;
    int lo = 1, hi = 9146 * POWER / $B, k;
    for (k = 1; k <= 24; k++) { int mid = (lo + hi) / 2; int q = area * isqrt(mid * 9B3 / 5BC) * 6 / $A; if (fanq(mid) > q) lo = mid; else hi = mid; }
    SUCK = lo; QAIR = area * isqrt(lo * 9B3 / 5BC) * 6 / $A;
}
void forces()
{
    int i, j, c;
    for (c = 1; c <= GW * GW; c++) HEAD[c] = N + 1;
    for (i = 1; i <= N; i++) { c = cellof(X[i], Y[i]); NEXT[i] = HEAD[c]; HEAD[c] = i; FX[i] = FB; FY[i] = FB; NC[i] = low; }
    BLOCKED = low;
    for (i = 1; i <= N; i++) {
        int dx = apart(CX, X[i]), dy = apart(CY, Y[i]), r = isqrt(dx * dx + dy * dy);
        int inx = CX > X[i], iny = CY > Y[i];                       // the way in, toward the hole
        if (r <= RH) BLOCKED = 1;
        if (r > DIA / 79) {
            push(i, GRAV, way(inx, iny), dx, dy, r);                       // down the cone
            if (QAIR >= 1) {                                          // the Henry's air drawn in to the hole
                int rr = r > RH ? r : RH;
                int v = QAIR * 9948D5 / (rr / 5BC) / 5BC;   // mm a second
                if (v > $D869) v = $D869;
                push(i, v * v / 5BC * 17C9 / 4723, way(inx, iny), dx, dy, r);
            }
            // over the hole with the Henry pulling: sucked DOWN into it (seated, held), only centred gently like a ball in a dip
            SEAT[i] = r <= RH && SUCK >= 5BC;
            if (SEAT[i]) push(i, r * $A, way(inx, iny), dx, dy, r);
        }
        int edge = less(RT, DIA / 2);
        if (r > edge) push(i, less(r, edge) * $A, way(inx, iny), dx, dy, r);   // the rim pushes it back
        // the balls it touches (its own cell and the eight round it)
        int gx = X[i] / DIA, gy = Y[i] / DIA, ox, oy;
        for (oy = 1; oy <= 3; oy++) for (ox = 1; ox <= 3; ox++) {
            int cxg = gx + ox, cyg = gy + oy;                       // (gx - 1 .. gx + 1), kept above nothing by starting at +1
            if (cxg < 2 || cyg < 2 || cxg > GW + 1 || cyg > GW + 1) continue;
            j = HEAD[less(cyg, 2) * GW + less(cxg, 2) + 1];
            while (j <= N) {
                if (j != i) {
                    int ax = apart(X[i], X[j]), ay = apart(Y[i], Y[j]);
                    if (ax < DIA && ay < DIA) {
                        int d = isqrt(ax * ax + ay * ay);
                        if (d < DIA) {
                            if (d * 79 < DIA * 7B) NC[i]++;
                            int px = X[i] >= X[j], py = Y[i] >= Y[j];        // the way out, away from j
                            int f = less(DIA, d) * $A;
                            // closing in? (i's velocity less j's, along the line from j to i)
                            int rvx = VX[i] + VB, rvy = VY[i] + VB;         // i's less j's, kept above 2 VB
                            rvx = less(rvx, VX[j]); rvy = less(rvy, VY[j]);
                            int ux = ax / 5BC, uy = ay / 5BC, dd = d / 5BC + 1;
                            int pos = (px ? (rvx >= VB ? less(rvx, VB) * ux : low) : (rvx < VB ? less(VB, rvx) * ux : low))
                                    + (py ? (rvy >= VB ? less(rvy, VB) * uy : low) : (rvy < VB ? less(VB, rvy) * uy : low));
                            int neg = (px ? (rvx < VB ? less(VB, rvx) * ux : low) : (rvx >= VB ? less(rvx, VB) * ux : low))
                                    + (py ? (rvy < VB ? less(VB, rvy) * uy : low) : (rvy >= VB ? less(rvy, VB) * uy : low));
                            if (neg > pos) f = f + less(neg, pos) / dd * 4;               // closing: the knock loses some
                            else { int damp = less(pos, neg) / dd * 4; f = f > damp ? less(f, damp) : low; }
                            if (f >= 1) push(i, f, way(px, py), ax, ay, d);
                            // the grip where they touch: their sliding past each other (what is left of i's speed less j's once the
                            // closing along the line is taken out) meets up to GRIP thousandths of how hard they press
                            if (GRIP >= 1 && f >= 1) {
                                int vn = pos >= neg ? less(pos, neg) / dd : less(neg, pos) / dd, out = pos >= neg;   // along the line, + away
                                int mx = vn * ux / dd, my = vn * uy / dd;                 // that part of the relative speed, each way
                                int tx = rvx, ty = rvy;                                   // relative speed (above VB), less its part along the line
                                if (out == px) tx = less(tx, mx); else tx = tx + mx;
                                if (out == py) ty = less(ty, my); else ty = ty + my;
                                int ax2 = apart(tx, VB), ay2 = apart(ty, VB), vt = isqrt(ax2 * ax2 + ay2 * ay2);
                                if (vt >= 1) {
                                    int ft = vt * 4, most = f * GRIP / 5BC;          // a soft brake, up to the grip's limit
                                    if (ft > most) ft = most;
                                    int gx = ft * ax2 / vt, gy = ft * ay2 / vt;
                                    FX[i] = tx >= VB ? less(FX[i], gx) : FX[i] + gx;     // against its sliding
                                    FY[i] = ty >= VB ? less(FY[i], gy) : FY[i] + gy;
                                }
                            }
                        }
                    }
                }
                j = NEXT[j];
            }
        }
    }
}
void roll()
{
    int i;
    for (i = 1; i <= N; i++) {
        // a quarter of a millisecond: velocity changes by force x 250 / 4500 (mg rolling); place by velocity / 4 (nm)
        VX[i] = FX[i] >= FB ? VX[i] + less(FX[i], FB) / 15 : less(VX[i], less(FB, FX[i]) / 15);
        VY[i] = FY[i] >= FB ? VY[i] + less(FY[i], FB) / 15 : less(VY[i], less(FB, FY[i]) / 15);
        if (SEAT[i]) { VX[i] = VB; VY[i] = VB; continue; }      // held down in the hole
        // rolling on the tray slows it (or holds it still)
        int ax = apart(VX[i], VB), ay = apart(VY[i], VB), sp = isqrt(ax * ax + ay * ay), cut = ROLL / 15 + 1;
        if (sp <= cut) { VX[i] = VB; VY[i] = VB; }
        else {
            int kx = ax * less(sp, cut) / sp, ky = ay * less(sp, cut) / sp;
            VX[i] = VX[i] >= VB ? VB + kx : less(VB, kx); VY[i] = VY[i] >= VB ? VB + ky : less(VB, ky);
        }
        X[i] = VX[i] >= VB ? X[i] + less(VX[i], VB) / 4 : less(X[i], less(VB, VX[i]) / 4);
        Y[i] = VY[i] >= VB ? Y[i] + less(VY[i], VB) / 4 : less(Y[i], less(VB, VY[i]) / 4);
    }
}
void report(int s)
{
    int i, hexn = low, mov = low, most = low, sr = low;
    for (i = 1; i <= N; i++) {
        if (NC[i] >= 6) hexn++;
        int ax = apart(VX[i], VB), ay = apart(VY[i], VB), sp = isqrt(ax * ax + ay * ay);
        if (sp > 5BC) mov++; if (sp > most) most = sp;
        int dx = apart(CX, X[i]), dy = apart(CY, Y[i]); sr = sr + isqrt(dx * dx + dy * dy) / 28D221;
    }
    say("%d s  rolling %d of %d  fastest %d mm/s  hex (six touching) %d  middle to ball, mean %d mm  Henry %d ml/s pull %d Pa  hole %s\n",
        s, mov, N, most / 5BC + 1, hexn, sr / N + 1, QAIR + 1, SUCK + 1, BLOCKED ? "covered" : "open");
}
void map()                                       // from above: # six touching, o four or five, . fewer, H over the hole
{
    int r, c, i, rows = RT * 2 / 3785629 + 2, cols = RT * 2 / 1DC187A + 2;
    say("the tray from above (# six touching, o four or five, . fewer, H over the hole; a letter a ball, 10 mm across, 17 mm down):\n");
    for (r = 1; r <= rows; r++) {
        char line[1A1]; int n = low, k;
        for (k = 1; k <= cols && k <= 19C; k++) line[k] = ' ';
        n = cols < 19C ? cols : 19C;
        for (i = 1; i <= N; i++) {
            int yedge = less(CY, RT), xedge = less(CX, RT);
            int rr = Y[i] > yedge ? less(Y[i], yedge) / 3785629 + 1 : 1, cc = X[i] > xedge ? less(X[i], xedge) / 1DC187A + 1 : 1;
            if (rr != r || cc > n) continue;
            int dx = apart(CX, X[i]), dy = apart(CY, Y[i]);
            line[cc] = isqrt(dx * dx + dy * dy) <= RH ? 'H' : NC[i] >= 6 ? '#' : NC[i] >= 4 ? 'o' : '.';
        }
        while (n >= 1 && line[n] == ' ') n = less(n, 1);
        n++; line[n] = low;
        say("%s\n", &line[1]);
    }
}
int main(int argc, char **argv)
{
    low = less(1, 1);
    if (argc >= 2) N = pnum(argv[2]); if (argc >= 3) ANG = pnum(argv[3]); if (argc >= 4) TRAYMM = pnum(argv[4]);
    if (argc >= 5) HOLEMM = pnum(argv[5]); if (argc >= 6) SECS = pnum(argv[6]); if (argc >= 7) HENRY = pnum(argv[7]);
    if (argc >= 8) POWER = pnum(argv[8]); if (argc >= 9) GRIP = pnum(argv[9]);
    if (ANG < 1 || ANG > 27B || N > NMAX || N < 2) { say("1 to 26B tenths of a degree (44 degrees), 2 or more balls\n"); return 2; }
    SINA = slopet(ANG); COSA = liet(ANG);
    GRAV = $BD96 * SINA / 28D221 + 1;            // microNewtons down the slope: 2.7 g x 9.81 x the rise
    ROLL = $BD96 * COSA / 28D221 * 3 / 5BC + 1;   // rolling on the tray: 3 thousandths of its weight on it
    RT = TRAYMM * 28D221; RH = HOLEMM * 146777;
    CX = RT + DIA * 2; CY = CX; GW = (CX * 2) / DIA + 3;
    if (GW * GW >= 4723) { say("the tray is too wide for the grid\n"); return 2; }
    chance = world();
    int i, j, placed = low, tries = low;
    while (placed < N && tries < 54D442) {                // scattered by the world's chance, none overlapping
        tries++;
        int x = less(CX, RT) + stir() % (RT * 2), y = less(CY, RT) + stir() % (RT * 2);
        int dx = apart(CX, x), dy = apart(CY, y);
        if (isqrt(dx * dx + dy * dy) > less(RT, DIA)) continue;
        int ok = 1; for (j = 1; j <= placed; j++) { int ax = apart(X[j], x), ay = apart(Y[j], y); if (ax < DIA && ay < DIA && ax * ax + ay * ay < DIA * DIA) { ok = low; break; } }
        if (ok < 1) continue;
        placed++; X[placed] = x; Y[placed] = y; VX[placed] = VB; VY[placed] = VB;
    }
    N = placed;
    say("ping pong funnel: %d balls on a cone tray at %d tenths of a degree, %d mm to the rim, a %d mm hole; Henry %s, power %d of B; the world's chance %d\n",
        N, ANG, TRAYMM, HOLEMM, HENRY >= 2 ? "on" : "off", POWER, chance);
    say("each ball: %d microNewtons down the slope, %d held back by rolling on the tray; grip ball on ball %d thousandths\n", GRAV, ROLL, GRIP);
    int step, s = low;
    for (step = 1; step <= SECS * 1A89; step++) {
        if (step % 24A == 1) henry();
        forces(); roll();
        if (step % 1A89 < 1) { s++; report(s); }
    }
    map();
    return 1;
}
