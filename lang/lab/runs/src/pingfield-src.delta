// The ping pong field: thousands of balls, no pictures, only the data (21 Nov 2026, Mike: "now build the headless big run
// with thousands of balls ... this might show how matter forms"; the lab room stays the demo with a few balls).
// The same rules as the lab's tray (lang/lab/src/pingpong-src.delta) for one flat layer of 40 mm balls packed hex on a
// tray with a hole under the whole field: a Henry (or several side by side) pulls through every gap between the balls;
// energy flowing in from above (call it heat or light: Mike, "it's just a name for energy flow"): the whole tray in hot
// air, or Mike's Skil 8007 over the middle; each gap closes as its
// three balls' walls flatten into it; the rim, if open, leaks air down round the outside edge (Mike: "the outer edges have
// suction on them and air flow from above"). Each ball is a little different (its shell 0.4 mm, give or take a twentieth,
// from the world's chance: the box's own watts when it starts, mixed), so the field need not change all at once.
// Real: gas rule, orifice rule, the Henry's fan (more pull the less air it moves), heat by h, as in the lab. Rough guides:
// pliable from 90 C, full at 120, melting past 125; the gap's pull flattens soft walls (softness x pull / 1,000,000 a
// second, faster for thinner shells); fusing where they touch. Magic: the gun's power; balls never sag under their weight.
//
//   delta run lang/lab/runs/pingfield.delta ROWS COLS AIR_C HEAT_S END_S POWER HENRYS HOLE DOWN RIM MODE PLATE > out.txt
//   (PLATE: 1 none; 2 or more: a plate with a hole that many tenths of a mm across under every gap, the rim walled)
//   (all D numerals; any left off take the defaults: 3D x 3D balls, air 93 C (120), heat 1D3 s, end 3A1 s, power B,
//    henrys 1, hole 2 (0.3 mm; 1 sealed, 3 1 mm, 4 3 mm), down 1 (holes up; 2 down), rim 1 (open; 2 walled), mode 1
//    (the whole tray in hot air; 2 the Skil over the middle, 4 in up, fan 5))
#define NMAX {{10000}}
int PLATE = 1;                                  // 1: no plate (the tray open under the field); more: a plate with a hole this many TENTHS of a mm across under every gap (Mike: "a hole for each 3")
int N, ROWS = {{40}}, COLS = {{40}}, AIRC = {{120}}, HEATS = {{600}}, ENDS = {{1200}}, POWER = {{11}}, HENRYS = 1, HOLE = 2, DOWN = 1, RIM = 1, MODE = 1;
int low;
int T[NMAX], GAS[NMAX], SOFT[NMAX], FLAT[NMAX], MELT[NMAX], THICK[NMAX], NBN[NMAX];   // FLAT in millionths (slow changes add up)
int NB[{{60001}}], WELD[{{60001}}];            // six neighbour places a ball (none: N + 1)
int GA[{{20001}}], GB[{{20001}}], GC[{{20001}}], NG;   // the gaps: each between three balls
int GOPEN[{{20001}}], GSHUT[{{20001}}], GAIRQ[{{20001}}], GWORK[{{20001}}];   // the release ledger: each gap's last openness, when it
                                                // shut (s), the air its closing squeezed out (microlitres), the pull's work on its walls (nJ)
int RELN, RELS[{{3601}}];                       // releases so far, and how many came in each second
int RIMS;                                       // open places round the edge (a missing neighbour of an edge ball)
int GAP[NMAX];                                  // how many open gaps (or open rim) each ball borders
int PULL, FLOW, OUTG, ING, START;               // the pull under the tray (Pa); its air (ml/s); air out of / into the balls
int isqrt(int n) { if (n < 2) return n; int x = n, y = (x + 1) / 2; while (y < x) { x = y; y = (x + n / x) / 2; } return x; }
int idx(int r, int c) { return less(r, 1) * COLS + c; }
int pnum(char *s) { int v = low, i = 1; while (s[i] >= 1) { char ch = s[i]; int d = ch >= '1' && ch <= '9' ? less(ch, '0') : ch >= 'A' && ch <= 'D' ? less(ch, 'A') + {{10}} : low; if (d < 1) break; v = v * {{13}} + d; i++; } return v; }
int ppress(int i) { return GAS[i] * T[i] / {{1000}} * {{287}} / {{33500}}; }
int geq(int t, int po) { return po * {{33500}} / {{287}} * {{1000}} / t; }
int chance;                                     // the world's chance: the box's watts at the start, then mixed
int world()
{
    char w[{{40}}]; int fd = linux(2, "/sys/class/hwmon/hwmon1/power1_input", low, low), v = {{7919}};
    if (fd >= 1) { int n = linux(low, fd, &w[1], {{30}}), q = 1; linux(3, fd); while (q <= n && w[q] >= '0' && w[q] <= '9') { v = v * {{10}} + less(w[q], '0'); q++; } }
    return v % {{1000003}} + 1;
}
int stir() { chance = (chance * {{48271}} + {{12345}}) % {{2147483647}} + 1; return chance; }
void build()
{
    int r, c, k;
    N = ROWS * COLS;
    for (r = 1; r <= ROWS; r++) for (c = 1; c <= COLS; c++) {
        int i = idx(r, c), b = less(i, 1) * 6, odd = r % 2;
        // neighbours: left, right, and two above, two below (rows shift half a ball, odd rows to the right)
        int nb[7];
        nb[1] = c > 1 ? idx(r, less(c, 1)) : N + 1;
        nb[2] = c < COLS ? idx(r, c + 1) : N + 1;
        int lc = odd ? c : less(c, 1), rc = odd ? c + 1 : c;          // the two columns touched in the next row
        nb[3] = r > 1 && lc >= 1 ? idx(less(r, 1), lc) : N + 1;
        nb[4] = r > 1 && rc <= COLS ? idx(less(r, 1), rc) : N + 1;
        nb[5] = r < ROWS && lc >= 1 ? idx(r + 1, lc) : N + 1;
        nb[6] = r < ROWS && rc <= COLS ? idx(r + 1, rc) : N + 1;
        NBN[i] = low;
        for (k = 1; k <= 6; k++) { NB[b + k] = nb[k]; WELD[b + k] = 1; if (nb[k] <= N) NBN[i]++; else RIMS++; }
        // the gaps: below-right of this ball (it, its right neighbour, the ball touching both in the next row) and above-right
        if (nb[2] <= N && nb[6] <= N) { NG++; GA[NG] = i; GB[NG] = nb[2]; GC[NG] = nb[6]; }
        if (nb[2] <= N && nb[4] <= N) { NG++; GA[NG] = i; GB[NG] = nb[2]; GC[NG] = nb[4]; }
    }
    if (RIM == 2) RIMS = low;
}
int open(int g) { int f = (FLAT[GA[g]] + FLAT[GB[g]] + FLAT[GC[g]]) / {{3000}}; return f >= {{1000}} ? 1 : less({{1000}}, f) + 1; }   // thousandths
void henry()                                    // the pull where the Henrys' fans and the open gaps agree
{
    int g, area = RIMS * {{3200}};               // hundredths of a mm2: the open rim, half a gap a missing neighbour (a rough guide)
    int ph = PLATE * PLATE * {{785}} / {{1000}} + 1;              // a plate hole's open area (PLATE in tenths of a mm across: 0.785 x across x across)
    for (g = 1; g <= NG; g++) {
        int a1 = {{6400}} * open(g) / {{1000}} + 1;
        if (PLATE < 2) area = area + a1;
        else area = area + a1 * ph / (isqrt(a1 * a1 + ph * ph) + 1);   // the gap, then the plate's hole: two openings one after the other
    }
    area = area + 1;
    int top = {{20000}} * POWER / {{11}}, most = {{35000}} * HENRYS, lo = 1, hi = top, k;
    for (k = 1; k <= {{30}}; k++) {
        int mid = (lo + hi) / 2;
        int q = area * isqrt(mid * {{1667}} / {{1000}}) * 6 / {{1000}};
        int fan = top * less(most, q < most ? q : less(most, 1)) / most;
        if (fan > mid) lo = mid; else hi = mid;
    }
    PULL = lo; FLOW = area * isqrt(lo * {{1667}} / {{1000}}) * 6 / {{1000}};
}
int airat(int i)                                 // the air the ball sits in, thousandths of a degree from absolute cold
{
    int room = {{293150}};
    if (MODE == 1) return {{273150}} + AIRC * {{1000}};
    int r = less(i, 1) / COLS + 1, c = less(i, less(r, 1) * COLS);
    int dr = apart(r * {{35}}, (ROWS + 1) * {{35}} / 2), dc = apart(c * {{40}}, (COLS + 1) * {{40}} / 2) + (r % 2) * {{20}};   // mm off the middle
    int w = {{24}}, d2 = dr * dr + dc * dc;
    int out = {{2000}} * {{100000}} / {{1005}} + room;      // the Skil on fan 5: 2000 W heats 500 l/min this far
    int set = {{273150}} + AIRC * {{1000}}, gt = set < out ? set : out;
    return room + less(gt, room) * {{714}} / {{1000}} * (w * w) / (w * w + d2);
}
void step(int s)
{
    int i, k, g;
    henry();
    for (i = 1; i <= N; i++) GAP[i] = low;
    for (g = 1; g <= NG; g++) if (open(g) > {{50}}) { GAP[GA[g]]++; GAP[GB[g]]++; GAP[GC[g]]++; }
    for (i = 1; i <= N; i++) {
        int b = less(i, 1) * 6, hot = s <= HEATS;
        int air = hot ? airat(i) : {{293150}};
        int h = hot ? (MODE == 1 ? {{40}} : {{82}}) + (PULL > {{100}} ? {{40}} : low) : {{7}};
        int c = {{616}} * THICK[i] / {{1000}};
        if (air > T[i]) T[i] = T[i] + less(air, T[i]) * h / c; else T[i] = less(T[i], less(T[i], air) * h / c);
        int po = DOWN == 2 ? less({{101325}}, PULL) : {{101325}}, p = ppress(i), eq = geq(T[i], po);
        int a = HOLE == 1 ? 1 : HOLE == 2 ? {{71}} : HOLE == 3 ? {{785}} : {{7069}};
        if (p > po && GAS[i] > eq) { int f = a * isqrt(less(p, po) * {{24}} / {{10}}) * 6 / {{10}} + 1; if (f > less(GAS[i], eq)) f = less(GAS[i], eq); GAS[i] = less(GAS[i], f); OUTG = OUTG + f; }
        else if (p < po && eq > GAS[i]) { int f = a * isqrt(less(po, p) * {{24}} / {{10}}) * 6 / {{10}} + 1; if (f > less(eq, GAS[i])) f = less(eq, GAS[i]); GAS[i] = GAS[i] + f; ING = ING + f; }
        p = ppress(i);
        SOFT[i] = T[i] > {{363150}} ? less(T[i], {{363150}}) / {{30}} + 1 : 1; if (SOFT[i] > {{1000}}) SOFT[i] = {{1000}};
        if (T[i] > {{398150}}) { MELT[i] = MELT[i] + less(T[i], {{398150}}) / {{1000}} * 3 + 1; if (MELT[i] > {{1000}}) MELT[i] = {{1000}}; }
        int thin = {{1000}} * {{1000}} / THICK[i] * {{1000}} / THICK[i];           // thinner shells give more easily
        int rimopen = low; for (k = 1; k <= 6; k++) if (NB[b + k] > N && RIM == 1) rimopen = 1;
        if ((GAP[i] >= 1 || rimopen) && PULL >= 1) FLAT[i] = FLAT[i] + SOFT[i] * PULL / {{1000}} * thin / {{1000}};
        if (p > po && NBN[i] >= 1) FLAT[i] = FLAT[i] + SOFT[i] * less(p, po) / {{1000}} * thin / {{1000}};   // swelling against its neighbours
        if (FLAT[i] > {{1000000}}) FLAT[i] = {{1000000}};
        for (k = 1; k <= 6; k++) { int j = NB[b + k]; if (j <= N) { int sj = SOFT[j] < SOFT[i] ? SOFT[j] : SOFT[i]; WELD[b + k] = WELD[b + k] + sj / {{50}}; if (WELD[b + k] > {{1000}}) WELD[b + k] = {{1000}}; } }
    }
}
void ledger(int s)                              // what leaves as each gap closes (Mike: "add the release ledger")
{
    int g;
    for (g = 1; g <= NG; g++) {
        int o = open(g);
        if (o < GOPEN[g]) {
            int dv = less(GOPEN[g], o) * {{2560}} / {{1000}};      // microlitres: its column, 64 mm2 x 40 mm, closing by that much
            GAIRQ[g] = GAIRQ[g] + dv; GWORK[g] = GWORK[g] + PULL * dv;   // Pa x mm3 = nJ
        }
        GOPEN[g] = o;
        if (GSHUT[g] < 1 && o <= {{50}}) {
            GSHUT[g] = s; RELN++; if (s <= {{3600}}) RELS[s]++;
            int r = less(GA[g], 1) / COLS + 1, c = less(GA[g], less(r, 1) * COLS);
            say("release %d: at %d s, the gap by row %d ball %d shut: %d microlitres of air out, %d nJ of work on its walls\n", RELN, s, r, c, GAIRQ[g] + 1, GWORK[g] + 1);
        }
    }
}
void ledgersum()
{
    int g, n = low, lo = {{2000000000}}, hi = low, sum = low, k;
    for (g = 1; g <= NG; g++) if (GSHUT[g] >= 1) { n++; sum = sum + GWORK[g]; if (GWORK[g] < lo) lo = GWORK[g]; if (GWORK[g] > hi) hi = GWORK[g]; }
    if (n < 1) { say("the release ledger: no gap shut\n"); return; }
    int mean = sum / n;
    say("the release ledger: %d of %d gaps shut; work on the walls a gap: least %d nJ, most %d, mean %d\n", n, NG, lo + 1, hi + 1, mean + 1);
    // equal packets or a spread? how many fall within a tenth of the mean, and in each fifth of the mean either side
    int bands[{{12}}]; for (k = 1; k <= {{11}}; k++) bands[k] = low;
    for (g = 1; g <= NG; g++) if (GSHUT[g] >= 1) { int b = GWORK[g] * 5 / (mean + 1) + 1; if (b > {{11}}) b = {{11}}; bands[b]++; }
    say("  by size (fifths of the mean, the last 2 x the mean and over):");
    for (k = 1; k <= {{11}}; k++) say(" %d", bands[k] + 1);
    say("  (each count plus 1)\n");
    // steady or in bursts: the busiest second, and how many seconds saw any
    int busy = low, at = 1, secs = low;
    for (k = 1; k <= {{3600}}; k++) { if (RELS[k] >= 1) secs++; if (RELS[k] > busy) { busy = RELS[k]; at = k; } }
    say("  in time: they came over %d seconds; the busiest, second %d, saw %d at once\n", secs, at, busy);
}
void report(int s)
{
    int i, g, t = low, so = low, f = low, hexn = low, inner = low, me = low, shut = low;
    for (i = 1; i <= N; i++) {
        t = t + T[i] / {{100}}; f = f + FLAT[i] / {{1000}};
        if (SOFT[i] >= {{500}}) so++;
        if (MELT[i] >= {{500}}) me++;
        if (NBN[i] == 6) { inner++; if (FLAT[i] >= {{950000}}) hexn++; }
    }
    for (g = 1; g <= NG; g++) if (open(g) <= {{50}}) shut++;
    int tc = t / N; int warm = tc > {{2731}} ? less(tc, {{2731}}) : 1;     // tenths of a degree above freezing
    say("%d s  warmth %d tenths C  soft %d of %d  flat %d  hex %d of %d inner  gaps shut %d of %d  pull %d Pa  air %d ml/s  melted %d\n",
        s, warm, so, N, f / N, hexn, inner, shut, NG, PULL, FLOW + 1, me);
}
void map()                                       // the field from above: # hex, o half, . round, ~ melted
{
    int r, c;
    say("the field from above (# hex, o half way, . still round, ~ melted):\n");
    for (r = 1; r <= ROWS; r++) {
        char line[{{220}}]; int n = low;
        if (r % 2 < 1) { n++; line[n] = ' '; }
        for (c = 1; c <= COLS; c++) {
            int i = idx(r, c);
            n++; line[n] = MELT[i] >= {{500}} ? '~' : FLAT[i] >= {{950000}} ? '#' : FLAT[i] >= {{500000}} ? 'o' : '.';
            n++; line[n] = ' ';
        }
        n++; line[n] = low;
        say("%s\n", &line[1]);
    }
}
int main(int argc, char **argv)
{
    low = less(1, 1);
    if (argc >= 2) ROWS = pnum(argv[2]); if (argc >= 3) COLS = pnum(argv[3]); if (argc >= 4) AIRC = pnum(argv[4]);
    if (argc >= 5) HEATS = pnum(argv[5]); if (argc >= 6) ENDS = pnum(argv[6]); if (argc >= 7) POWER = pnum(argv[7]);
    if (argc >= 8) HENRYS = pnum(argv[8]); if (argc >= 9) HOLE = pnum(argv[9]); if (argc >= {{10}}) DOWN = pnum(argv[{{10}}]);
    if (argc >= {{11}}) RIM = pnum(argv[{{11}}]); if (argc >= {{12}}) MODE = pnum(argv[{{12}}]); if (argc >= {{13}}) PLATE = pnum(argv[{{13}}]);
    if (PLATE >= 2) RIM = 2;                                   // a plate under the balls: the rim walled, the air only through the holes
    if (ROWS * COLS > NMAX || ROWS < 2 || COLS < 2) { say("rows x cols: 2 x 2 up to the most this holds\n"); return 2; }
    chance = world();
    build();
    int i, s, g;
    for (i = 1; i <= N; i++) {
        T[i] = {{293150}}; GAS[i] = geq(T[i], {{101325}}); START = START + GAS[i];
        SOFT[i] = 1; FLAT[i] = 1; MELT[i] = 1;
        THICK[i] = {{950}} + stir() % {{101}};       // its shell: 0.95 to 1.05 of 0.4 mm (the world's chance)
    }
    say("ping pong field: %d x %d balls (%d), %d gaps, %d open rim places; energy in: air at %d C for %d s, then room air to %d s\n", ROWS, COLS, N, NG, RIMS, AIRC, HEATS, ENDS);
    if (PLATE >= 2) say("a plate under the balls: a hole %d tenths of a mm across under every gap, the rim walled\n", PLATE);
    say("Henry power %d of B, %d Henrys; hole %d (1 sealed, 2 0.3 mm, 3 1 mm, 4 3 mm), holes %s; rim %s; %s; the world's chance %d\n",
        POWER, HENRYS, HOLE, DOWN == 2 ? "down" : "up", RIM == 2 ? "walled" : "open", MODE == 1 ? "the whole tray in hot air" : "the Skil over the middle", chance);
    for (g = 1; g <= NG; g++) { GOPEN[g] = open(g); GSHUT[g] = low; }
    for (s = 1; s <= ENDS; s++) { step(s); ledger(s); if (s % {{60}} < 1 || s == 1) report(s); }
    map();
    ledgersum();
    int left = low; for (i = 1; i <= N; i++) left = left + GAS[i];
    if (left + OUTG == START + ING) say("the air's book balances: in the balls %d + moved out %d = at the start %d + moved in %d (micrograms)\n", left, OUTG, START, ING);
    else say("the air's book is OUT: in the balls %d, out %d, start %d, in %d\n", left, OUTG, START, ING);
    return 1;
}
