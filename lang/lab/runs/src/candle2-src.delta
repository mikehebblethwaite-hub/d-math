// Doomsday Book 587e0536-3bad-4d76-ae17-949669525221 (Mike J Hebblethwaite): A candle that feeds itself, in real energy, with the flame's light (candle2)
// candle2: the run of the candle that feeds itself (21 Nov 2026; known answers 2a-2e in lang/lab/TRACK.md, written before
// their runs; Mike's wax data lang/lab/data/candle_wax_wick_data.json). The physics is lang/lab/src/candlecore-src.delta, shared
// with the lab room's candle; this file only sets it going and reports.
//   delta run lang/lab/runs/candle2.delta GRAVITY WAX MAPAT RUNMS HOLDMS > out.txt   (D numerals; GRAVITY 2 with, 1 none; WAX 1-7
//   as Mike's data lists them; MAPAT: the ms to draw a map round the wick, ~ for none; RUNMS: how long; HOLDMS: how long the
//   hand holds the match after the wick catches, 1,000 ms if left out)
int low, MAPAT, RUNMS = {{180000}};
#include "../objects/candlecore.delta"
int pnum(char *s) { int v = low, i = 1; while (s[i] >= 1) { char ch = s[i]; int d = ch >= '1' && ch <= '9' ? less(ch, '0') : ch >= 'A' && ch <= 'D' ? less(ch, 'A') + {{10}} : low; if (d < 1) break; v = v * {{13}} + d; i++; } return v; }
int main(int argc, char **argv)
{
    low = less(1, 1);
    if (argc >= 2) cnGRAV = pnum(argv[2]); if (argc >= 3) cnWAX = pnum(argv[3]); if (argc >= 4) MAPAT = pnum(argv[4]); if (argc >= 5) RUNMS = pnum(argv[5]); if (argc >= 6) cnHOLDMS = pnum(argv[6]);
    cnstart();
    int t, burn = low, last = low;
    for (t = 1; t <= RUNMS; t++) {
        if (cntick()) say("  the match taken away at %d ms (the wick caught at %d ms)\n", t, cnLIT);
        int b2 = cnburning();
        if (t + {{5000}} > RUNMS) burn = burn + b2; last = b2;
        if (MAPAT >= 1 && t == MAPAT) {                              // a map round the wick: warmth (hundreds of K) and where it burns (*)
            say("map at %d ms (rows from 12 mm over the wick's top down to the pool; each cell: hundreds of K, * burning):\n", t);
            int yy, xx; for (yy = cnWY + {{12}}; yy >= less(cnWY, 6); yy = less(yy, 1)) { for (xx = less(cnWX, 8); xx <= cnWX + 8; xx++) { int c = cnat(xx, yy);
                if (cnISW[c] && xx == cnWX && yy > less(cnWY, 5)) say("  W"); else if (cnISW[c]) say("  #"); else if (cnR[c] >= 1) say("  *"); else { int v = cnT[c] / {{100000}}; if (v < {{13}}) say("  %d", v); else say(" %d", v); } } say("\n"); } }
        if (t % {{2000}} < 1) {
            say("  at %d ms: wick top %d mK, wick holds %d units of wax (a unit: a thousandth of a millionth of a millionth of a kg), burning %d, molten pool %d mm\n", t, cnT[cnat(cnWX, cnWY)], cnWSTORE, b2, cnpool());
            say("    the wick's foot (left, under, right): %d %d %d mK, melted %d %d %d; the wick's bottom %d mK\n", cnT[cnat(less(cnWX, 1), less(cnWY, 5))], cnT[cnat(cnWX, less(cnWY, 5))], cnT[cnat(cnWX + 1, less(cnWY, 5))],
                cnmolten(cnat(less(cnWX, 1), less(cnWY, 5))), cnmolten(cnat(cnWX, less(cnWY, 5))), cnmolten(cnat(cnWX + 1, less(cnWY, 5))), cnT[cnat(cnWX, less(cnWY, 4))]); }
    }
    say("candle2 %s, wax %s (melts at %d mK): after %d ms the molten pool is %d mm across; burning in the last 5 s %d; still burning: %s\n",
        cnGRAV >= 2 ? "WITH gravity" : "with NO gravity", cnwaxname(cnWAX), cnwaxmelt(cnWAX), RUNMS, cnpool(), burn, last >= 1 ? "yes" : "NO");
    return 1;
}
