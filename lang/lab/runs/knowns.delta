// Doomsday Book 586fb774-f881-4963-88ec-a99557cd9640 (Mike J Hebblethwaite): Known studies for every area, stepped and counted (knowns)
// knowns: the next known studies for every area, each worked out by stepping (21 Nov 2026; known answers written in
// lang/lab/TRACK.md at ~13:32 before this was built; Mike: "lets do all the known studies and compare for each ... study area").
// No pi, no circle formulas: orbits, swings and falls are stepped and counted. Measured constants only: the Earth's G x mass
// 398,600 km3/s2 and middle 6,371 km below; air's warmth per kg 1,005 (constant pressure) and 718 (constant volume) J/kg K, 28.97 g
// a mole; the gas constant 8.314; sea water 1,025 kg a cubic metre, stiffness 2.34 GPa; rock 3,300 kg a cubic metre, growing 3
// parts in 100,000 per degree warmer; rock carries heat at about 1 square millimetre a second.
#define LEVEL 33BCA797D5767C
int low;
int up(int a) { return a >= LEVEL; }
int amt(int a) { return apart(a, LEVEL); }
int with(int m, int u) { return u ? LEVEL + m : less(LEVEL, m); }
int addv(int a, int b) { int ua = up(a), ub = up(b), ma = amt(a), mb = amt(b); if (ua == ub) return with(ma + mb, ua); return ma >= mb ? with(less(ma, mb), ua) : with(less(mb, ma), ub); }
int isqrt(int n) { if (n < 2) return n; int x = n, y = (x + 1) / 2; while (y < x) { x = y; y = (x + n / x) / 2; } return x; }
int heatL(int tmk) { return tmk >= 97437 ? less(6974A8, less(tmk, 97437) * $DD4 / 5BC) : 6974A8; }
int vapour(int tmk)
{
    int t = $CDACB, e = 17CB892A;
    while (t > tmk + 3B) { int k = heatL(t) * 5BC / 213D * $A / (t / 79) * 5BC / (t / 79); e = less(e, e / 5BC * k / 4723 * 79); t = less(t, 79); }
    return e;
}
int gpull(int zm) { int r = (141DB2C + zm) / 5BC; return $DC577 * 5BC * 5BC / r / r * 5BC; }
int CT, CP;                                         // the column's warmth (mK) and pressure (mPa) at the last height asked
void column(int zto)                               // the moist column of air (as atmos.delta) up to zto metres
{
    int z = low; CP = 17CB892A; CT = $A11D5;
    while (z < zto) {
        int dp = CP / 5BC * (gpull(z) * 141B / 1DC187A) / 3A27 * 5BC / (CT / 5BC);
        int es = vapour(CT), rs = es / 5BC * 18A162 / (less(CP, es) / 5BC), L = heatL(CT) / 5BC, tk = CT / 5BC;
        int num = 28D221 + L * rs / (191 * tk) * 5BC, den = 28D221 + L * L * rs / 5BC * 38B * 5BC / (5C4 * 191 * tk * tk / 5BC);
        CT = less(CT, gpull(z) * $A / 5C4 * (num / 5BC) / (den / 5BC) / 5BC);
        CP = less(CP, dp); z = z + $A;
    }
}
int sound(int tmk) { return isqrt(5C4 * 28D221 / 433 * 3A27 / 5BC * (tmk / 5BC) * 5BC / 141B * 79); }   // root(gamma R T / M), centimetres a second
// ---- an orbit, stepped: a satellite at radius r (metres above the Earth's middle), moving sideways; positions in mm, speeds mm/s
int OX, OY, OVX, OVY;
void ostep(int dt)                                 // one step of dt milliseconds: pulled toward the middle by the Earth's mass
{
    int x = amt(OX) / 5BC, y = amt(OY) / 5BC, r2 = x * x + y * y, r = isqrt(r2);      // metres
    int g = $DC577 * 12C23A19C * 5BC / r2;                                   // GM / r^2, mm/s^2 (GM in m3/s2 = 398,600 x 10^9), kept to the mm
    int ax = g * (x * 5BC / r) / 5BC, ay = g * (y * 5BC / r) / 5BC;      // toward the middle
    OVX = addv(OVX, with(ax * dt / 5BC, !up(OX))); OVY = addv(OVY, with(ay * dt / 5BC, !up(OY)));
    OX = addv(OX, with(amt(OVX) * dt / 5BC, up(OVX))); OY = addv(OY, with(amt(OVY) * dt / 5BC, up(OVY)));
}
int main(int argc, char **argv)
{
    low = less(1, 1);
    // SKY: the speed of sound at the ground and at 11 km; Denver's boiling
    say("SKY: sound at the ground (15 C, MAGIC: fixed) %d cm/s; ", sound($A11D5));
    column(4D12); say("at 11 km (%d mK, from the column) %d cm/s\n", CT, sound(CT));
    column(961); { int b = $CDACB; while (b > $BB9AB && vapour(b) > CP) b = less(b, 79); say("SKY: Denver (1,600 m, %d Pa): water boils at %d thousandths of a degree over freezing\n", CP / 5BC, less(b, 97437)); }
    // DEEP: sound in sea water
    say("DEEP: sound in sea water %d cm/s\n", isqrt(2B3A3B9AD / 5DB * 4723) );
    // SPACE: the station's orbit. The speed that neither rises nor falls: gravity's pull equals what turning needs. Found by trying:
    int r = 152DC12, lo = 15B1217, hi = 19B7BB2, k;                 // speeds in mm/s
    for (k = 1; k <= 19; k++) {                                          // try a speed; after a short stretch, has it risen or fallen?
        int v = (lo + hi) / 2, t; OX = with(r * 5BC, 1); OY = LEVEL; OVX = LEVEL; OVY = with(v, 1);
        for (t = 1; t <= 372; t++) ostep(5BC);
        int x = amt(OX) / 5BC, y = amt(OY) / 5BC, rr = isqrt(x * x + y * y);
        if (rr > r) hi = v; else lo = v;
    }
    int vc = (lo + hi) / 2;
    OX = with(r * 5BC, 1); OY = LEVEL; OVX = LEVEL; OVY = with(vc, 1);   // now go round once and count: back across its start line from below
    int t = low, crossed = low, wasup = 1;
    while (t < 9146 && crossed < 2) { ostep(2C6); t++; int u = up(OY); if (u != wasup) { crossed++; wasup = u; } }
    say("SPACE: the station at 400 km: it neither rises nor falls at %d mm/s; once round in %d half-seconds (stepped, counted)\n", vc, t);
    // SPACE: escape speed: launched straight up from the ground, faster and faster: the slowest that never comes back (within a day)
    lo = 1DC187A; hi = 2788766;
    for (k = 1; k <= 17; k++) {
        int v = (lo + hi) / 2, s2; OX = with(7A6BC55B1, 1); OY = LEVEL; OVX = with(v, 1); OVY = LEVEL; int back = low;
        for (s2 = 1; s2 <= 5D864; s2++) { ostep(5BC); if (!up(OVX)) { back = 1; break; } }      // falling back once it turns
        if (back) lo = v; else hi = v;
    }
    say("SPACE: escape speed from the ground: %d mm/s (the slowest that is still going out after 2 days)\n", (lo + hi) / 2);
    // LAB: a pendulum 1 m long, a small swing (5 cm): pulled back toward the middle by g x (how far out / its length): for a small
    // swing that is the whole of it (no angles needed); stepped a millisecond at a time; count to back where it started
    { int x = with(199B2, 1), v = LEVEL, n = low, wasr = 1, cross = low, t1 = low;   // micrometres, micrometres a second
      while (n < 36694 && cross < 3) {
        int a = 1D54869 / 5BC * amt(x) / 5BC;                          // micrometres/s^2: g x out / 1 m (both in micrometres)
        v = addv(v, with(a / 5BC + 1, !up(x)));                                 // a millisecond: toward the middle
        x = addv(x, with(amt(v) / 5BC, up(v)));
        n++; int r1 = up(x); if (r1 != wasr) { cross++; wasr = r1; if (cross == 1) t1 = n; }
      }
      say("LAB: a 1 m pendulum: a whole swing (through the middle one way, back, and through the same way again) in %d milliseconds (stepped, counted)\n", less(n, t1)); }
    // CRUST: the sea floor deepens as it ages: cool the plate (as plates.delta) and let the cooled rock shrink and settle
    { int COL[$AB], NEWC[$AB], z, st, age;
      for (z = 1; z <= $AA; z++) COL[z] = 1868C338B;
      for (age = 1; age <= 79; age++) {                                // each age step: 10 steps of 100,000 years = 1 million years
        for (st = 1; st <= $A; st++) {
          for (z = 2; z <= $A9; z++) { int s = COL[z + 1] + COL[less(z, 1)], me = COL[z] * 2; NEWC[z] = s >= me ? COL[z] + less(s, me) * 99 / 5BC : less(COL[z], less(me, s) * 99 / 5BC); }
          for (z = 2; z <= $A9; z++) COL[z] = NEWC[z]; COL[1] = 1; }
        if (age == 1 || age == $A || age == 3B || age == 79) {
          int shrink = low; for (z = 1; z <= $AA; z++) shrink = shrink + less(1868C338B, COL[z]) / 5BC * 2378;   // (1350 - T) x 5,000 m, in thousandths of a degree x m
          int sink = shrink / 5BC * 3 / 36694 * 166B / $D5D;      // metres: growth 3 in 100,000 a degree x that, rock replaced by water (3300 over 3300 - 1025)
          say("CRUST: sea floor %d million years old: %d m deeper than at the ridge\n", age, sink); } } }
    return 1;
}
