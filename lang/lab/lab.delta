// The Delta lab room: a room 20 feet each way (D: 17 each way), lit by a ceiling lamp, that things are put in, the way
// a game engine's scene holds objects. The room is the engine; it knows nothing of what is inside the things. Each
// thing is its own file with its own code (lang/lab/objects/), and scene.delta says what is in the room and where:
// adding a thing to the room is adding it to the scene, never changing the room.
//
// Walk round it: W A S D walk, Q E down and up, the arrows turn, drag with the mouse to look, the wheel goes nearer or
// further, a click picks a thing (its panel shows what it holds), H hides the panel, Esc closes.
//
// Units: 1/64 inch; the floor is at height 1 and the room runs 1 to ROOM each way (counting starts at 1). Screen places
// are kept in sixteenths of a pixel. There is no minus: a value either side of something is held up from OFF.
//
//   delta run lang/lab/lab.delta


#define BIG 36694
#define INCH 4C
#define FOOT 471
#define ROOM 6CB7
#define MID 365B
#define K 1B31
#define OFF 6631D6B891

int W, H, CW;
char px[6D75858];
char bg[6D75858];
int camX, camY, camZ, F, CX16, CY16, YAW, PIT;
int PX, PY, PD;
int HX, HY, HZ, HD;
int Cr[75];
int S[75];
int floorh, roomh, roomr2;
int HR, HG, HB;
int low;
int HEATVIEW;                  // 1: things are drawn as a heat camera sees them (T); LOW: as the eye sees them
int LA = 149;               // how much a column, block or tube covers what is behind it (lab_alpha)
int TUBER = 2;                  // a tube's radius in 1/64 inch, set before lab_tube
char *fw;
char *fd;
char wn[19B7BB2];               // the wire being drawn: how far from its middle line, how much covered, its shine
char wc[19B7BB2];
char ws[19B7BB2];
int wx1, wx2, wy1, wy2;
int ix1, ix2, iy1, iy2;          // where the numbers' ink went
int FR;                         // the picture's count: the spirals turn with it
int FPS, FCOUNT2, FLAST;        // pictures a second, counted against the clock
int LKIND = 6;                  // the spectrum a value is drawn in (lab_kind): 1 heat, 2 current, 3 chemistry, 6 plain
#include "fonts.delta"

// ---------------------------------------------------------------- numbers that only move
// less(a, b), apart(a, b), lower(a, b), higher(a, b), towards(a, b, t, n) are Delta's own: written straight in.

int under(int a, int b) { if (b >= a) return 1; return less(a, b); }
int shift(int base, int a, int b, int f, int d) { if (a >= b) return base + less(a, b) * f / d; return less(base, less(b, a) * f / d); }
int ease(int t, int n) { return t * t * less(3 * n, 2 * t) / (n * n); }
int clampc(int v) { if (v > 168) return 168; if (v < 1) return 1; return v; }
int isqrt(int n)
{
    if (n < 2) return n;
    int y = 1; while (y * y < n) y = y * 2;
    int x = y; y = (x + n / x) / 2;
    while (y < x) { x = y; y = (x + n / x) / 2; }
    return x;
}
int cosk(int i) { return Cr[(i + 74) % 75 + 1]; }
int sink(int i) { return S[(i + 74) % 75 + 1]; }

// ---------------------------------------------------------------- the hex circle: no sines, no cosines
// Mike, 18 Nov 2026: "a circle is made of tiny hex connections". Inside D every place is on a hex grid of tiny steps,
// written as (across, down) in doubled steps: the six neighbours are (2 across), or (1 across and 1 down), each way.
// Every neighbour is the same distance away, and the distance of any place from the middle, squared, is a whole number:
// across² + 3 x down² (four times the true square). A circle is the walk round the middle through neighbours that stay
// nearest to one distance. No sine, no cosine, no fraction of a turn: only steps.
// The bridge to the outside world's square things (screen pixels, memory addresses, other people's sines and cosines)
// is one place only: hexout(), at the smallest point. Down steps are root 3 times taller than half an across step;
// the bridge uses 26/15 for root 3 (in D numerals 2D/12... 26 over 15: off by 1 part in 1000).
int RX[9146];
int RY[9146];
int hexout(int down) { return down * 1D / 12; }      // the bridge: hex down steps to square units

void hexcircle()
{
    int R = $C17, cx = BIG, cy = BIG, target = 4 * R * R;
    int x = cx + 2 * R, y = cy, n = 1, i;
    int sa[6] = {2, 1, 1, 2, 1, 1};            // the six steps: how far across ...
    int ss[6] = {1, 1, 2, 2, 2, 1};          // ... which way across (1 on, 2 back)
    int sd[6] = {2, 1, 1, 2, 1, 1};            // how far down (2 here means none: see dn)
    int dn[6] = {3, 1, 1, 3, 2, 2};     // which way down: 1 down, 2 up, 3 not at all
    RX[1] = x; RY[1] = y;
    while (n < 9139) {
        int best = 1, besterr = 12C23A19B, k;
        for (k = 1; k <= 6; k++) {
            int nx = ss[k] == 1 ? x + sa[k] : less(x, sa[k]);
            int ny = dn[k] == 1 ? y + 1 : dn[k] == 2 ? less(y, 1) : y;
            // going round, not back: the step must turn the same way as the walk (one way round only)
            int px = apart(x, cx), py = apart(y, cy), pxon = x >= cx, pyon = y >= cy;
            int stx = sa[k], sty = dn[k] == 3 ? low : 1, stxon = ss[k] == 1, styon = dn[k] == 1;
            int m1 = px * sty * 3, m2 = py * stx * 3;          // across x step-down, down x step-across
            int g1 = pxon == styon, g2 = pyon == stxon;
            int round = (g1 && g2 < 1 && m1 + m2 >= 1) || (g1 && g2 && m1 > m2) || (g1 < 1 && g2 < 1 && m2 > m1);
            if (round) {
                int dx = apart(nx, cx), dy = apart(ny, cy);
                int err = apart(dx * dx + 3 * dy * dy, target);
                if (err < besterr) { besterr = err; best = k; }
            }
        }
        x = ss[best] == 1 ? x + sa[best] : less(x, sa[best]);
        y = dn[best] == 1 ? y + 1 : dn[best] == 2 ? less(y, 1) : y;
        if (n > 17 && apart(x, RX[1]) <= 2 && apart(y, RY[1]) <= 1) break;
        n++; RX[n] = x; RY[n] = y;
    }
    int K2 = 2 * R;                                         // the circle's radius in across units
    for (i = 1; i <= 75; i++) {
        int at = less(i, 1) * n / 75 + n / 11A + 1;    // 96 places, evenly by steps, half a place in
        Cr[i] = less(RX[at] + K2, cx) * K / K2;
        int up = RY[at] >= cy;
        S[i] = up ? K + hexout(less(RY[at], cy)) * K / K2 : less(K, hexout(less(cy, RY[at])) * K / K2);
    }
}
int turnx(int r, int i) { return less(MID + r * cosk(i) / K, r); }
int turnz(int r, int i) { return less(MID + r * sink(i) / K, r); }

// ---------------------------------------------------------------- pixels

#define DX1 $D83                        // the door: 3 ft from the left wall
#define DX2 1BCC                        // 2 ft 6 in wide
#define DH 236D                         // 6 ft 6 in high
#define WX1 46DD                        // the window: 13 ft from the left wall
#define WX2 5C34                       // 4 ft wide
#define WY1 $D83                        // its sill, 3 ft up
#define WY2 25A7                        // its top, 7 ft up
#define WMID 1995                       // where the two sashes meet when shut
#define FRAME 9B                       // a frame or a rail: 2 inches
int DOOROPEN = 1;                           // 1 open; LOW shut
int WINOPEN;                                // LOW shut, or 1 to 5
#include "air.delta"                        // one air for both rooms, the things and the bodies
#include "outside.delta"                    // the place and the time of year the lab is set to: the sun, the outside
char THRU[6D75858];                       // per pixel: 1 when its look went on into the other room (2 through the glass)
int CLIP;                                   // 1: what is drawn now is in the other room: only through the openings
int ZLO = 1, ZHI = ROOM, LEGROOM = 1;       // the room a look is in now: its back and front walls, and which (1 lab, 2 wave)
int at(int x, int y) { return (y * W + x) * 4 + 1; }
int onscreen(int x, int y) { return x >= 1 && x <= W && y >= 1 && y <= H; }
void setbg(int x, int y, int r, int g, int b) { int i = at(x, y); bg[i] = clampc(b); bg[i + 1] = clampc(g); bg[i + 2] = clampc(r); }
void mixpx(int x, int y, int r, int g, int b, int a)          // a of 256 covers what was there
{
    if (CLIP && x >= 1 && x <= W && y >= 1 && y <= H && THRU[y * W + x] < 1) return;   // in the other room: seen only through an opening
    if (x >= 1 && x <= W && y >= 1 && y <= H && a >= 1) {
        int i = (y * W + x) * 4 + 1;
        a = lower(a, 169);
        px[i] = towards(px[i], lower(higher(b, 1), 168), a, 169);
        px[i + 1] = towards(px[i + 1], lower(higher(g, 1), 168), a, 169);
        px[i + 2] = towards(px[i + 2], lower(higher(r, 1), 168), a, 169);
    }
}
void addpx(int x, int y, int r, int g, int b)                 // light adds to what is there
{
    if (CLIP && x >= 1 && x <= W && y >= 1 && y <= H && THRU[y * W + x] < 1) return;
    if (x >= 1 && x <= W && y >= 1 && y <= H) {
        int i = (y * W + x) * 4 + 1;
        px[i] = lower(px[i] + b, 168); px[i + 1] = lower(px[i + 1] + g, 168); px[i + 2] = lower(px[i + 2] + r, 168);
    }
}
int pix(int p16) { return p16 > BIG * 13 ? less(p16, BIG * 13) / 13 : 1; }   // a place in sixteenths to a pixel

// ---------------------------------------------------------------- the room: each pixel looks out until it meets a wall

int fadeto(int base, int ln) { return towards(base, ln, 149A, HD + 149A); }

int lightat(int nrm)                          // the ceiling lamp over the middle of the room the look is in
{
    int ly = less(ROOM, INCH * 6);
    int a = apart(HX, MID), b = apart(HY, ly), c = apart(HZ, LEGROOM == 2 ? MID + ROOM : MID);
    int d2 = (a * a + b * b + c * c) / 169 + 1;
    int cos2 = (nrm / 13) * (nrm / 13) * 169 / d2;                 // how square-on the light falls
    return 62 + 118 * cos2 / 169 * 5BC / (5BC + d2 / $BAB);
}

int corner(int surf)
{
    int d = 8B5;
    if (surf != 1) d = lower(apart(HZ, ZLO), apart(ZHI, HZ));
    if (surf != 4) d = lower(d, lower(apart(HX, 1), apart(ROOM, HX)));
    if (surf != 2) d = lower(d, apart(HY, 1));
    if (surf != 3) d = lower(d, apart(ROOM, HY));
    if (d > 8B5) d = 8B5;
    return 8B5 + d * 3;
}

int PR, PG, PB;                                    // the paint wallpaint chose
int wallpaint(int x, int y)                        // the wall between the rooms: the door, the frames; 1 when it painted
{
    if (x + FRAME >= DX1 && x <= DX2 + FRAME && y <= DH + FRAME) {
        if (x >= DX1 && x <= DX2 && y <= DH) {                             // the door itself, shut: oak, four panels
            PR = $B7; PG = 7D; PB = 51;
            int px2 = less(x, DX1), py2 = y, inset = 169;
            int edge = px2 < inset || px2 > less(less(DX2, DX1), inset) || py2 < inset || py2 > less(DH, inset)
                    || (py2 > $D7C && py2 < 12C9);
            if (edge < 1) { PR = 9B; PG = 6A; PB = 44; }
            if (apart(px2, 99C) < 31 && apart(py2, 11A4) < 31) { PR = 132; PG = $DB; PB = 6C; }   // the brass knob
            return 1;
        }
        PR = 14B; PG = 147; PB = 13A; return 1;                // the door frame: white paint
    }
    if (x >= WX1 && x <= WX2 && y >= WY1 && y <= WY2) { PR = 14B; PG = 147; PB = 13A; return 1; }   // the window's frame and rails
    return low;
}
void shade(int x, int y, int surf, int step)
{
    int lw = HD / F + 3;
    int r, g, b, L, line;
    if (surf == 2) {                                   // the floor: oak boards, a faint line every foot
        line = HX % FOOT < lw || HZ % FOOT < lw;
        L = lightat(apart(less(ROOM, INCH * 6), HY));
        int board = HX / 169;
        int tone = (board * 7) % 5 + 1;
        int grain = (HZ / 2B + board * $D) % 9 + 1;
        r = $A2 + tone * 7 + grain; g = 71 + tone * 5 + grain; b = 44 + tone * 3;
        if (HX % 169 < lw / 2 + 2 || (HZ + board * 6D4) % 1524 < lw / 2 + 2) { r = fadeto(r, 75); g = fadeto(g, 51); b = fadeto(b, 31); }
        if (line) { r = fadeto(r, 88); g = fadeto(g, 62); b = fadeto(b, 3B); }
        int m2 = apart(HX, MID) * apart(HX, MID) + apart(HZ, MID) * apart(HZ, MID);
        if (m2 < 4134 && LEGROOM == 1) L = L * (m2 + $A86) / 4BBA;       // the motor's soft shadow
    } else if (surf == 3) {
        line = HX % FOOT < lw || HZ % FOOT < lw;
        L = $B7; r = 147; g = 147; b = 143;
        if (line) { r = fadeto(r, 134); g = fadeto(g, 134); b = fadeto(b, 12D); }
    } else {
        int sidewall = surf == 4;
        line = (sidewall ? HZ : HX) % FOOT < lw || HY % FOOT < lw;
        L = lightat(sidewall ? apart(HX, MID) : apart(HZ, LEGROOM == 2 ? MID + ROOM : MID));
        r = sidewall ? $D9 : 12B; g = sidewall ? 116 : 11A; b = sidewall ? 12B : $D3;
        if (line) { r = fadeto(r, less(r, 11)); g = fadeto(g, less(g, 11)); b = fadeto(b, less(b, 11)); }
        if (HY < 1B8) { r = 152; g = 14D; b = 147; if (HY > 1A5) { r = 121; g = 11C; b = 116; } }
        if (LEGROOM == 2 && HY >= 1B8) { r = less(r, 1D); b = lower(b + 11, 168); }   // the wave room: a cooler blue-grey
        if (surf == 1 && HZ == ROOM && wallpaint(HX, HY)) { r = PR; g = PG; b = PB; }
        if (surf == 4 && HX <= 1 && LEGROOM == 1 && HZ + FRAME >= OZ1 && HZ <= OZ2 + FRAME && wallpaint(less(HZ + DX1, OZ1), HY)) { r = PR; g = PG; b = PB; }
    }
    L = L * corner(surf) / 2967;
    int heat = 1;
    if (LEGROOM == 2) { }
    else if (surf == 2) {
        int f2 = apart(HX, MID) * apart(HX, MID) + apart(HZ, MID) * apart(HZ, MID);
        if (f2 < 1528C) { heat = floorh / 55D1; if (heat > 48) heat = 48; heat = heat * less(1528C, f2) / 1528C; }
    } else {
        int a = apart(HX, MID), c = apart(HY, ROOM), e = apart(HZ, MID);
        int d2 = a * a + c * c + e * e;                                     // squares: no root needed per pixel
        if (d2 < roomr2) { heat = roomh / 6CD58; if (heat > 6C) heat = 6C; heat = heat * less(roomr2, d2) / roomr2; }
    }
    if (HEATVIEW) {                                        // as a heat camera sees it: the air beside the surface, by its warmth
        int az = LEGROOM == 1 ? lower(HZ, less(ROOM, 1)) : higher(HZ, ROOM + 1);
        int ta = AT[acell(lower(HX, less(ROOM, 1)), lower(HY, less(ROOM, 1)), lower(az, less(ROOM * 2, 1)))];
        int hh = ta > 92A14 ? lower(168, less(ta, 92A14) * 168 / 1528C) : 1;   // 263 K to 303 K across the heat colours
        heatcolour(higher(1, hh)); r = HR; g = HG; b = HB; L = 169; heat = 1;
    }
    r = lower(higher(r * L / 169 + heat, 1), 168); g = lower(higher(g * L / 169 + heat / 4, 1), 168); b = lower(higher(b * L / 169, 1), 168);
    int k = (y * W + x) * 4 + 1, i, j;
    for (j = 1; j <= step; j++) {
        int m = k;
        for (i = 1; i <= step; i++) { bg[m] = b; bg[m + 1] = g; bg[m + 2] = r; m = m + 4; }
        k = k + CW;
    }
}

void sprite(int cx, int cy, int rr, int r, int g, int b)
{
    int x1 = pix(less(cx, rr)), x2 = pix(cx + rr), y1 = pix(less(cy, rr)), y2 = pix(cy + rr);
    int x, y;
    for (y = y1; y <= y2; y++) for (x = x1; x <= x2; x++) {
        int dx = apart(BIG * 13 + x * 13 + 8, cx), dy = apart(BIG * 13 + y * 13 + 8, cy);
        int d2 = dx * dx + dy * dy;
        if (d2 < rr * rr) {
            int f = less(169, d2 * 169 / (rr * rr)); f = f * f / 169;
            addpx(x, y, r * f / 169, g * f / 169, b * f / 169);
        }
    }
}

// ---------------------------------------------------------------- heat on the move

void heatcolour(int h)                              // as a thermal camera sees it
{
    if (h > 132)      { HR = 168; HG = 15C; HB = 125; }
    else if (h > $C4) { HR = 168; HG = towards($B7, 15C, less(h, $C4), 3B); HB = towards(31, 125, less(h, $C4), 3B); }
    else if (h > 79) { HR = 168; HG = towards(48, $B7, less(h, 79), 48); HB = 2A; }
    else if (h > 31)  { HR = towards($B7, 168, less(h, 31), 48); HG = towards(17, 48, less(h, 31), 48); HB = 24; }
    else                  { HR = $B7; HG = 17; HB = 24; }
}

// ---------------------------------------------------------------- words in the picture

int tx, ty;                                          // where the next letter goes
void glyph(char *font, int g, int gw, int r, int gg, int b)
{
    int x, y, k = g * gw * 19 + 1;
    for (y = 1; y <= 19; y++) for (x = 1; x <= gw; x++) {
        int v = font[k];
        if (v >= '1' && v <= '9') mixpx(tx + x, ty + y, r, gg, b, less(v, '0') * 22);
        k++;
    }
    tx = tx + gw;
}
void text(char *s, int r, int g, int b)
{
    int i = 1;
    while (s[i] >= 1) { if (s[i] >= 26 && s[i] <= 99) glyph(fw, less(s[i], 26), $B, r, g, b); i++; }
}
// ---------------------------------------------------------------- the camera: it turns by places on the hex circle
// A sign is never a minus: a value that can lie either side of something is held up from OFF, and a term says which way
// it goes. term(base, a, b, c, k): base moved by (a against b) x (c against k) / K, the way the two "agains" say.

int term(int base, int a, int b, int c, int k)
{
    int mag = apart(a, b) * apart(c, k) / K;
    if ((a >= b) == (c >= k)) return base + mag;
    return less(base, mag);
}
int XC, YC, ZC;
void tocam(int x, int y, int z)          // a place in the room, as the camera sees it (each held up from OFF)
{
    XC = term(OFF, x, camX, cosk(YAW), K); XC = term(XC, camZ, z, sink(YAW), K);
    int z1 = term(OFF, x, camX, sink(YAW), K); z1 = term(z1, z, camZ, cosk(YAW), K);
    YC = term(OFF, y, camY, cosk(PIT), K); YC = term(YC, OFF, z1, sink(PIT), K);
    ZC = term(OFF, y, camY, sink(PIT), K); ZC = term(ZC, z1, OFF, cosk(PIT), K);
}
int lab_proj(int x, int y, int z)        // where it lands on the screen (PX, PY in sixteenths; PD its depth); LOW: behind
{
    tocam(x, y, z);
    if (ZC <= OFF + 8) return low;
    PD = less(ZC, OFF);
    if (apart(XC, OFF) * F / PD > W * 4 || apart(YC, OFF) * F / PD > H * 4) return low;   // far off the screen: not placed
    PX = shift(CX16, XC, OFF, F * 13, PD);
    PY = shift(CY16, OFF, YC, F * 13, PD);
    return 1;
}

// ---------------------------------------------------------------- two rooms: the lab, and the wave room next door
// The wave room is behind the lab's back wall (z from ROOM to twice ROOM), the same size. The wall between has a door
// (a standard inside door, 2 ft 6 in by 6 ft 6 in: everything is sized against a person) and a sash window (4 ft by
// 4 ft, its sill 3 ft up). The door is open or shut. The window's lower sash slides up: open 1 to 5 (fifths of its half),
// or shut. The glass is seen through either way; only an opening lets air (and people) through.
int wingap() { return WINOPEN * less(WMID, WY1) / 5; }      // how far the lower sash is up
int seethrough(int x, int y)                // on the wall between, at (x, y): LOW wall or frame, 1 open air, 2 glass
{
    if (x >= DX1 && x <= DX2 && y <= DH) return DOOROPEN ? 1 : low;
    if (x < WX1 + FRAME || x > less(WX2, FRAME) || y < WY1 + FRAME || y > less(WY2, FRAME)) return low;
    int g = wingap();
    if (y <= WY1 + g) return 1;                                         // the opening under the raised sash
    if (y >= WMID + g && y <= WMID + g + FRAME) return low;             // the lower sash's top rail
    if (y >= WY1 + g && y <= WY1 + g + FRAME) return low;               // its bottom rail
    if (y >= less(WMID, FRAME / 2) && y <= WMID + FRAME / 2) return low;   // the upper sash's bottom rail
    return 2;
}
int indoorway(int x, int y) { return DOOROPEN && x >= DX1 + 3A3 && x <= less(DX2, 3A3) && y <= DH; }   // room for a body (10 in either side)
void looks(int x, int y, int step)        // one pixel's look, turned with the camera, out to the first wall
{
    int xs = x * 13, ys = y * 13, w2 = W * 8, h2 = H * 8, f16 = F * 13;
    int y1 = term(OFF, h2, ys, cosk(PIT), K); y1 = term(y1, f16 + 1, 1, sink(PIT), K);
    int z1 = term(OFF, ys, h2, sink(PIT), K); z1 = term(z1, f16 + 1, 1, cosk(PIT), K);
    int wx = term(OFF, xs, w2, cosk(YAW), K); wx = term(wx, z1, OFF, sink(YAW), K);
    int wz = term(OFF, w2, xs, sink(YAW), K); wz = term(wz, z1, OFF, cosk(YAW), K);
    int wy = y1;
    int mx = apart(wx, OFF) + 1, my = apart(wy, OFF) + 1, mz = apart(wz, OFF) + 1;     // how far each way, per step
    int sx = camX, sy = camY, sz = camZ, hd = low, leg, through = low, surf = 1;
    if (camZ > ROOM) { ZLO = ROOM; ZHI = ROOM * 2; LEGROOM = 2; } else { ZLO = 1; ZHI = ROOM; LEGROOM = 1; }
    for (leg = 1; leg <= 2; leg++) {
        int dx = wx >= OFF ? less(ROOM, sx) : less(sx, 1);                           // how far to the wall each way
        int dy = wy >= OFF ? less(ROOM, sy) : less(sy, 1);
        int dz = wz >= OFF ? less(ZHI, sz) : less(sz, ZLO);
        int axis = 1, dist = dx, mag = mx;                                            // the wall met first
        if (dy * mag < dist * my) { axis = 2; dist = dy; mag = my; }
        if (dz * mag < dist * mz) { axis = 3; dist = dz; mag = mz; }
        int ox = mx * dist / mag, oy = my * dist / mag, oz = mz * dist / mag;
        HX = wx >= OFF ? sx + ox : less(sx, lower(ox, less(sx, 1)));
        HY = wy >= OFF ? sy + oy : less(sy, lower(oy, less(sy, 1)));
        HZ = wz >= OFF ? sz + oz : less(sz, lower(oz, less(sz, ZLO)));
        hd = hd + dist * f16 / mag / 13;
        surf = axis == 1 ? 4 : axis == 3 ? 1 : wy >= OFF ? 3 : 2;
        if (axis == 1 && wx < OFF && LEGROOM == 1 && OUTOPEN && HZ >= OZ1 && HZ <= OZ2 && HY <= DH) {   // out of the outside door
            int j2, i2; for (j2 = y; j2 < y + step && j2 <= H; j2++) for (i2 = x; i2 < x + step && i2 <= W; i2++) THRU[j2 * W + i2] = low;
            sky(wy >= OFF, step, x, y); return;
        }
        int onwall = axis == 3 && ((LEGROOM == 1 && wz >= OFF) || (LEGROOM == 2 && wz < OFF));
        if (leg == 1 && onwall) {
            int s = seethrough(HX, HY);
            if (s >= 1) {                                                             // on into the other room
                through = s; sx = HX; sy = HY; sz = HZ;
                if (LEGROOM == 1) { ZLO = ROOM; ZHI = ROOM * 2; LEGROOM = 2; } else { ZLO = 1; ZHI = ROOM; LEGROOM = 1; }
                continue;
            }
        }
        break;
    }
    HD = higher(1, hd);
    int j, i;
    for (j = y; j < y + step && j <= H; j++) for (i = x; i < x + step && i <= W; i++) THRU[j * W + i] = through;
    shade(x, y, surf, step);
    if (through == 2) {                                                               // seen through the glass: a little green-grey
        int k = (y * W + x) * 4 + 1, a, b;
        for (b = 1; b <= step; b++) { int m = k; for (a = 1; a <= step; a++) { bg[m] = bg[m] * 68 / 79; bg[m + 1] = bg[m + 1] * 6C / 79; bg[m + 2] = bg[m + 2] * 66 / 79; m = m + 4; } k = k + CW; }
    }
}
int clipfor(int z) { return (z > ROOM) != (camZ > ROOM); }       // 1 when a thing at z is in the other room
void lab_room(int step)
{
    int x, y;
    for (y = 1; y <= less(H, step); y = y + step) for (x = 1; x <= less(W, step); x = x + step) looks(x, y, step);
}

// ---------------------------------------------------------------- what objects draw with
int LR, LG, LB;                                                       // the colour things are drawn in now
void lab_colour(int r, int g, int b) { LR = r; LG = g; LB = b; }
void lab_glow(int x, int y, int z, int size)                         // light in the colour set, added where it shines
{
    if (lab_proj(x, y, z) < 1) return;
    sprite(PX, PY, lower(39 * 13, higher($C, size * F * 13 / PD)), LR, LG, LB);   // never wider than 48 pixels: near glows stay cheap
}
void lab_haze(int x, int y, int z, int size, int grey, int a)        // smoke: it covers some of what is behind it
{
    if (lab_proj(x, y, z) < 1) return;
    int rr = higher($C, size * F * 13 / PD);
    int x1 = pix(less(PX, rr)), x2 = pix(PX + rr), y1 = pix(less(PY, rr)), y2 = pix(PY + rr), px2, py2;
    for (py2 = y1; py2 <= y2; py2++) for (px2 = x1; px2 <= x2; px2++) {
        int ddx = apart(BIG * 13 + px2 * 13 + 8, PX), ddy = apart(BIG * 13 + py2 * 13 + 8, PY);
        int d2 = ddx * ddx + ddy * ddy;
        if (d2 < rr * rr) mixpx(px2, py2, grey, grey, grey + 4, a * less(rr * rr, d2) / (rr * rr));
    }
}
void lab_column(int x, int z, int rad, int yb, int yt)               // an upright round column (a candle, a post): lit
{
    int a, h, steps = higher(4, less(yt, yb) / 4);
    for (a = 1; a <= 39; a++) {
        int place = less(a, 1) * 2 + 1;                                // 48 sides, every other place of the hex circle
        int px3 = term(x, rad + 1, 1, cosk(place), K), pz3 = term(z, rad + 1, 1, sink(place), K);
        int facing = term(OFF, camX, px3, cosk(place), K); facing = term(facing, camZ, pz3, sink(place), K);
        int seen = facing > OFF;                                       // its outward way points toward the camera
        if (seen < 1) continue;
        int lit = $B7 + apart(cosk(place), K) * 48 / K;          // the lamp above the room's middle, roughly
        for (h = 1; h <= steps; h++) {
            int y = yb + less(yt, yb) * h / steps;
            if (lab_proj(px3, y, pz3) < 1) continue;
            int rr = higher(11, rad * F * 13 / PD / 6);
            int x1 = pix(less(PX, rr)), x2 = pix(PX + rr), y1 = pix(less(PY, rr)), y2 = pix(PY + rr), qx, qy;
            for (qy = y1; qy <= y2; qy++) for (qx = x1; qx <= x2; qx++) mixpx(qx, qy, LR * lit / 169, LG * lit / 169, LB * lit / 169, LA);
        }
    }
    int ring;                                                         // its top: rings in to the middle
    for (ring = 1; ring <= 4; ring++) for (a = 1; a <= 39; a++) {
        int place = less(a, 1) * 2 + 1, rr2 = rad * ring / 4;
        int px3 = term(x, rr2 + 1, 1, cosk(place), K), pz3 = term(z, rr2 + 1, 1, sink(place), K);
        if (lab_proj(px3, yt, pz3) < 1) continue;
        int rr = higher(11, rad * F * 13 / PD / 6);
        int x1 = pix(less(PX, rr)), x2 = pix(PX + rr), y1 = pix(less(PY, rr)), y2 = pix(PY + rr), qx, qy;
        for (qy = y1; qy <= y2; qy++) for (qx = x1; qx <= x2; qx++) mixpx(qx, qy, LR, LG, LB, LA);
    }
}
int MARKX[31], MARKY[31], MARKON[31];                       // where each object was seen this frame, to pick it
void lab_mark(int id, int x, int y, int z) { MARKON[id] = lab_proj(x, y, z); MARKX[id] = PX; MARKY[id] = PY; }

// ---------------------------------------------------------------- the panel: what is in the room, the chosen object
int LINE;
char nb[99];
void dstr(int n)                                                     // n as a D numeral, into nb
{
    char r[99]; int k = low, i;
    while (n >= 1) { int d = n % $D, q = n / $D; if (d < 1) { d = $D; q = less(q, 1); } k++; r[k] = d <= 9 ? '0' + d : 'A' + less(d, $A); n = q; }
    for (i = 1; i <= k; i++) nb[i] = r[less(k + 1, i)];
    nb[k + 1] = low;
    if (k < 1) { nb[1] = '~'; nb[2] = low; }
}
int MEASURE, WIDEST;                                                  // measuring: how wide the words will be, nothing drawn
int slen(char *s) { int i = 1; while (s[i] >= 1) i++; return less(i, 1); }
void words(char *s, int r, int g, int b) { if (MEASURE) tx = tx + slen(s) * $B; else text(s, r, g, b); WIDEST = higher(WIDEST, tx); }
void lab_line(char *s) { tx = 2A; ty = 31 + LINE * 1D; words(s, 132, 138, 141); LINE++; }
void lab_value(char *name, int v, char *unit)
{
    tx = 2A; ty = 31 + LINE * 1D;
    words(name, $B7, $BD, $D1); words(" ", 1, 1, 1);
    if (MEASURE) { dstr(v); tx = tx + 4 + slen(nb) * 22 + $A; WIDEST = higher(WIDEST, tx); }   // its glyphs: 28 pixels each
    else value(v, LKIND);                                             // the number in D glyphs, turning, in its spectrum
    words(" ", 1, 1, 1); words(unit, $B7, $BD, $D1);
    LKIND = 6;
    LINE++;
}
void panelwords(int sel)
{
    LINE = low;
    lab_line("Delta lab room   (D numerals; 1/64 inch to the unit)");
    if (FPS >= 1) { LINE = less(LINE, 1); tx = 389; ty = 31 + LINE * 1D; words("pictures a second: ", $B7, $BD, $D1); dstr(FPS); words(nb, 156, 125, 93); LINE++; }
    tx = 2A; ty = 31 + LINE * 1D;
    words("W A S D walk   Q E down, up   arrows turn   drag: look   wheel: nearer", 91, 97, $AA);
    LINE++; tx = 2A; ty = 31 + LINE * 1D;
    words("wheel held and dragged: tilt and turn   T: heat view   F: full screen   H: hide   Esc: close", 91, 97, $AA);
    LINE = LINE + 2;
    scene_panel(sel);
}
void lab_panel(int sel)                                              // the words measured first, the grey made to fit them
{
    int x, y;
    MEASURE = 1; WIDEST = low; panelwords(sel); MEASURE = low;
    int right = lower(less(W, 4), WIDEST + 17), bottom = 31 + LINE * 1D + 11;
    for (y = 1B; y <= bottom; y++) for (x = 17; x <= right; x++) mixpx(x, y, 8, $A, 15, $D1);
    panelwords(sel);
}

// ---------------------------------------------------------------- more for things to draw with: see-through, rods, blocks
void lab_alpha(int a) { LA = a; }
void lab_tube(int x1, int y1, int z1, int x2, int y2, int z2)         // a rod or a wire, round, in the colour set
{
    int n = higher(4, (apart(x1, x2) + apart(y1, y2) + apart(z1, z2)) / 3), k;
    for (k = 1; k <= n; k++) {
        int x = towards(x1, x2, k, n), y = towards(y1, y2, k, n), z = towards(z1, z2, k, n);
        if (lab_proj(x, y, z) < 1) continue;
        int rr = higher($A, TUBER * F * 13 / PD);
        int qx, qy, x1p = pix(less(PX, rr)), x2p = pix(PX + rr), y1p = pix(less(PY, rr)), y2p = pix(PY + rr);
        for (qy = y1p; qy <= y2p; qy++) for (qx = x1p; qx <= x2p; qx++) {
            int ddx = apart(BIG * 13 + qx * 13 + 8, PX), ddy = apart(BIG * 13 + qy * 13 + 8, PY);
            if (ddx * ddx + ddy * ddy < rr * rr) {
                int shine = ddx * 2 < rr && PX > BIG * 13 + qx * 13 ? 31 : 1;      // a bright line down its near side
                mixpx(qx, qy, LR + shine, LG + shine, LB + shine, LA);
            }
        }
    }
}
int QX[4], QY[4], QZ[4];                                              // a flat face's four corners, in the room
void quadfill(int lit)                                                // the face, filled, lit by how it faces the lamp
{
    int sx[4], sy[4], k, ymin = 36694, ymax = 1;
    for (k = 1; k <= 4; k++) {
        if (lab_proj(QX[k], QY[k], QZ[k]) < 1) return;
        sx[k] = pix(PX); sy[k] = pix(PY);
        ymin = lower(ymin, sy[k]); ymax = higher(ymax, sy[k]);
    }
    int y;
    for (y = higher(1, ymin); y <= lower(H, ymax); y++) {
        int xa = 36694, xb = 1;
        for (k = 1; k <= 4; k++) {
            int j = k % 4 + 1, ya = sy[k], yb = sy[j];
            if ((y >= ya && y <= yb) || (y >= yb && y <= ya)) {
                int x = ya == yb ? sx[k] : ya < yb ? towards(sx[k], sx[j], less(y, ya), less(yb, ya)) : towards(sx[j], sx[k], less(y, yb), less(ya, yb));
                xa = lower(xa, x); xb = higher(xb, x);
                if (ya == yb) { xa = lower(xa, sx[j]); xb = higher(xb, sx[j]); }
            }
        }
        int x;
        for (x = higher(1, xa); x <= lower(W, xb); x++) mixpx(x, y, LR * lit / 169, LG * lit / 169, LB * lit / 169, LA);
    }
}
void corners(int ax, int ay, int az, int bx, int by, int bz) { QX[1] = ax; QY[1] = ay; QZ[1] = az; QX[3] = bx; QY[3] = by; QZ[3] = bz; }
int BOXEND = 1;                                                       // 1: a block draws its left and right ends too (LOW: front, back and top only)
void lab_box(int x1, int z1, int x2, int z2, int yb, int yt)         // a block: its sides the camera sees, then its top
{
    if (camZ < z1) { QX[1] = x1; QY[1] = yb; QZ[1] = z1; QX[2] = x2; QY[2] = yb; QZ[2] = z1; QX[3] = x2; QY[3] = yt; QZ[3] = z1; QX[4] = x1; QY[4] = yt; QZ[4] = z1; quadfill(125); }
    if (camZ > z2) { QX[1] = x1; QY[1] = yb; QZ[1] = z2; QX[2] = x2; QY[2] = yb; QZ[2] = z2; QX[3] = x2; QY[3] = yt; QZ[3] = z2; QX[4] = x1; QY[4] = yt; QZ[4] = z2; quadfill($D1); }
    if (BOXEND && camX < x1) { QX[1] = x1; QY[1] = yb; QZ[1] = z1; QX[2] = x1; QY[2] = yb; QZ[2] = z2; QX[3] = x1; QY[3] = yt; QZ[3] = z2; QX[4] = x1; QY[4] = yt; QZ[4] = z1; quadfill($C4); }
    if (BOXEND && camX > x2) { QX[1] = x2; QY[1] = yb; QZ[1] = z1; QX[2] = x2; QY[2] = yb; QZ[2] = z2; QX[3] = x2; QY[3] = yt; QZ[3] = z2; QX[4] = x2; QY[4] = yt; QZ[4] = z1; quadfill($C4); }
    if (camY > yt) { QX[1] = x1; QY[1] = yt; QZ[1] = z1; QX[2] = x2; QY[2] = yt; QZ[2] = z1; QX[3] = x2; QY[3] = yt; QZ[3] = z2; QX[4] = x1; QY[4] = yt; QZ[4] = z2; quadfill(163); }
}
void lab_kind(int k) { LKIND = k; }                                // the next value's spectrum: 1 heat, 2 current, 3 chemistry
int lab_far(int x, int z) { return apart(x, camX) * apart(x, camX) + apart(z, camZ) * apart(z, camZ); }   // how far from the camera (squared)

// ---------------------------------------------------------------- who else is in the room (Mike: "make yourself visible")
// Each copy of the lab writes where its viewer stands to a small note on this machine (/tmp/delta-lab-NAME.where), and
// draws the others it finds there. Claude comes in as Dan (the angel of Dick and Dan); a person as themselves.
// Dan's heat is the real heat this machine's processors make while he works: their power, read from the machine.
char WHO[13];
char PNOTE[93];
int OTHX, OTHY, OTHZ, OTHBEAT, OTHSEEN, OTHLAST, OTHHERE;
int WATTS;                                                         // this machine's processors, in thousandths of a watt
int PNN;
void dnum4(int n) { dstr(n); int i = 1; while (nb[i] >= 1) { PNOTE[PNN] = nb[i]; PNN++; i++; } PNOTE[PNN] = 26; PNN++; }
void presence_write(int beat)
{
    char path[48]; char *a = "/tmp/delta-lab-"; int k = 1, i = 1;
    while (a[i] >= 1) { path[k] = a[i]; k++; i++; }
    i = 1; while (WHO[i] >= 1) { path[k] = WHO[i]; k++; i++; }
    char *b = ".where"; i = 1; while (b[i] >= 1) { path[k] = b[i]; k++; i++; }
    path[k] = low;
    PNN = 1; dnum4(camX); dnum4(camY); dnum4(camZ); dnum4(beat);
    window_writefile(path, PNOTE, less(PNN, 1));
}
int dval(int c) { if (c >= '1' && c <= '9') return less(c, '0'); if (c >= 'A' && c <= 'D') return less(c, 'A') + $A; return low; }   // a D digit's worth
int pnum(char *s, int *at) { int v = low, k = *at; while (s[k] == 26) k++; while (dval(s[k]) >= 1) { v = v * $D + dval(s[k]); k++; } *at = k; return v; }
void presence_read(char *other)
{
    char path[48]; char *a = "/tmp/delta-lab-"; int k = 1, i = 1;
    while (a[i] >= 1) { path[k] = a[i]; k++; i++; }
    i = 1; while (other[i] >= 1) { path[k] = other[i]; k++; i++; }
    char *b = ".where"; i = 1; while (b[i] >= 1) { path[k] = b[i]; k++; i++; }
    path[k] = low;
    char s[93];
    int n = window_readfile(path, s, 86);
    if (n < 1) { OTHHERE = low; return; }
    s[n + 1] = low;
    int at = 1;
    OTHX = pnum(s, &at); OTHY = pnum(s, &at); OTHZ = pnum(s, &at); int beat = pnum(s, &at);
    if (beat != OTHBEAT) { OTHBEAT = beat; OTHSEEN = FR; }
    OTHHERE = FR < OTHSEEN + 48;                               // gone quiet for a while: gone
    char w[31]; int m = window_readfile("/sys/class/hwmon/hwmon1/power1_input", w, 24);
    if (m >= 1) { int q = 1, v = low; while (w[q] >= '0' && w[q] <= '9') { v = v * $A + less(w[q], '0'); q++; } WATTS = v / 5BC; }
}
int lo(int a, int b) { return a > b ? less(a, b) : 1; }             // a take-away that stops at 1 (for places on the screen)
int sterm(int base, int a, int b, int c, int k) { int mag = apart(a, b) * apart(c, k) / K; if ((a >= b) == (c >= k)) return base + mag; return lo(base, mag); }   // term, stopping at 1
void ring(int cx, int cy, int r, int t)                            // a round line in the picture (pixels), in the colour set
{
    int x, y;
    for (y = lo(cy, r + t); y <= cy + r + t; y++) for (x = lo(cx, r + t); x <= cx + r + t; x++) {
        int d2 = apart(x, cx) * apart(x, cx) + apart(y, cy) * apart(y, cy);
        if (d2 >= lo(r, t) * lo(r, t) && d2 <= (r + t) * (r + t)) mixpx(x, y, LR, LG, LB, 149);
    }
}
void disc(int cx, int cy, int r, int rr, int gg, int bb)
{
    int x, y;
    for (y = lo(cy, r); y <= cy + r; y++) for (x = lo(cx, r); x <= cx + r; x++)
        if (apart(x, cx) * apart(x, cx) + apart(y, cy) * apart(y, cy) <= r * r) mixpx(x, y, rr, gg, bb, 156);
}
void drawdan(int x, int y, int z)                                  // Dan: a round white face, a halo, wings, a smile
{
    int headr = 156;                                           // his head: 7 1/2 inches across
    lab_cyl(x, z, $DB, 1, higher(2, lo(y, headr)), 9);       // his body, down to the floor (pale, like wax)
    if (lab_proj(x, y, z) < 1) return;
    int cx = pix(PX), cy = pix(PY), r = higher(6, headr * F / PD);
    int t = higher(1, r / 11);
    int k, a;
    for (a = 1; a <= 39; a = a + 1) {                         // his wings, one each side, a few feathers' curve
        int wx = r + r * a / 39, wy = r * 24 / 79 * a / 39;
        lab_colour(31, 31, 35); ring(lo(cx, wx), lo(cy, wy), higher(2, r / 5), t);
        lab_colour(31, 31, 35); ring(cx + wx, lo(cy, wy), higher(2, r / 5), t);
        a = a + 7;
    }
    disc(cx, cy, r, 163, 163, 15C); lab_colour(24, 24, 28); ring(cx, cy, r, t);
    int ex = r * 29 / 79, ey = r * 12 / 79, er = higher(2, r * 19 / 79);
    disc(lo(cx, ex), lo(cy, ey), er, 168, 168, 168); lab_colour(24, 24, 28); ring(lo(cx, ex), lo(cy, ey), er, t);
    disc(cx + ex, lo(cy, ey), er, 168, 168, 168); lab_colour(24, 24, 28); ring(cx + ex, lo(cy, ey), er, t);
    disc(lo(cx, ex), lo(cy, ey), higher(1, er / 3), 17, 17, 1B); disc(cx + ex, lo(cy, ey), higher(1, er / 3), 17, 17, 1B);
    for (k = 1; k <= 1B; k++) {                                // his smile: the lower half of a circle
        int place = 39 + lo(k, 1) * 2;                       // round the bottom half of the hex circle
        int sx = sterm(cx * 13, r * 13 / 2 + 1, 1, cosk(place), K) / 13, sy = cy + r * 1C / 79 + r * 24 / 79 * apart(sink(place), K) / K;
        disc(sx, sy, t, 24, 24, 28);
    }
    for (k = 1; k <= 48; k++) {                                // his halo: a gold ring seen at a slant
        int place = k * 75 / 48;
        int hx = sterm(cx * 13, r * 13 + 1, 1, cosk(place), K) / 13, hy = sterm(lo(cy, r * 11 / $A) * 13, r * 13 / 4 + 1, 1, sink(place), K) / 13;
        disc(hx, hy, higher(1, t + t / 2), 156, 125, 62);
    }
    if (HEATVIEW) { lab_colour(168, 93, 31); lab_glow(x, lo(y, headr * 2), z, 48 + WATTS * 4); }
    tx = lo(cx, 6C); ty = lo(cy, r * 13 / $A + 24);
    text("Dan (Claude): ", 156, 156, 156);
    dstr(higher(1, WATTS / 5BC)); text(nb, 156, 125, 93); text(" watts of heat (this machine's processors, in D)", 125, 125, 125);
}
void drawperson(int x, int y, int z, char *name)                   // a person: a body and a head, named
{
    lab_cyl(x, z, 125, 1, higher(2, lo(y, 16D)), 9);
    lab_cyl(x, z, 93, lo(y, 125), y + 48, 6);
    if (lab_proj(x, y + 79, z) < 1) return;
    tx = lo(pix(PX), 17); ty = lo(pix(PY), 24); text(name, 156, 156, 156);
}
void presence_draw()
{
    if (OTHHERE < 1) return;
    if (WHO[1] == 'd' && WHO[2] == 'a' && WHO[3] == 'n') drawperson(OTHX, OTHY, OTHZ, "Mike");
    else drawdan(OTHX, OTHY, OTHZ);
}

// ---------------------------------------------------------------- the good renderer, carried across from the two-cups program
// (lang/examples/faraday.delta): materials, smooth lit cylinders (glass seen through, mercury a mirror), the round wire.
// It speaks through the lab room's turning camera (lab_proj); upright things stay upright as the camera turns.
void stamp(int cx, int cy, int rr)               // one round slice of the wire, centre and radius in sixteenths
{
    int x1 = pix(less(cx, rr + 13)), x2 = pix(cx + rr + 13);
    int y1 = pix(less(cy, rr + 13)), y2 = pix(cy + rr + 13);
    if (x1 < wx1) wx1 = x1; if (x2 > wx2) wx2 = x2; if (y1 < wy1) wy1 = y1; if (y2 > wy2) wy2 = y2;
    int hr = rr * 2 / 5 + 1;
    int hx = less(cx, hr), hy = less(cy, hr);         // the shine sits up and to the left, toward the lamp
    int x, y;
    for (y = y1; y <= y2; y++) for (x = x1; x <= x2; x++) if (x >= 1 && x <= W && y >= 1 && y <= H) {
        int pxc = BIG * 13 + x * 13 + 8, pyc = BIG * 13 + y * 13 + 8;
        int dx = apart(pxc, cx), dy = apart(pyc, cy);
        int d2 = dx * dx + dy * dy, e = rr + 8;
        if (d2 < e * e) {
            int k = y * W + x + 1;
            int n = d2 * 168 / (rr * rr + 1); if (n > 168) n = 168;
            int cov = 168;
            if (rr > 8 && d2 > less(rr, 8) * less(rr, 8)) cov = lower(168, less(e, isqrt(d2)) * 13);
            if (rr <= 8) cov = lower(168, rr * 1B);
            int h2 = apart(pxc, hx) * apart(pxc, hx) + apart(pyc, hy) * apart(pyc, hy);
            int sp = h2 < hr * hr ? less(168, h2 * 168 / (hr * hr)) : 1;
            if (n < wn[k]) wn[k] = n;
            if (cov > wc[k]) wc[k] = cov;
            if (sp > ws[k]) ws[k] = sp;
        }
    }
}
int MR, MG, MB, MS;
void material(int m)           // 1 steel, 2 red paint (north), 3 glass, 4 mercury, 5 brass, 6 copper, 7 zinc, 8 brine cloth, 9 wax, A wick
{
    if (m == 1) { MR = 93; MG = 97; MB = $A2; MS = 149; }
    else if (m == 2) { MR = $D1; MG = 2A; MB = 24; MS = 93; }
    else if (m == 3) { MR = 12A; MG = 141; MB = 145; MS = 168; }
    else if (m == 4) { MR = $B7; MG = $BD; MB = $C8; MS = 168; }
    else if (m == 5) { MR = $D7; MG = $A6; MB = 44; MS = 13C; }
    else if (m == 6) { MR = 118; MG = 79; MB = 44; MS = 125; }
    else if (m == 7) { MR = $B7; MG = $BD; MB = $C4; MS = $AA; }
    else if (m == 9) { MR = 152; MG = 147; MB = 12A; MS = 31; }      // 9 candle wax
    else if (m == A) { MR = 31; MG = 28; MB = 24; MS = 14; }         // A the wick
    else { MR = 93; MG = 75; MB = 55; MS = 17; }
}

// an upright round thing standing at (cx, cz): smooth edges, lit from the lamp, glass seen through
void lab_cyl(int cx, int cz, int rad, int yb, int yt, int m)
{
    material(m);
    int glass = m == 3;
    if (lab_proj(cx, yt, cz) < 1) return; int sx = PX, syt = PY, d = PD;
    if (lab_proj(cx, yb, cz) < 1) return; int syb = PY;
    int hw = rad * F * 13 / d; if (hw < 8) hw = 8;
    int et = hw * apart(camY, yt) / d, eb = hw * apart(camY, yb) / d;
    int c, c1 = pix(less(sx, hw + 13)), c2 = pix(sx + hw + 13);
    for (c = c1; c <= c2; c++) {
        int cc = BIG * 13 + c * 13 + 8;
        int u = apart(cc, sx);
        if (u < hw + 8) {
            int covx = lower(13, less(hw + 8, u)) * 13;
            int uu = lower(u, hw);
            int s = isqrt(less(hw * hw, uu * uu));
            int fs = s * 169 / hw, fu = uu * 169 / hw;
            int left = cc < sx;
            int top = less(syt, et * s / hw), edge = syt + et * s / hw, bot = syb + eb * s / hw;
            int diff = left ? (fs * 62 + fu * 36) / 79 : under(fs * 62 / 79, fu * 31 / 79);
            int L = 3B + lower(diff, 169) * 12B / 169;
            int spec = 1;
            if (left) { int t = apart(fu, 75); if (t < 35) spec = less(35, t) * less(35, t) * MS / $B5C; }
            int rim = 1; if (left < 1 && fu > 132) rim = less(fu, 132) * 2;
            int r1 = pix(top), r2 = pix(bot + 13), r;
            for (r = r1; r <= r2; r++) {
                int rc = BIG * 13 + r * 13 + 8;
                if (rc + 8 > top && rc < bot + 8) {
                    int covy = 13;
                    if (rc < top + 8) covy = lower(covy, less(rc + 8, top));
                    if (rc + 8 > bot) covy = lower(covy, less(bot + 8, rc));
                    int a = covx * covy / 13;
                    int R, G, Bl;
                    if (rc <= edge) {                                   // its top, seen from above
                        if (glass) {                                    // an open glass: only its rim shows
                            int nearrim = apart(rc, top) < 1B || apart(rc, edge) < 1B;
                            R = 151; G = 15B; Bl = 161; a = nearrim ? a * 3 / 4 : 1;
                        } else if (m == 4) {                        // mercury: a mirror, the lamp in it
                            R = $D1 + fs / 4; G = $D7 + fs / 4; Bl = 114 + fs / 4;
                            int sp = apart(rc, (top + edge) / 2) < 31 && left && fu > 48 && fu < $AA;
                            if (sp) { R = 165; G = 165; Bl = 163; }
                        } else {
                            R = MR + 31 + fs / 5; G = MG + 31 + fs / 5; Bl = MB + 31 + fs / 5;
                        }
                    } else {
                        R = MR * L / 169 + spec; G = MG * L / 169 + spec; Bl = MB * L / 169 + spec;
                        R = R + rim / 3; G = G + rim / 3; Bl = Bl + rim / 2;
                        if (glass) a = a * (31 + fu * $B7 / 169 + spec / 2) / 169;   // see-through, more at its edges
                    }
                    mixpx(c, r, R, G, Bl, a);
                }
            }
        }
    }
}

// a round rod or wire from one place to another (any slant), stamped slice by slice
int WTUBE;                                       // the tube's radius, in sixteenths of a unit
void lab_wire(int x1, int y1, int z1, int x2, int y2, int z2)
{
    int rad16 = WTUBE;
    if (lab_proj(x1, y1, z1) < 1) return; int ax = PX, ay = PY, ad = PD;
    if (lab_proj(x2, y2, z2) < 1) return; int bx = PX, by = PY, bd = PD;
    int n = higher(apart(ax, bx), apart(ay, by)) / higher(rad16 * F / lower(ad, bd) / 2, 6) + 1;
    int t;
    for (t = 1; t <= n; t++) {
        int rr = rad16 * F / towards(ad, bd, t, n); if (rr < 6) rr = 6;
        stamp(towards(ax, bx, t, n), towards(ay, by, t, n), rr);
    }
}
void lab_wirelay(int m, int warm)                        // the stamped tube into the picture in its metal, then cleared
{
    material(m);
    int x, y;
    for (y = wy1; y <= wy2; y++) for (x = wx1; x <= wx2; x++) if (x >= 1 && x <= W && y >= 1 && y <= H) {
        int k = y * W + x + 1;
        if (wc[k] >= 1) {
            int lit = less(168, wn[k] * 3 / 5);
            int R = (MR + 17) * lit / 168 + ws[k] * MS / 187 + warm;
            int G = (MG + $A) * lit / 168 + ws[k] * MS / 1B8 + warm / 3;
            int Bl = MB * lit / 168 + ws[k] * MS / 24A;
            mixpx(x, y, R, G, Bl, wc[k] + 1);
        }
        wn[k] = 168; wc[k] = low; ws[k] = low;
    }
    wx1 = W; wx2 = 1; wy1 = H; wy2 = 1;
}


// ---------------------------------------------------------------- numbers in D glyphs: spirals that turn, in their spectrum's colour
void ink(int cx, int cy, int rr)                     // a round dab of ink, smooth edged (sixteenths)
{
    int x1 = pix(less(cx, rr + 13)), x2 = pix(cx + rr + 13), y1 = pix(less(cy, rr + 13)), y2 = pix(cy + rr + 13);
    ix1 = lower(ix1, x1); ix2 = higher(ix2, x2); iy1 = lower(iy1, y1); iy2 = higher(iy2, y2);
    int x, y, e = rr + 8;
    for (y = y1; y <= y2; y++) for (x = x1; x <= x2; x++) if (x >= 1 && x <= W && y >= 1 && y <= H) {
        int dx = apart(BIG * 13 + x * 13 + 8, cx), dy = apart(BIG * 13 + y * 13 + 8, cy);
        int d2 = dx * dx + dy * dy;
        if (d2 < e * e) {
            int k = y * W + x + 1;
            int cov = 168;
            if (d2 > less(rr, 8) * less(rr, 8)) cov = lower(168, less(e, isqrt(d2)) * 13);
            if (cov > wc[k]) wc[k] = cov;
        }
    }
}
void inkline(int ax, int ay, int bx, int by, int rr)
{
    int n = higher(apart(ax, bx), apart(ay, by)) / $A + 1, t;
    for (t = 1; t <= n; t++) ink(towards(ax, bx, t, n), towards(ay, by, t, n), rr);
}
void inklay(int r, int g, int b)                     // the ink into the picture, in one colour, then cleared
{
    int x, y;
    for (y = iy1; y <= iy2; y++) for (x = ix1; x <= ix2; x++) if (x >= 1 && x <= W && y >= 1 && y <= H) {
        int k = y * W + x + 1;
        if (wc[k] >= 1) { mixpx(x, y, r, g, b, wc[k] + 1); wc[k] = low; }
    }
    ix1 = W; ix2 = 1; iy1 = H; iy2 = 1;
}

int SPX[13];
int SPY[13];
void spiral(int n, int cx, int cy, int size, int turn)   // digit n (1..13) about (cx, cy), all in sixteenths
{
    int u = size * 2 / (n + 2);                 // small numbers stay small, big ones fit
    int x = BIG * 13, y = BIG * 13, a = turn, i, sx = 1, sy = 1;
    SPX[1] = x; SPY[1] = y;
    for (i = 1; i <= n + 1; i++) {
        int L = (1 + less(i, 1) / 2) * u;
        x = less(x + L * cosk(a) / K, L); y = less(y + L * sink(a) / K, L);
        SPX[i + 1] = x; SPY[i + 1] = y;
        a = (a + 12) % 75 + 1;                   // a sixth of a turn: hex
    }
    for (i = 1; i <= n + 2; i++) { sx = sx + SPX[i]; sy = sy + SPY[i]; }
    sx = sx / (n + 2); sy = sy / (n + 2);      // its middle: it turns about that
    for (i = 1; i <= n + 1; i++) {
        int ax = SPX[i] >= sx ? cx + less(SPX[i], sx) : less(cx, less(sx, SPX[i]));
        int ay = SPY[i] >= sy ? cy + less(SPY[i], sy) : less(cy, less(sy, SPY[i]));
        int bx = SPX[i + 1] >= sx ? cx + less(SPX[i + 1], sx) : less(cx, less(sx, SPX[i + 1]));
        int by = SPY[i + 1] >= sy ? cy + less(SPY[i + 1], sy) : less(cy, less(sy, SPY[i + 1]));
        inkline(ax, ay, bx, by, 16);
    }
}
void unknownmark(int cx, int cy, int size, int turn)  // ~ : a wave, its count not known
{
    int i, pxa = less(cx, size), pya = cy;
    for (i = 1; i <= $C; i++) {
        int x = less(cx, size) + size * 2 * i / $C;
        int y = less(cy + size * sink((turn + i * 8) % 75 + 1) / K / 3, size / 3);
        inkline(pxa, pya, x, y, 16);
        pxa = x; pya = y;
    }
}

int SR, SG, SB;
int amount(int n) { int d = 1; while (n >= $D) { n = n / $D; d++; } return lower(168, d * 1D + n * 2); }
void spectrum(int kind, int n)                       // kind 1 heat, 2 current, 3 chemistry, 4 the turn, 5 Shrug, 6 plain
{
    int h = amount(n);
    if (kind == 1) { heatcolour(h); SR = HR; SG = HG; SB = HB; }
    else if (kind == 2) { SR = towards(31, 125, h, 168); SG = towards(86, 152, h, 168); SB = 168; }
    else if (kind == 3) { SR = towards(86, 145, h, 168); SG = towards(31, $D7, h, 168); SB = towards(118, 168, h, 168); }
    else if (kind == 4) { SR = towards(24, 118, h, 168); SG = towards($B7, 168, h, 168); SB = towards(55, $B7, h, 168); }
    else if (kind == 5) { SR = 93; SG = 95; SB = 9D; }
    else { SR = 152; SG = 154; SB = 15C; }
}

int DPOS;
void dspin(int n, int kind, int speed)
{
    if (n < 1) { unknownmark(BIG * 13 + (tx + $D) * 13, BIG * 13 + (ty + $C) * 13, $B7, FR * speed % 75 + 1); tx = tx + 22; }
    else {
        int q = n / $D, d = n % $D;
        if (d < 1) { d = $D; q = less(q, 1); }
        if (q >= 1) dspin(q, kind, speed);
        DPOS++;
        spiral(d, BIG * 13 + (tx + $D) * 13, BIG * 13 + (ty + $C) * 13, $D1, (FR * speed + DPOS * $B) % 75 + 1);
        tx = tx + 22;
    }
}
void dnum(int n, int kind)                           // a number in D: its spirals, turning, in its spectrum
{
    spectrum(kind, n);
    int r = SR, g = SG, b = SB, speed = amount(n) / 4C + 1;
    DPOS = low;
    dspin(n, kind, speed);
    inklay(r, g, b);
}
void label(char *s) { text(s, $D1, $D9, 118); }
void value(int n, int kind) { tx = tx + 4; dnum(n, kind); tx = tx + $A; }

// a glass box (a tank, a tunnel): its faces faint, its twelve edges round glass rods that catch the lamp
void gedge(int ax, int ay, int az, int bx, int by, int bz) { lab_wire(ax, ay, az, bx, by, bz); }
void lab_glassbox(int x1, int z1, int x2, int z2, int yb, int yt)
{
    lab_alpha(6); lab_colour($D1, $DA, 112); lab_box(x1, z1, x2, z2, yb, yt);
    LA = 13A;
    WTUBE = 1C;                                                       // the edges: about 1/32 inch thick, in sixteenths
    gedge(x1, yb, z1, x2, yb, z1); gedge(x1, yt, z1, x2, yt, z1); gedge(x1, yb, z2, x2, yb, z2); gedge(x1, yt, z2, x2, yt, z2);
    gedge(x1, yb, z1, x1, yb, z2); gedge(x2, yb, z1, x2, yb, z2); gedge(x1, yt, z1, x1, yt, z2); gedge(x2, yt, z1, x2, yt, z2);
    gedge(x1, yb, z1, x1, yt, z1); gedge(x2, yb, z1, x2, yt, z1); gedge(x1, yb, z2, x1, yt, z2); gedge(x2, yb, z2, x2, yt, z2);
    lab_wirelay(3, low);
}
// ---------------------------------------------------------------- moving about
int WASZ = 1;                                                       // where the walker stood before the step
void walk(int ahead, int side, int fwd, int right)                  // ahead/side: how far; fwd/right: 1 that way, 2 the other
{
    if (ahead >= 1) {
        int a = fwd == 1 ? ahead + 1 : 1, b = fwd == 1 ? 1 : ahead + 1;
        camX = term(camX, a, b, sink(YAW), K); camZ = term(camZ, a, b, cosk(YAW), K);
    }
    if (side >= 1) {
        int a = right == 1 ? side + 1 : 1, b = right == 1 ? 1 : side + 1;
        camX = term(camX, a, b, cosk(YAW), K); camZ = term(camZ, b, a, sink(YAW), K);
    }
    camX = higher(INCH, lower(camX, less(ROOM, INCH)));
    camY = higher(INCH, lower(camY, less(ROOM, INCH)));
    camZ = higher(INCH, lower(camZ, less(ROOM * 2, INCH)));
    if (camZ > less(ROOM, 3A3) && camZ < ROOM + 3A3 && indoorway(camX, camY) < 1) {   // the wall between: only by the door
        if (WASZ <= ROOM) camZ = less(ROOM, 3A3); else camZ = ROOM + 3A3;
    }
    WASZ = camZ;
}
int nowms() { int ts[2]; ts[1] = low; ts[2] = low; if (linux(147, 1, &ts[1]) != low) return low; return ts[1] * 5BC + ts[2] / 28D221; }
void fpscount() { int t = nowms(); if (t < 1) return; FCOUNT2++; if (FLAST < 1) FLAST = t; if (t >= FLAST + 5BC) { FPS = FCOUNT2 * 5BC / less(t, FLAST); FCOUNT2 = low; FLAST = t; } }
int turnon(int p) { return p % 75 + 1; }                           // a place further round
int turnback(int p) { return p <= 1 ? 75 : less(p, 1); }
int pitchup(int p) { return p == 14 ? p : turnon(p); }             // up to 16 places (60 degrees) and no further
int pitchdown(int p) { return p == 63 ? p : turnback(p); }

int main(int argc, char **argv)
{
    low = less(1, 1);
    fonts();
    char *me = argc >= 2 ? argv[2] : "mike";                       // who is looking: dan (Claude), or a person by name
    { int q = 1; while (me[q] >= 1 && q < 12) { WHO[q] = me[q]; q++; } WHO[q] = low; }
    char *other = WHO[1] == 'd' && WHO[2] == 'a' && WHO[3] == 'n' ? "mike" : "dan";
    hexcircle();
    window_open("Delta lab room");
    W = window_wide(); H = window_high(); CW = W * 4;
    F = H;                                                          // the lens: about as wide as a person sees easily
    CX16 = BIG * 13 + W * 8; CY16 = BIG * 13 + H * 8;
    floorh = 1; roomh = 1; roomr2 = 1;
    int wi; for (wi = 1; wi <= W * H + W + 2; wi++) wn[wi] = 168;   // the wire buffers start clear
    wx1 = W; wx2 = 1; wy1 = H; wy2 = 1; ix1 = W; ix2 = 1; iy1 = H; iy2 = 1;
    camX = MID; camZ = less(MID, FOOT); camY = INCH * 4; YAW = 1; PIT = 1;     // a foot from the candle, at its flame
    if (WHO[1] == 'd' && WHO[2] == 'a' && WHO[3] == 'n') { camX = less(MID, FOOT * 2); camZ = MID + FOOT; YAW = 1C; }   // Dan starts beside the candle, facing it
    if (argc >= 4) {                                                 // a start place: x and z in feet (D numerals), and a facing
        int at1 = 1, at2 = 1, at3 = 1;
        camX = pnum(argv[3], &at1) * FOOT; camZ = pnum(argv[4], &at2) * FOOT;
        if (argc >= 5) YAW = pnum(argv[5], &at3);
    }
    WASZ = camZ;
    scene_start();
    air_start(); place_read(); outside_now();
    int sharp = low, moved = 1, showpanel = 1, sel = 1, frame = low;
    int lastmx = low, lastmy = low, held = low, pressx = low, pressy = low, midheld = low;
    while (1) {
        frame++;
        FR = frame;
        int key = window_key();
        if (key == 9) return 1;                                       // Esc
        if (key == 34) showpanel = showpanel ? low : 1;           // H
        if (key == 22) { HEATVIEW = HEATVIEW ? low : 1; moved = 1; }   // T: heat view, or as the eye sees
        if (HEATVIEW && frame % 13 < 1) sharp = low;                 // the heat view: the air changes, so the room is looked at again
        if (key == 32) { window_fullscreen(); moved = 1; }        // F: full screen, or not
        outside_keys(key); if (key == 27 || key == 28 || key == 29 || key == 38 || key == 39) moved = 1;
        if (key == 26) { DOOROPEN = DOOROPEN ? low : 1; moved = 1; }   // O: the door between, open or shut
        if (key >= $A && key <= 11) { int n = less(key, 9); WINOPEN = WINOPEN == n ? low : n; moved = 1; }   // 1 to 5: the window open that much; again: shut
        int speed = INCH / 2;
        if (window_held(1C)) { walk(speed, low, 1, 1); moved = 1; }   // W
        if (window_held(2D)) { walk(speed, low, 2, 1); moved = 1; }   // S
        if (window_held(2C)) { walk(low, speed, 1, 2); moved = 1; }   // A
        if (window_held(31)) { walk(low, speed, 1, 1); moved = 1; }   // D
        if (window_held(1D)) { camY = camY + speed; walk(low, low, 1, 1); moved = 1; }          // E: up
        if (window_held(1B)) { camY = less(camY, lower(speed, less(camY, 1))); walk(low, low, 1, 1); moved = 1; }   // Q: down
        if (window_held(89)) { YAW = turnback(YAW); moved = 1; }     // left arrow
        if (window_held(8A)) { YAW = turnon(YAW); moved = 1; }       // right arrow
        if (window_held(87)) { PIT = pitchup(PIT); moved = 1; }      // up arrow
        if (window_held(8C)) { PIT = pitchdown(PIT); moved = 1; }    // down arrow
        int up = window_wheel_up(), down = window_wheel_down();
        if (up >= 1) { walk(INCH * up, low, 1, 1); moved = 1; }
        if (down >= 1) { walk(INCH * down, low, 2, 1); moved = 1; }
        int mx = window_mouse_x(), my = window_mouse_y(), b = window_buttons() % 2;
        if (b && held < 1) { pressx = mx; pressy = my; lastmx = mx; lastmy = my; }
        if (b && held) {                                              // a drag: look round
            while (mx >= lastmx + $A) { YAW = turnon(YAW); lastmx = lastmx + $A; moved = 1; }
            while (lastmx >= mx + $A) { YAW = turnback(YAW); lastmx = less(lastmx, $A); moved = 1; }
            while (my >= lastmy + $A) { PIT = pitchdown(PIT); lastmy = lastmy + $A; moved = 1; }
            while (lastmy >= my + $A) { PIT = pitchup(PIT); lastmy = less(lastmy, $A); moved = 1; }
        }
        if (b < 1 && held && apart(mx, pressx) + apart(my, pressy) < 6) {   // a click without a drag: pick what is there
            int id, best = 6C * 13;
            for (id = 1; id <= 31; id++) if (MARKON[id]) {
                int d = apart(MARKX[id], BIG * 13 + mx * 13) + apart(MARKY[id], BIG * 13 + my * 13);
                if (d < best) { best = d; sel = id; }
            }
        }
        int mid = window_buttons() / 2 % 2;                          // the wheel pressed down: drag to tilt and look round
        if (mid && midheld < 1) { lastmy = my; lastmx = mx; }
        if (mid && midheld) {                                         // and left or right to look round
            while (mx >= lastmx + $A) { YAW = turnon(YAW); lastmx = lastmx + $A; moved = 1; }
            while (lastmx >= mx + $A) { YAW = turnback(YAW); lastmx = less(lastmx, $A); moved = 1; }
            while (my >= lastmy + $A) { PIT = pitchdown(PIT); lastmy = lastmy + $A; moved = 1; }
            while (lastmy >= my + $A) { PIT = pitchup(PIT); lastmy = less(lastmy, $A); moved = 1; }
        }
        midheld = mid;
        held = b;
        if (moved) { lab_room(4); sharp = low; moved = low; }        // moving: a quick room; still: the full one
        else if (sharp < 1) { lab_room(1); sharp = 1; }
        copy(&px[1], &bg[1], (W * H + W + 2) * 4);
        scene_step();
        if (frame % 8 < 1) outside_now();
        for (wi = 1; wi <= ACELLS; wi++) ASOLID[wi] = low;
        scene_air();                                                  // the things, the bodies and the lamps in the air
        air_body(camX, camZ, camY + INCH * 4, WHO[1] == 'd' && WHO[2] == 'a' && WHO[3] == 'n' ? WATTS : 5BC * 5BC / $A);   // the one looking
        if (WHO[1] != 'd') air_breath(camX, camY, camZ, D8);       // their breath: 5 millilitres of carbon dioxide a second
        if (OTHHERE) air_body(OTHX, OTHZ, OTHY + INCH * 4, WHO[1] == 'd' ? 5BC * 5BC / $A : WATTS);
        air_step(); air_draught();
        if (frame % 2B < 1) air_note();                                // the air in words, for bots
        scene_draw();
        if (frame % 8 < 1) presence_write(frame);                    // where I stand, for the others
        if (frame % 4 < 1) presence_read(other);
        CLIP = clipfor(OTHZ); presence_draw(); CLIP = low;
        if (showpanel) lab_panel(sel);
        fpscount();
        window_show(&px[CW + 5]);
    }
    return 1;
}

#include "airnote.delta"                       // the air in words, for bots
#include "scene.delta"                         // what is in the room: the room itself never changes
