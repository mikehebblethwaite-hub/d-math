#!/usr/bin/env python3
"""delta: the Delta compiler 0.14. Delta is C with D rules: always something.
Things count from 1 and move or change form; numbers are D numerals (digits 1-9 A-D).
Delta -> our own x86-64 assembly -> program. No C compiler, no C library:
printing and exit are Linux system calls from our own runtime.

  delta run file.delta [args]     build and run
  delta build file.delta [-o out] build a program
  delta asm file.delta            show the assembly it writes
"""
import os, re, subprocess, sys, tempfile

DIG = "123456789ABCD"
BANNED = {"NULL": "NULL is a make-believe zero: a pointer always points at something",
          "false": "false is a make-believe zero: say what is true instead",
          "EXIT_SUCCESS": "EXIT_SUCCESS is a make-believe zero: main ends with return 1 (all good)",
          "nullptr": "nullptr is a make-believe zero"}
TYPES = {"int", "long", "char", "void"}
FLOW_WORDS = {"store", "conduct", "neighbours", "spend", "tick", "wear", "mix"}
KEYWORDS = TYPES | FLOW_WORDS | {"thing", "vessel", "and", "fits", "if", "else", "while", "for", "return", "break", "continue", "move", "from", "to", "unsigned", "signed", "const", "static"}


def to_d(v):
    if v < 1: return "~"
    out = ""
    while v > 0:
        r = v % 13 or 13
        out = DIG[r - 1] + out
        v = (v - r) // 13
    return out


class DeltaError(Exception):
    def __init__(self, line, msg): super().__init__("line %s: %s" % (to_d(line), msg))


# ---------------------------------------------------------------- words (lexer + D rules)

TOK = re.compile(r'''
   (?P<ws>[ \t\r\n]+)
 | (?P<lc>//[^\n]*)
 | (?P<bc>/\*.*?\*/)
 | (?P<pp>\#[^\n]*)
 | (?P<str>"(?:\\.|[^"\\\n])*")
 | (?P<chr>'(?:\\.|[^'\\\n])+')
 | (?P<dnum>\$[0-9A-Za-z.]+)
 | (?P<num>[0-9][0-9A-Za-z_.]*)
 | (?P<dop>D>)
 | (?P<id>[A-Za-z_][A-Za-z0-9_]*)
 | (?P<op>->|==|!=|<=|>=|&&|\|\||\+\+|--|\+=|-=|\*=|/=|%=|[^\sA-Za-z0-9_])
''', re.S | re.X)

ESC = {"n": 10, "t": 9, "r": 13, "\\": 92, "'": 39, '"': 34, "a": 7, "e": 27}


def unescape(body, line):
    out, i = [], 0
    while i < len(body):
        c = body[i]
        if c == "\\":
            e = body[i + 1]
            if e not in ESC:
                raise DeltaError(line, "\\%s: that is the zero character or not known" % e)
            out.append(ESC[e]); i += 2
        else:
            out.extend(c.encode()); i += 1
    return out


def d_numeral(text, line):
    body = text[1:] if text.startswith("$") else text
    if "0" in body:
        raise DeltaError(line, "'%s': D numerals use the digits 1-9 A-D "
                            "(ten is $A, thirteen $D, fourteen 11)" % text)
    if "." in body:
        raise DeltaError(line, "'%s': fractions are not in Delta yet" % text)
    v = 0
    for ch in body:
        if ch not in DIG:
            raise DeltaError(line, "'%s' is not a D numeral (digits 1-9 A-D)" % text)
        v = v * 13 + DIG.index(ch) + 1
    return v


def lex(src):
    pos, line, out, defines = 0, 1, [], {}
    while pos < len(src):
        m = TOK.match(src, pos)
        kind, text = m.lastgroup, m.group()
        pos = m.end()
        if kind in ("ws", "lc", "bc"):
            line += text.count("\n"); continue
        if kind == "pp":
            pm = re.match(r"#\s*(\w+)\s*(.*)", text)
            word = pm.group(1) if pm else ""
            if word == "include":
                pass                                   # the runtime is built in
            elif word == "define":
                dm = re.match(r"(\w+)\s*(.*)", pm.group(2))
                defines[dm.group(1)] = [t for t in lex(dm.group(2))[0] if t[0] != "end"]
                for t in defines[dm.group(1)]: t[2] = line
            else:
                raise DeltaError(line, "'%s' is not known" % text.strip())
            continue
        if kind == "op" and text in ("-", "--", "-="):
            raise DeltaError(line, "in D things are moved (move N from a to b;) "
                                "or broken into parts, never taken below what is there")
        if kind == "id" and text in BANNED:
            raise DeltaError(line, BANNED[text])
        if kind == "id" and "0" in text:
            raise DeltaError(line, "'%s': in D every name and number is always something (no 0 in it)" % text)
        if kind in ("num", "dnum"):
            out.append(["num", d_numeral(text, line), line]); continue
        if kind == "chr":
            b = unescape(text[1:-1], line)
            if len(b) != 1: raise DeltaError(line, "%s is not one character" % text)
            out.append(["num", b[0], line]); continue
        if kind == "str":
            out.append(["str", unescape(text[1:-1], line), line]); continue
        if kind == "id" and text in defines:
            out.extend([list(t) for t in defines[text]]); continue
        out.append(["op" if kind == "dop" else kind, text, line])
    out.append(["end", "", line])
    return out, defines


# ---------------------------------------------------------------- types
# a type is (base, stars, dims): base int|char|void, stars = pointer depth, dims = array sizes

THINGS = {}     # thing name -> {"fields": {name: (type, offset)}, "order": [...], "size": n, "methods": {name: return type}}


def is_thing(t):
    return t[0].startswith("thing:") and not t[1] and not t[2]


def size_of(t):
    n = 1
    for d in t[2]: n *= d
    if t[0].startswith("thing:") and not t[1]: return n * THINGS[t[0][6:]]["size"]
    return n * (1 if (t[0] == "char" and not t[1]) else 8)


def elem_of(t, line):
    if t[2]: return (t[0], t[1], t[2][1:])
    if t[1]: return (t[0], t[1] - 1, ())
    raise DeltaError(line, "only rows and pointers have places to count")


INT = ("int", 0, ())


# ---------------------------------------------------------------- compiler

class Compiler:
    def __init__(self, toks):
        self.t, self.p = toks, 0
        self.out, self.strings, self.n = [], [], 0
        self.funcs = {}
        self.globals = {}

    # --- tokens
    def peek(self, k=0): return self.t[self.p + k]
    def at(self, text, k=0):
        tok = self.t[self.p + k]
        return tok[0] in ("op", "id") and tok[1] == text
    def take(self, text=None):
        tok = self.t[self.p]
        if text is not None and not self.at(text):
            raise DeltaError(tok[2], "expected '%s', found '%s'" % (text, tok[1] if tok[0] != "str" else "words"))
        self.p += 1
        return tok
    def name(self):
        tok = self.take()
        if tok[0] != "id" or tok[1] in KEYWORDS:
            raise DeltaError(tok[2], "expected a name, found '%s'" % tok[1])
        return tok[1]

    def emit(self, s): self.out.append("    " + s)
    def label(self, l): self.out.append(l + ":")
    def new(self, what="L"):
        self.n += 1
        return ".%s%d" % (what, self.n)
    def string(self, data):
        lab = ".S%d" % (len(self.strings) + 1)
        self.strings.append((lab, data))
        return lab

    # --- program
    def program(self):
        while self.peek()[0] != "end":
            if self.at("thing") and self.at("{", 2):
                self.thing_def(); continue
            k = self.p
            while not (self.t[k][1] in ("(", ";", "=", "[", ",") or self.t[k][0] == "end"): k += 1
            if self.t[k][1] == "(": self.function()
            else: self.global_decl()
        if "main" not in self.funcs:
            raise DeltaError(self.peek()[2], "no main")

    def global_decl(self):
        """int name = number, row[$D], *p;  kept for the whole run (LOW until set)."""
        base = self.base_type()
        while True:
            stars = 0
            while self.at("*"): self.take(); stars += 1
            line = self.peek()[2]; nm = self.name(); dims = []
            while self.at("["):
                self.take("["); d = self.take()
                if d[0] != "num": raise DeltaError(line, "a row size must be a number")
                dims.append(d[1]); self.take("]")
            if nm in self.globals: raise DeltaError(line, "'%s' is already here" % nm)
            v = None
            if self.at("="):
                self.take(); d = self.take()
                if d[0] != "num" or dims: raise DeltaError(line, "a kept-for-the-run value starts as a plain number")
                v = d[1]
            self.globals[nm] = ((base, stars, tuple(dims)), v)
            if self.at(","): self.take(); continue
            break
        self.take(";")

    def thing_def(self):
        """thing plum { int sugar, heat; char *name; int ripen(int n) { ... } };
           parts first, then its own ~ (the unknown energy it holds); functions act on it."""
        self.take("thing"); line = self.peek()[2]; tname = self.name()
        if tname in THINGS: raise DeltaError(line, "thing %s is already made" % tname)
        info = {"fields": {}, "order": [], "size": 1, "methods": {}}
        THINGS[tname] = info
        self.take("{"); off = 0; methods = []
        while not self.at("}"):
            start = self.p
            base = self.base_type()
            while True:
                stars = 0
                while self.at("*"): self.take(); stars += 1
                fline = self.peek()[2]; fn = self.name()
                if self.at("("):                        # a function of this thing
                    self.p = start; methods.append(start)
                    info["methods"][fn] = (base, stars, ())
                    while not self.at("{"): self.take()
                    depth = 0
                    while True:
                        if self.at("{"): depth += 1
                        if self.at("}"): depth -= 1
                        self.take()
                        if not depth: break
                    break
                dims = []
                while self.at("["):
                    self.take("["); d = self.take()
                    if d[0] != "num": raise DeltaError(fline, "a row size must be a number")
                    dims.append(d[1]); self.take("]")
                ft = (base, stars, tuple(dims))
                if is_thing(ft) and base[6:] == tname: raise DeltaError(fline, "a thing cannot hold itself (hold a place: thing %s *)" % tname)
                if fn in info["fields"]: raise DeltaError(fline, "'%s' is already a part of %s" % (fn, tname))
                info["fields"][fn] = (ft, off); info["order"].append(fn)
                off += (size_of(ft) + 7) // 8 * 8
                if self.at(","): self.take(); continue
                self.take(";"); break
        self.take("}")
        if self.at(";"): self.take()
        info["fields"]["~"] = (INT, off)           # its own unknown energy, always there
        info["size"] = off + 8
        after = self.p
        for start in methods:
            self.p = start; self.function(method_of=tname)
        self.p = after

    def base_type(self):
        if self.at("thing"):
            self.take(); line = self.peek()[2]; tn = self.name()
            if tn not in THINGS: raise DeltaError(line, "thing %s is not made (yet)" % tn)
            return "thing:" + tn
        while self.at("const") or self.at("static") or self.at("unsigned") or self.at("signed"):
            self.take()
        tok = self.take()
        if tok[1] not in TYPES: raise DeltaError(tok[2], "expected a type, found '%s'" % tok[1])
        return "int" if tok[1] == "long" else tok[1]

    def is_type(self):
        return any(self.at(w) for w in ("int", "long", "char", "void", "const", "static", "unsigned", "signed", "thing"))

    def function(self, method_of=None):
        base = self.base_type()
        stars = 0
        while self.at("*"): self.take(); stars += 1
        line = self.peek()[2]
        fname = self.name()
        self.take("(")
        params = []
        while not self.at(")"):
            if self.at("void") and self.at(")", 1): self.take(); break
            pb = self.base_type(); ps = 0
            while self.at("*"): self.take(); ps += 1
            pn = self.name()
            while self.at("["):                       # int a[] in a list = a pointer
                self.take("[")
                while not self.at("]"): self.take()
                self.take("]"); ps += 1
            params.append((pn, (pb, ps, ())))
            if not self.at(")"): self.take(",")
        self.take(")")
        if is_thing((base, stars, ())): raise DeltaError(line, "give back a thing by its place (thing %s *)" % base[6:])
        for pn, pt in params:
            if is_thing(pt): raise DeltaError(line, "give a thing by its place: thing %s *%s" % (pt[0][6:], pn))
        if method_of:
            params.insert(0, ("self", ("thing:" + method_of, 1, ())))
            key, label = method_of + "." + fname, method_of + "__" + fname
        else:
            key, label = fname, fname
        if len(params) > 6: raise DeltaError(line, "more than 6 inputs is not in Delta yet")
        self.funcs[key] = (base, stars, ())
        self.cur_thing = method_of
        self.fname, self.frame, self.scopes, self.loops = label, 0, [{}], []
        self.label("f_" + label)
        self.emit("push rbp"); self.emit("mov rbp, rsp")
        fix = len(self.out); self.emit("sub rsp, FRAME")
        regs = ["rdi", "rsi", "rdx", "rcx", "r8", "r9"]
        for (pn, pt), r in zip(params, regs):
            off = self.local(pn, pt, line)
            self.emit("mov [rbp-%d], %s" % (off, r))
        self.block()
        # falling off the end of main = all good (1)
        self.emit("mov eax, 1" if fname == "main" else "xor eax, eax")
        self.label(".Lret_" + self.fname)
        self.emit("mov rsp, rbp"); self.emit("pop rbp"); self.emit("ret")
        self.out[fix] = "    sub rsp, %d" % ((self.frame + 15) // 16 * 16)
        self.cur_thing = None

    def local(self, name, t, line):
        if name in self.scopes[-1]: raise DeltaError(line, "'%s' is already here" % name)
        sz = (size_of(t) + 7) // 8 * 8
        self.frame += sz
        self.scopes[-1][name] = (self.frame, t)
        return self.frame

    def find(self, name, line):
        for s in reversed(self.scopes):
            if name in s: return "rbp-%d" % s[name][0], s[name][1]
        if name in self.globals: return "rip+g_" + name, self.globals[name][0]
        raise DeltaError(line, "'%s' is not known here" % name)

    def place(self, name, line):
        """address of a name in rax: a local, a kept value, or (in a thing's function) one of its parts."""
        self.last_part = None
        try:
            where, t = self.find(name, line)
            self.emit("lea rax, [%s]" % where); return t
        except DeltaError:
            th = getattr(self, "cur_thing", None)
            if th and name in THINGS[th]["fields"]:
                where, _ = self.find("self", line)
                self.emit("mov rax, [%s]" % where)
                return self.part(th, name, line)
            raise

    def part(self, tname, name, line):
        info = THINGS[tname]
        if name not in info["fields"]: raise DeltaError(line, "%s has no part '%s'" % (tname, name))
        ft, off = info["fields"][name]
        if off: self.emit("add rax, %d" % off)
        self.last_part = (off, info["fields"]["~"][1])
        return ft

    # --- statements
    def block(self):
        self.take("{"); self.scopes.append({})
        while not self.at("}"): self.statement()
        self.take("}"); self.scopes.pop()

    def statement(self):
        tok = self.peek(); line = tok[2]
        if self.at("{"): return self.block()
        if self.at(";"): self.take(); return
        if self.is_type(): self.declaration(); self.take(";"); return
        if self.at("if"):
            self.take(); self.take("("); self.cond_false(els := self.new()); self.take(")")
            self.statement()
            if self.at("else"):
                end = self.new(); self.emit("jmp " + end); self.label(els)
                self.take(); self.statement(); self.label(end)
            else:
                self.label(els)
            return
        if self.at("while"):
            top, end = self.new(), self.new()
            self.take(); self.take("("); self.label(top); self.cond_false(end); self.take(")")
            self.loops.append((end, top)); self.statement(); self.loops.pop()
            self.emit("jmp " + top); self.label(end); return
        if self.at("for"):
            self.take(); self.take("("); self.scopes.append({})
            if self.is_type(): self.declaration()
            elif not self.at(";"): self.expr()
            self.take(";")
            top, step, end = self.new(), self.new(), self.new()
            self.label(top)
            if not self.at(";"): self.cond_false(end)
            self.take(";")
            # the step is written after the body: keep its tokens aside
            start = self.p; depth = 0
            while depth or not self.at(")"):
                if self.at("("): depth += 1
                if self.at(")"): depth -= 1
                self.take()
            step_toks = (start, self.p); self.take(")")
            self.loops.append((end, step)); self.statement(); self.loops.pop()
            self.label(step)
            if step_toks[1] > step_toks[0]:
                save = self.p; self.p = step_toks[0]; self.expr(); self.p = save
            self.emit("jmp " + top); self.label(end); self.scopes.pop(); return
        if self.at("return"):
            self.take()
            if not self.at(";"): self.expr()
            self.take(";"); self.emit("jmp .Lret_" + self.fname); return
        if self.at("break") or self.at("continue"):
            w = self.take()[1]
            if not self.loops: raise DeltaError(line, "%s outside a loop" % w)
            self.emit("jmp " + self.loops[-1][0 if w == "break" else 1]); self.take(";"); return
        if self.at("vessel"): self.vessel(); return
        if self.at("fits"): self.fits(); return
        if self.at("move"): self.move(); self.vcheck(); return
        if any(self.at(w) for w in FLOW_WORDS): self.flow_words(); return self.statement()
        k = self.p
        while self.t[k][1] != ";" and self.t[k][0] != "end":
            if self.t[k][0] == "op" and self.t[k][1] == "D>": self.decompose(); self.vcheck(); return
            k += 1
        self.expr(); self.take(";"); self.vcheck()

    def vcheck(self):
        """after anything that changes amounts: every vessel must still be full."""
        if self.uses_vessel and not self.fname.startswith("dl_"):
            self.emit("call f_dl_vcheck")

    def fits(self):
        """fits tank 13;  fits a.gas 4, b 9;  how much each can hold: a move needs room to go to."""
        line = self.take("fits")[2]
        while True:
            self.last_part = None
            t = self.lvalue()
            if t != INT: raise DeltaError(line, "fits is for a whole number or a part that holds one")
            self.emit("push rax"); self.expr(); self.emit("mov rsi, rax"); self.emit("pop rdi")
            self.emit("call f_dl_fits"); self.calls.append(("dl_fits", line))
            if self.at(","): self.take(); continue
            break
        self.take(";")

    def vessel(self):
        """vessel tank;  tank (a thing of whole numbers) is always full from now on."""
        line = self.take("vessel")[2]
        while True:
            nm = self.name(); where, t = self.find(nm, line)
            if not is_thing(t): raise DeltaError(line, "a vessel is a thing with parts (thing tank t; vessel t;)")
            info = THINGS[t[0][6:]]
            for fn in info["order"]:
                ft = info["fields"][fn][0]
                if ft != INT: raise DeltaError(line, "every part of a vessel holds a whole number ('%s' does not)" % fn)
            self.emit("lea rax, [%s]" % where); self.emit("push rax")
            lab = self.string(list(nm.encode()) + ["LOW"])
            self.emit("pop rdi"); self.emit("lea rsi, [rip+%s]" % lab); self.emit("mov rdx, %d" % (size_of(t) // 8))
            self.emit("call f_dl_vessel"); self.calls.append(("dl_vessel", line))
            if self.at(","): self.take(); continue
            break
        self.take(";")

    def declaration(self):
        base = self.base_type()
        while True:
            stars = 0
            while self.at("*"): self.take(); stars += 1
            line = self.peek()[2]; nm = self.name(); dims = []
            while self.at("["):
                self.take("[")
                if self.at("]"): dims.append(None)
                else:
                    d = self.take()
                    if d[0] != "num": raise DeltaError(line, "a row size must be a number")
                    dims.append(d[1])
                self.take("]")
            init = None
            if self.at("="):
                self.take()
                if self.at("{"):
                    init = self.brace_list()
                elif self.peek()[0] == "str" and dims:
                    init = ("str", self.take()[1])
                else:
                    init = "expr"
            if dims and dims[0] is None:                # int a[] = {..}: size from the list
                dims[0] = len(init[1]) + 1 if init and init[0] == "str" else len(self.flat(init))
            t = (base, stars, tuple(dims))
            if init == "expr":
                rt = self.expr()            # value first, then the name exists
                off = self.local(nm, t, line)
                self.store_to(f"rbp-{off}", t)
            else:
                off = self.local(nm, t, line)
                if init is None:                      # not set yet: it holds ~
                    self.emit("lea rdi, [rbp-%d]" % off); self.emit("mov rcx, %d" % ((size_of(t) + 7) // 8 * 8))
                    self.emit("mov eax, LOW"); self.emit("rep stosb")
                if init is not None and is_thing(t):
                    self.emit("lea rdi, [rbp-%d]" % off); self.emit("mov rcx, %d" % ((size_of(t) + 7) // 8 * 8))
                    self.emit("mov eax, LOW"); self.emit("rep stosb")     # its ~ and parts not given hold ~
                    info = THINGS[base[6:]]; vals = self.flat(init)
                    if len(vals) > len(info["order"]): raise DeltaError(line, "more values than parts in %s" % nm)
                    for fn, v in zip(info["order"], vals):
                        ft, foff = info["fields"][fn]
                        if isinstance(v, int): self.emit("mov rax, %d" % v)
                        else:
                            save = self.p; self.p = v[1]; self.expr(); self.p = save
                        self.store_to("rbp-%d" % (off - foff), ft)
                    init = None
                if init is not None:
                    esz = 1 if (base == "char" and not stars) else 8
                    vals = init[1] + [None] if init[0] == "str" else self.flat(init)
                    cap = 1
                    for d in dims: cap *= d
                    if len(vals) > cap: raise DeltaError(line, "more values than places in %s" % nm)
                    for k in range(cap):          # places not given are LOW
                        v = vals[k] if k < len(vals) else None
                        addr = "rbp-%d" % (off - k * esz)
                        if v is None:
                            self.emit("mov %s ptr [%s], LOW" % ("byte" if esz == 1 else "qword", addr))
                        elif isinstance(v, int):
                            self.emit("mov rax, %d" % v); self.emit("mov [%s], %s" % (addr, "al" if esz == 1 else "rax"))
                        else:
                            save = self.p; self.p = v[1]; self.expr(); self.p = save
                            self.emit("mov [%s], %s" % (addr, "al" if esz == 1 else "rax"))
            if self.at(","): self.take(); continue
            break

    def brace_list(self):
        """{ a, b, {c, d} } -> nested lists of token positions (numbers kept as ints)."""
        self.take("{"); items = []
        while not self.at("}"):
            if self.at("{"): items.append(self.brace_list())
            else:
                start = self.p; depth = 0
                while depth or not (self.at(",") or self.at("}")):
                    if self.at("(") or self.at("{"): depth += 1
                    if self.at(")") or self.at("}"): depth -= 1
                    self.take()
                if self.p == start + 1 and self.t[start][0] == "num": items.append(self.t[start][1])
                else: items.append(["at", start])     # any other value: read it when it is stored
            if self.at(","): self.take()
        self.take("}")
        return ("list", items)

    def flat(self, init):
        out = []
        for it in init[1]:
            if isinstance(it, tuple): out.extend(self.flat(it))
            else: out.append(it)
        return out

    def move(self):
        """move N from a to b;  the total stays the same.
           move N from a to b and M from c to d;  all in one step (in and out at the same time)."""
        self.take("move")
        while True:
            self.move_one()
            if self.at("and"): self.take(); continue
            break
        self.take(";")

    def move_one(self):
        line = self.peek()[2]
        self.expr(); self.emit("push rax")
        self.take("from"); start = self.p; at = self.lvalue(); self.emit("push rax")
        an = "".join(str(x[1]) for x in self.t[start:self.p])
        if not self.at("to"):                      # move N from x;  to x's lowest neighbour
            if not self.uses_flow:
                raise DeltaError(line, "%s has no neighbours: say where it goes (move N from %s to y;)" % (an, an))
            lab = self.string(list(an.encode()) + ["LOW"])
            self.emit("pop rdi"); self.emit("pop rsi"); self.emit("lea rdx, [rip+%s]" % lab)
            self.emit("call f_dl_moveout"); self.calls.append(("dl_moveout", line))
            return
        self.take("to"); bn = self.peek()[1]; bt = self.lvalue(); self.emit("push rax")
        less, more, ok = self.new(), self.new(), self.new()
        self.emit("pop r9"); self.emit("pop r8"); self.emit("pop rax")
        self.emit("cmp rax, 1"); self.emit("jl " + less)
        self.emit("cmp rax, [r8]"); self.emit("jg " + more)
        full = None
        if self.uses_room and not self.fname.startswith("dl_"):   # it needs room where it goes
            full = self.new()
            self.emit("push rax"); self.emit("push r8"); self.emit("push r9")
            self.emit("mov rdi, r9"); self.emit("call f_dl_room"); self.emit("mov rcx, rax")
            self.emit("pop r9"); self.emit("pop r8"); self.emit("pop rax")
            self.emit("cmp rax, rcx"); self.emit("jg " + full)
        self.emit("sub [r8], rax")                # under the hood: a gives, b takes
        self.emit("add [r9], rax"); self.emit("jmp " + ok)
        if full:                                  # pushed past full: the extra moves on to a neighbour with room, or it ruptures
            self.label(full)
            self.emit("sub [r8], rax"); self.emit("add [r9], rax")
            lab = self.string(list(bn.encode()) + ["LOW"])
            self.emit("mov rdi, r9"); self.emit("lea rsi, [rip+%s]" % lab)
            self.emit("call f_dl_overflow"); self.calls.append(("dl_overflow", line))
            self.emit("jmp " + ok)
        self.label(less)
        self.say_text("Delta line %s: move needs 1 or more\n" % to_d(line), fd=2)
        self.emit("mov edi, 2"); self.emit("jmp dl_exit")
        self.label(more)
        self.emit("push qword ptr [r8]"); self.emit("push rax")
        self.say_text("Delta line %s: cannot move " % to_d(line), fd=2)
        self.emit("pop rdi"); self.emit("call dl_putd")
        self.say_text(" from %s, it holds " % an, fd=2)
        self.emit("pop rdi"); self.emit("call dl_putd")
        self.say_text("\n", fd=2)
        self.emit("mov edi, 2"); self.emit("jmp dl_exit")
        self.label(ok)

    def flow_words(self):
        """store a, b;   conduct wire loss 1;   neighbours wire: a, b;   spend N from x;
           written out as calls to flow.delta, then read as ordinary Delta."""
        tok = self.take(); word, line = tok[1], tok[2]
        end = self.p
        while not self.at(";", end - self.p):
            if self.t[end][0] == "end": raise DeltaError(line, "%s needs a ; at its end" % word)
            end += 1
        body = self.t[self.p:end]
        T = lambda k, v: [k, v, line]
        def thing(nm, kind, loss):
            nm = nm if isinstance(nm, list) else [nm]
            if not nm or nm[0][0] != "id" or nm[0][1] in KEYWORDS: raise DeltaError(line, "%s takes names (or parts: p.sugar)" % word)
            text = "".join(str(x[1]) for x in nm)
            return [T("id", "dl_thing"), T("op", "("), T("op", "&")] + [list(x) for x in nm] + [T("op", ","),
                    T("str", list(text.encode()) + ["LOW"]), T("op", ","), T("num", kind), T("op", ","),
                    *loss, T("op", ")")]
        def split(toks, sep=","):
            out, cur, depth = [], [], 0
            for t in toks:
                if t[1] in ("(", "["): depth += 1
                if t[1] in (")", "]"): depth -= 1
                if t[1] == sep and not depth and t[0] == "op": out.append(cur); cur = []
                else: cur.append(t)
            if cur: out.append(cur)
            return out
        new = []
        if word == "store":
            for part in split(body):
                k = next((i for i, x in enumerate(part) if x[1] == "leak"), None)
                if k is None:
                    new += thing(part, 1, [T("num", 1)]) + [T("op", ";")]
                else:                                   # store x leak N;  it loses N a tick through its wall
                    if not k or k + 1 >= len(part): raise DeltaError(line, "store x leak N;")
                    new += [T("id", "dl_setleak"), T("op", "(")] + thing(part[:k], 1, [T("num", 1)]) \
                           + [T("op", ",")] + part[k + 1:] + [T("op", ")"), T("op", ";")]
        elif word == "mix":                             # mix a, b;  next to each other: shared parts even out
            names = split(body)
            if len(names) != 2 or any(len(n) != 1 for n in names): raise DeltaError(line, "mix a, b;")
            (_, ta), (_, tb) = self.find(names[0][0][1], line), self.find(names[1][0][1], line)
            pairs = []
            if is_thing(ta) and is_thing(tb):
                fa, fb = THINGS[ta[0][6:]], THINGS[tb[0][6:]]
                common = [f for f in fa["order"] if f in fb["fields"] and fa["fields"][f][0] == INT and fb["fields"][f][0] == INT]
                if not common: raise DeltaError(line, "%s and %s have no parts in common to mix" % (names[0][0][1], names[1][0][1]))
                for f in common:
                    pairs.append(([names[0][0], T("op", "."), T("id", f)], [names[1][0], T("op", "."), T("id", f)]))
            elif ta == INT and tb == INT:
                pairs.append((names[0], names[1]))
            else:
                raise DeltaError(line, "mix two things (their shared parts mix) or two whole numbers")
            open_wall = [T("num", 13 ** 6)]          # no wall between them: only the difference limits it
            for a, b in pairs:
                for x in (a, b):
                    new += [T("id", "dl_setleak"), T("op", "(")] + thing(x, 1, [T("num", 1)]) + [T("op", ",")] + open_wall + [T("op", ")"), T("op", ";")]
                new += [T("id", "dl_link2"), T("op", "(")] + thing(a, 3, [T("num", 1)]) + [T("op", ",")] + thing(b, 3, [T("num", 1)]) + [T("op", ")"), T("op", ";")]
        elif word == "wear":                            # wear rubber by sun per N D> dust + gas ~;  each tick
            k = next((i for i, x in enumerate(body) if x[0] == "op" and x[1] == "D>"), None)
            if not k: raise DeltaError(line, "wear x by y per N D> a + b ~;")
            parts = split(body[k + 1:], "+")
            if not parts or parts[-1][-1][1] != "~": raise DeltaError(line, "every wear ends with ~: the unknown energy it leaves")
            parts[-1] = parts[-1][:-1]
            if not parts[-1]: parts = parts[:-1]
            if not parts: raise DeltaError(line, "wear needs at least one known part before ~")
            head = body[:k]
            bi = next((i for i, x in enumerate(head) if x[1] == "by"), None)
            if not bi: raise DeltaError(line, "wear needs what wears it, a neighbour: wear rubber by sun D> dust ~;")
            pi = next((i for i, x in enumerate(head) if x[1] == "per"), None)
            by = head[bi + 1:pi] if pi else head[bi + 1:]
            per = head[pi + 1:] if pi else [T("num", 1)]
            if not by or not per: raise DeltaError(line, "wear x by y per N D> a + b ~;")
            new += [T("id", "dl_wear"), T("op", "(")] + thing(head[:bi], 3, [T("num", 1)]) + [T("op", ",")] \
                   + thing(by, 3, [T("num", 1)]) + [T("op", ",")] + per + [T("op", ")"), T("op", ";")]
            for pt in parts:
                new += [T("id", "dl_wear_part"), T("op", "(")] + thing(pt, 3, [T("num", 1)]) + [T("op", ")"), T("op", ";")]
        elif word == "tick":                            # tick;  tick N;  time passes, every leak shown
            n = body if body else [T("num", 1)]
            new += [T("id", "for"), T("op", "("), T("id", "int"), T("id", "dl_t"), T("op", "="), T("num", 1), T("op", ";"),
                    T("id", "dl_t"), T("op", "<="), T("op", "(")] + n + [T("op", ")"), T("op", ";"),
                    T("id", "dl_t"), T("op", "++"), T("op", ")"), T("op", "{"),
                    T("id", "dl_tick1"), T("op", "("), T("id", "dl_t"), T("op", ")"), T("op", ";"), T("op", "}")]
        elif word == "conduct":
            for part in split(body):
                k = next((i for i, x in enumerate(part) if x[1] == "loss"), None)
                if not k or k + 1 >= len(part): raise DeltaError(line, "conduct wire loss N;")
                new += thing(part[:k], 2, part[k + 1:]) + [T("op", ";")]
        elif word == "neighbours":
            k = next((i for i, x in enumerate(body) if x[0] == "op" and x[1] == ":"), None)
            if not k or k + 1 >= len(body): raise DeltaError(line, "neighbours x: a, b, c;")
            for part in split(body[k + 1:]):
                new += [T("id", "dl_link2"), T("op", "(")] + thing(body[:k], 3, [T("num", 1)]) + [T("op", ",")] \
                       + thing(part, 3, [T("num", 1)]) + [T("op", ")"), T("op", ";")]
        else:
            k = next((i for i, t in enumerate(body) if t[1] == "from"), None)
            if k is None or k + 1 >= len(body): raise DeltaError(line, "spend N from x;")
            new += [T("id", "dl_spend"), T("op", "(")] + thing(body[k + 1:], 3, [T("num", 1)]) + [T("op", ",")] \
                   + body[:k] + [T("op", ")"), T("op", ";")]
        self.t[self.p:end + 1] = new
        if not self.uses_flow: raise DeltaError(line, "flow is not loaded")

    def hidden(self):
        self.frame += 8
        return "rbp-%d" % self.frame

    def decompose(self):
        """whole D> a + b + c ~;        even shares to the named (known) parts
           whole D> 3 a + 2 b ~;        given amounts to the known parts
           Every breakdown ends with ~: a thing broken down to its lowest point keeps only
           its unknown energy (~). What does not go to a known part stays in it as that ~.
           Known parts + ~ = what the whole held; no part vanishes."""
        line = self.peek()[2]
        wname = self.peek()[1]
        self.last_part = None
        wt = self.lvalue(); w = self.hidden(); self.emit("mov [%s], rax" % w)
        own = None                                       # the thing's own ~, when the whole is one of its parts
        if self.last_part:
            foff, toff = self.last_part
            own = self.hidden()
            if toff > foff: self.emit("add rax, %d" % (toff - foff))
            self.emit("mov [%s], rax" % own)
        self.check_count(wt, wname, line)
        self.take("D>")
        parts, amounts = [], []
        while True:
            amt = None
            if self.peek()[0] == "num" or self.at("("):
                self.unary(); amt = self.hidden(); self.emit("mov [%s], rax" % amt)
            pname = self.peek()[1]
            pt = self.lvalue(); slot = self.hidden(); self.emit("mov [%s], rax" % slot)
            self.check_count(pt, pname, line)
            parts.append(slot); amounts.append(amt)
            if self.at("+"): self.take(); continue
            break
        if any(amounts) and not all(amounts):
            raise DeltaError(line, "give every known part an amount, or none (then they share evenly)")
        if not self.at("~"):
            raise DeltaError(line, "every breakdown ends with ~: the unknown energy left in %s" % wname)
        self.take("~")
        if not self.at(";"):
            raise DeltaError(line, "~ is the unknown energy left in %s: it has no name. A named part is a known part (write it before ~)" % wname)
        self.take(";")
        lowest, little, ok = self.new(), self.new(), self.new()
        self.emit("mov r8, [%s]" % w); self.emit("mov rax, [r8]")
        self.emit("cmp rax, 1"); self.emit("jl " + lowest)
        if all(amounts):
            self.emit("mov rdx, rax")                       # rdx = what is not given yet
            for a in amounts:
                self.emit("mov rcx, [%s]" % a)
                self.emit("cmp rcx, 1"); self.emit("jl " + little)
                self.emit("cmp rcx, rdx"); self.emit("jg " + little)
                self.emit("sub rdx, rcx")                   # under the hood only
            for a, slot in zip(amounts, parts):
                self.emit("mov rcx, [%s]" % a); self.emit("mov r9, [%s]" % slot); self.emit("add [r9], rcx")
        else:
            self.emit("mov rcx, %d" % len(parts)); self.emit("cqo"); self.emit("idiv rcx")
            self.emit("cmp rax, 1"); self.emit("jl " + little)
            for slot in parts:
                self.emit("mov r9, [%s]" % slot); self.emit("add [r9], rax")
        # rdx = what stays in the whole as its unknown energy; ~ adds up all of it
        self.emit("add [rip+dl_unknown], rdx")
        if own: self.emit("mov r9, [%s]" % own); self.emit("add [r9], rdx")   # it keeps its own ~
        self.emit("mov qword ptr [r8], LOW")                # the whole now holds only ~
        self.emit("jmp " + ok)
        for lab, text in ((lowest, "%s is at its lowest point: only ~ (unknown energy) is left in it" % wname),
                          (little, "%s is too little for those parts" % wname)):
            self.label(lab)
            self.say_text("Delta line %s: %s\n" % (to_d(line), text), fd=2)
            self.emit("mov edi, 2"); self.emit("jmp dl_exit")
        self.label(ok)

    def check_count(self, t, nm, line):
        if t[1] or t[2] or size_of(t) != 8:
            raise DeltaError(line, "'%s' must hold a whole number to break down or take parts" % nm)

    def say_text(self, text, fd=None):
        if fd: self.emit("mov qword ptr [rip+dl_fd], %d" % fd)
        data = list(text.encode()) if isinstance(text, str) else text
        if not data: return
        lab = self.string(data)
        self.emit("lea rdi, [rip+%s]" % lab); self.emit("mov rsi, %d" % len(data)); self.emit("call dl_write")

    def cond_false(self, target):
        self.expr(); self.emit("test rax, rax"); self.emit("jz " + target)

    # --- expressions: value in rax, returns its type
    def expr(self): return self.assign()

    def assign(self):
        start = self.p
        lhs_t = self.logic_or()
        if self.at("?"):                            # a ? b : c
            self.take(); no, end = self.new(), self.new()
            self.emit("test rax, rax"); self.emit("jz " + no)
            t = self.assign(); self.take(":"); self.emit("jmp " + end)
            self.label(no); self.assign(); self.label(end)
            return t
        for op in ("=", "+=", "*=", "/=", "%="):
            if self.at(op):
                line = self.take()[2]
                end = self.p; self.p = start
                t = self.lvalue(); self.emit("push rax")
                self.p = end
                rt = self.assign()
                self.emit("pop rcx")
                if op != "=":
                    self.emit("mov rdx, rax"); self.load_from("rcx", t, keep="rcx")
                    if op == "+=": self.emit("add rax, rdx")
                    elif op == "*=": self.emit("imul rax, rdx")
                    else:
                        self.emit("push rcx"); self.emit("mov rcx, rdx"); self.emit("cqo"); self.emit("idiv rcx"); self.emit("pop rcx")
                        if op == "%=": self.emit("mov rax, rdx")
                if self.uses_flow and t == INT and not self.fname.startswith("dl_"):
                    self.emit("push rax"); self.emit("push rcx")
                    self.emit("mov rdi, rcx"); self.emit("mov rsi, rax"); self.emit("call f_dl_lower")
                    self.emit("pop rcx"); self.emit("pop rax")
                self.store_to("rcx", t)
                return t
        return lhs_t

    def logic_or(self):
        t = self.logic_and()
        while self.at("||"):
            self.take(); yes, end = self.new(), self.new()
            self.emit("test rax, rax"); self.emit("jnz " + yes)
            self.logic_and(); self.emit("test rax, rax"); self.emit("jnz " + yes)
            self.emit("xor eax, eax"); self.emit("jmp " + end)
            self.label(yes); self.emit("mov eax, 1"); self.label(end); t = INT
        return t

    def logic_and(self):
        t = self.equality()
        while self.at("&&"):
            self.take(); no, end = self.new(), self.new()
            self.emit("test rax, rax"); self.emit("jz " + no)
            self.equality(); self.emit("test rax, rax"); self.emit("jz " + no)
            self.emit("mov eax, 1"); self.emit("jmp " + end)
            self.label(no); self.emit("xor eax, eax"); self.label(end); t = INT
        return t

    def binary(self, nxt, ops):
        t = nxt()
        while any(self.at(o) for o in ops):
            op = self.take()[1]
            self.emit("push rax"); rt = nxt(); self.emit("mov rcx, rax"); self.emit("pop rax")
            t = self.apply(op, t, rt)
        return t

    def equality(self): return self.binary(self.relation, ("==", "!="))
    def relation(self): return self.binary(self.additive, ("<=", ">=", "<", ">"))
    def additive(self): return self.binary(self.term, ("+",))
    def term(self): return self.binary(self.unary, ("*", "/", "%"))

    def apply(self, op, lt, rt):
        setcc = {"==": "sete", "!=": "setne", "<": "setl", ">": "setg", "<=": "setle", ">=": "setge"}
        if op in setcc:
            self.emit("cmp rax, rcx"); self.emit(setcc[op] + " al"); self.emit("movzx eax, al"); return INT
        if op == "+":
            if lt[1] or lt[2]:
                es = size_of(elem_of(lt, 0))
                if es != 1: self.emit("imul rcx, %d" % es)
                self.emit("add rax, rcx"); return (lt[0], lt[1] + (1 if lt[2] else 0), ()) if lt[2] else lt
            self.emit("add rax, rcx"); return INT
        if op == "*": self.emit("imul rax, rcx"); return INT
        self.emit("cqo"); self.emit("idiv rcx")
        if op == "%": self.emit("mov rax, rdx")
        return INT

    def unary(self):
        line = self.peek()[2]
        if self.at("!"):
            self.take(); self.unary(); self.emit("test rax, rax"); self.emit("sete al"); self.emit("movzx eax, al"); return INT
        if self.at("+"): self.take(); return self.unary()
        if self.at("(") and self.peek(1)[1] in TYPES:      # (type) value
            self.take(); base = self.base_type(); stars = 0
            while self.at("*"): self.take(); stars += 1
            self.take(")"); self.unary()
            if base == "char" and not stars: self.emit("movzx eax, al")
            return (base, stars, ())
        if self.at("&"):
            self.take(); t = self.lvalue_unary(); return (t[0], t[1] + 1, ())
        if self.at("*"):
            self.take(); t = self.unary(); et = elem_of(t, line); self.load_from("rax", et); return et
        if self.at("++"):
            self.take(); t = self.lvalue_unary()
            self.emit("inc %s ptr [rax]" % ("byte" if size_of(t) == 1 else "qword"))
            self.load_from("rax", t); return t
        return self.postfix()

    def lvalue_unary(self):
        if self.at("*"):
            line = self.take()[2]; t = self.unary(); return elem_of(t, line)
        return self.lvalue()

    def postfix(self):
        start = self.p
        t = self.primary()
        line = self.peek()[2]
        if not (self.at("[") or self.at("++") or self.at(".") or self.at("->")):
            return t
        self.p = start; t = self.lvalue()           # read it again as a place
        if self.at(".") or self.at("->"):           # a thing's own function
            if self.take()[1] == "->":
                t = elem_of(t, line); self.emit("mov rax, [rax]")
            if not is_thing(t): raise DeltaError(line, "only a thing has its own functions")
            return self.method_call(t[0][6:], line)
        if self.at("++"):
            self.take()
            self.emit("mov rcx, rax"); self.load_from("rcx", t)
            self.emit("inc %s ptr [rcx]" % ("byte" if size_of(t) == 1 else "qword"))
        else:
            self.load_from("rax", t)
        return t

    def primary(self):
        tok = self.peek(); line = tok[2]
        if tok[0] == "num":
            self.take(); self.emit("mov rax, %d" % tok[1]); return INT
        if tok[0] == "str":
            self.take(); data = [b for b in tok[1] if b != "LOW"]
            while self.peek()[0] == "str": data = data + self.take()[1]
            lab = self.string(data + ["LOW"]); self.emit("lea rax, [rip+%s]" % lab); return ("char", 1, ())
        if self.at("("):
            self.take(); t = self.expr(); self.take(")"); return t
        if self.at("~"):                               # the unknown parts so far
            self.take(); self.emit("mov rax, [rip+dl_unknown]"); return INT
        if tok[0] == "id" and self.at("(", 1):
            return self.call()
        if tok[0] == "id":
            self.take()
            t = self.place(tok[1], line); self.load_from("rax", t); return t
        raise DeltaError(line, "did not expect '%s'" % (tok[1] if tok[0] != "str" else "words"))

    def lvalue(self):
        """address in rax; returns the type that lives there."""
        tok = self.peek(); line = tok[2]
        if self.at("("):
            self.take(); t = self.lvalue(); self.take(")")
        elif self.at("~"):
            self.take(); self.emit("lea rax, [rip+dl_unknown]"); t = INT
        elif self.at("*"):
            self.take(); t = self.unary(); t = elem_of(t, line)
        else:
            nm = self.name(); t = self.place(nm, line)
        while self.at("[") or self.at(".") or self.at("->"):
            if self.at(".") or self.at("->"):
                arrow = self.at("->")
                nxt = self.peek(1)
                th = elem_of(t, line) if arrow else t
                if not is_thing(th): raise DeltaError(line, "only a thing has parts")
                tn = th[0][6:]
                if nxt[0] == "id" and nxt[1] in THINGS[tn]["methods"] and self.at("(", 2):
                    return t                       # stop before its function; the caller calls it
                self.take()
                if arrow: self.emit("mov rax, [rax]")
                pn = "~" if self.at("~") else None
                if pn: self.take()
                else: pn = self.name()
                t = self.part(tn, pn, line)
                continue
            self.last_part = None
            self.take("[")
            if t[2]: pass                          # a row: its address is already in rax
            elif t[1]: self.emit("mov rax, [rax]") # a pointer: follow it
            else: raise DeltaError(line, "only rows and pointers have places to count")
            et = elem_of(t, line)
            self.emit("push rax"); self.expr(); self.take("]")
            # counting starts at 1: place i is (i - 1) steps along. Under the hood only.
            es = size_of(et)
            self.emit("dec rax")
            if es != 1: self.emit("imul rax, %d" % es)
            self.emit("pop rcx"); self.emit("add rax, rcx")
            t = et
        return t

    def load_from(self, reg, t, keep=None):
        if t[2] or is_thing(t):                     # a row's or a thing's value is where it starts
            if reg != "rax": self.emit("mov rax, %s" % reg)
            return
        if size_of(t) == 1: self.emit("movzx eax, byte ptr [%s]" % reg)
        else: self.emit("mov rax, [%s]" % reg)

    def store_to(self, where, t):
        where = where if where.startswith("[") else "[%s]" % where
        if t[2]: raise DeltaError(0, "a whole row cannot be set at once")
        if is_thing(t):                             # a whole thing: copy every part (rax = the other thing)
            self.emit("mov rsi, rax"); self.emit("lea rdi, %s" % where)
            self.emit("mov rcx, %d" % size_of(t)); self.emit("rep movsb"); return
        if size_of(t) == 1: self.emit("mov byte ptr %s, al" % where)
        else: self.emit("mov qword ptr %s, rax" % where)

    def call(self):
        tok = self.take(); fname = tok[1]; line = tok[2]
        self.take("(")
        if fname == "say": return self.say(line)
        th = getattr(self, "cur_thing", None)
        if fname not in self.funcs and th and fname in THINGS[th]["methods"]:
            where, _ = self.find("self", line)          # its own function, on itself
            self.emit("mov rax, [%s]" % where)
            return self.method_call(th, line, named=fname)
        n = 0
        while not self.at(")"):
            self.expr(); self.emit("push rax"); n += 1
            if not self.at(")"): self.take(",")
        self.take(")")
        if n > 6: raise DeltaError(line, "more than 6 inputs is not in Delta yet")
        for r in reversed(["rdi", "rsi", "rdx", "rcx", "r8", "r9"][:n]): self.emit("pop " + r)
        self.emit("call f_" + fname)
        self.calls.append((fname, line))
        return self.funcs.get(fname, INT)

    def method_call(self, tname, line, named=None):
        """self (the thing's place) is in rax; its function gets it first."""
        mname = named or self.name()
        if mname not in THINGS[tname]["methods"]: raise DeltaError(line, "%s has no function '%s'" % (tname, mname))
        if named is None: self.take("(")
        self.emit("push rax"); n = 1
        while not self.at(")"):
            self.expr(); self.emit("push rax"); n += 1
            if not self.at(")"): self.take(",")
        self.take(")")
        if n > 6: raise DeltaError(line, "more than 5 inputs to a thing's function is not in Delta yet")
        for r in reversed(["rdi", "rsi", "rdx", "rcx", "r8", "r9"][:n]): self.emit("pop " + r)
        self.emit("call f_%s__%s" % (tname, mname))
        return THINGS[tname]["methods"][mname]

    def say(self, line):
        """say("text %d %s %c", ...): the words are read now; numbers print as D numerals."""
        tok = self.take()
        if tok[0] != "str": raise DeltaError(line, "say needs its words in quotes first")
        fmt = [b for b in tok[1] if b != "LOW"]
        while self.peek()[0] == "str": fmt = fmt + self.take()[1]
        self.emit("mov qword ptr [rip+dl_fd], 1")
        piece, i = [], 0
        while i < len(fmt):
            c = fmt[i]
            if c == ord("%") and i + 1 < len(fmt):
                k = chr(fmt[i + 1])
                if k == "l" and i + 2 < len(fmt) and chr(fmt[i + 2]) == "d": i += 1; k = "d"
                if k == "%": piece.append(c); i += 2; continue
                if k not in "dsc": raise DeltaError(line, "say knows %%d %%s %%c, not %%%s" % k)
                self.say_text(piece); piece = []
                self.take(","); self.expr(); self.emit("mov rdi, rax")
                self.emit("call " + {"d": "dl_putd", "s": "dl_puts", "c": "dl_putc"}[k])
                i += 2; continue
            piece.append(c); i += 1
        self.say_text(piece)
        if not self.at(")"): raise DeltaError(line, "say has more values than %d %s %c places")
        self.take(")")
        return INT


RUNTIME = r'''
# Delta runtime 0.14: our own, straight to Linux. LOW = a bit lower than 1 (the old "0" label),
# it always carries ~ (static, radiation, outside forces, forces not yet known).
.set LOW, 1-1
.text
.globl _start
_start:
    mov rdi, [rsp]              # how many words on the command line
    lea rsi, [rsp+8]            # the words; argv[1] is the program itself
    call f_main
    mov rdi, rax
    cmp rax, 1                  # main gives 1 = all good; Linux calls that LOW
    jne dl_exit
    mov edi, LOW
dl_exit:
    mov eax, 60
    syscall
f_stop:                         # stop(n): end the program now with n
    jmp dl_exit
dl_write:                       # rdi = where, rsi = how many bytes
    mov rdx, rsi
    mov rsi, rdi
    mov rdi, [rip+dl_fd]
    mov eax, 1
    syscall
    ret
dl_puts:                        # rdi = words ending in a LOW byte
    mov rcx, rdi
1:  cmp byte ptr [rcx], LOW
    je 2f
    inc rcx
    jmp 1b
2:  mov rsi, rcx
    sub rsi, rdi
    jmp dl_write
dl_putc:                        # rdi = one character
    push rdi
    mov rdi, rsp
    mov rsi, 1
    call dl_write
    pop rdi
    ret
dl_putd:                        # rdi = number -> D numeral; below 1 shows as ~
    cmp rdi, 1
    jge 1f
    lea rdi, [rip+dl_tilde]
    mov rsi, 1
    jmp dl_write
1:  sub rsp, 72
    lea r8, [rsp+64]
    mov rax, rdi
    mov r9, 13
    lea r10, [rip+dl_digits]
2:  xor edx, edx
    div r9
    test rdx, rdx
    jnz 3f
    mov rdx, 13                 # no zero digit: a full 13 is D, carry one less
    dec rax
3:  mov cl, [r10+rdx-1]
    dec r8
    mov [r8], cl
    test rax, rax
    jnz 2b
    mov rdi, r8
    lea rsi, [rsp+64]
    sub rsi, r8
    call dl_write
    add rsp, 72
    ret
.data
dl_fd:     .quad 1
dl_unknown: .quad LOW           # ~ : all the unknown energy left in things broken down (always there, not known yet)
dl_digits: .ascii "123456789ABCD"
dl_tilde:  .ascii "~"
'''


def compile_dc(src):
    toks, _ = lex(src)
    uses_flow = any(t[0] == "id" and t[1] in FLOW_WORDS for t in toks)
    uses_vessel = any(t[0] == "id" and t[1] == "vessel" for t in toks)
    uses_room = uses_flow or uses_vessel or any(t[0] == "id" and t[1] == "fits" for t in toks)
    uses_flow = uses_flow or uses_room            # a rupture empties to the neighbours
    here = os.path.dirname(os.path.abspath(__file__))
    for used, f in ((uses_vessel, "vessel.delta"), (uses_flow, "flow.delta"), (uses_room, "room.delta")):
        if used:
            ftoks, _ = lex(open(os.path.join(here, f)).read())
            toks = ftoks[:-1] + toks
    THINGS.clear()
    c = Compiler(toks); c.calls = []; c.uses_flow = uses_flow; c.cur_thing = None; c.last_part = None
    c.uses_vessel = uses_vessel; c.uses_room = uses_room; c.fname = ""
    c.program()
    for fname, line in c.calls:
        if fname not in c.funcs and fname != "stop": raise DeltaError(line, "'%s' is not made anywhere" % fname)
    asm = [".intel_syntax noprefix", RUNTIME, ".text"] + c.out + ["", ".data"]
    for nm, (t, v) in c.globals.items():
        if v is not None: asm.append("g_%s: .quad %d" % (nm, v))
    asm.append(".bss")
    for nm, (t, v) in c.globals.items():
        if v is None: asm.append("g_%s: .skip %d" % (nm, (size_of(t) + 7) // 8 * 8))
    asm += ["", ".section .rodata"]
    for lab, data in c.strings:
        asm.append("%s: .byte %s" % (lab, ", ".join(str(b) for b in data)))
    return "\n".join(asm) + "\n"


def main():
    if len(sys.argv) < 3 or sys.argv[1] not in ("build", "run", "asm"):
        print(__doc__.strip()); sys.exit(2)
    cmd, path = sys.argv[1], sys.argv[2]
    try:
        asm = compile_dc(open(path).read())
    except DeltaError as e:
        print("Delta %s: %s" % (os.path.basename(path), e), file=sys.stderr); sys.exit(2)
    if cmd == "asm":
        print(asm); return
    out = os.path.splitext(path)[0]
    if "-o" in sys.argv: out = sys.argv[sys.argv.index("-o") + 1]
    d = os.path.dirname(os.path.abspath(out))
    with tempfile.TemporaryDirectory(dir=d) as tmp:
        s, o = os.path.join(tmp, "p.s"), os.path.join(tmp, "p.o")
        open(s, "w").write(asm)
        for step in (["as", "--64", s, "-o", o], ["ld", "-static", "-n", o, "-o", out]):
            r = subprocess.run(step, capture_output=True, text=True)
            if r.returncode:
                print("Delta %s: the assembly did not go through (a Delta bug):\n%s" % (os.path.basename(path), r.stderr), file=sys.stderr)
                sys.exit(3)
    if cmd == "run":
        sys.exit(subprocess.run([os.path.abspath(out)] + sys.argv[3:]).returncode)


if __name__ == "__main__":
    main()
