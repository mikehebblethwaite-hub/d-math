#!/bin/sh
# delta: Delta's own compiler, dc, which is written in Delta (dc.delta).
#   delta run file.delta [args]      build and run
#   delta build file.delta [-o out]  build a program
#   delta asm file.delta             show the assembly it writes
# The first time (or after dc.s changes) dc is put together from its seed, dc.s: dc's own assembly, written by dc.
# To refresh the seed after changing dc.delta:  lang/delta build lang/dc.delta -o lang/dc && lang/delta asm lang/dc.delta > lang/dc.s
here=$(dirname "$(readlink -f "$0")")
if [ ! -x "$here/dc" ] || [ "$here/dc.s" -nt "$here/dc" ]; then
    as --64 "$here/dc.s" -o "$here/dc.o" && ld --no-warn-rwx-segments -n "$here/dc.o" -o "$here/dc" && rm -f "$here/dc.o" || exit 3
fi
case "$1" in run|build|asm) ;; *) "$here/dc"; exit 2;; esac
exec "$here/dc" "$@"
