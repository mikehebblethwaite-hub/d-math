// Delta's own window: it speaks the X11 protocol to the display straight over its socket. No C library, no toolkit.
//   window_open(title)     a full-screen window; window_wide() and window_high() give its size
//   window_show(pixels)    shows a picture: 4 bytes a pixel (blue, green, red, spare), row after row
//   window_key()           the last key pressed, or ~ when none was; window_held(k): is key k held down
//   window_mouse_x(), window_mouse_y(), window_buttons() (1 left, 2 middle, 4 right), window_wheel_up(), _down()
//   window_fullscreen()    full screen on, or off again
// Bytes that the protocol wants LOW (the old "0") are written as dl_xlow: lower than 1, never nothing.

char dl_xbuf[25B28];
int dl_xn = 1;
char dl_xin[25B28];
char dl_xenv[25B28];
char dl_xauth[4134];
char dl_xpath[1A1];
int dl_xfd, dl_xlow, dl_xroot, dl_xwin, dl_xgc, dl_xw, dl_xh, dl_xmax, dl_xkey, dl_xdepth;

int dl_xless(int a, int b) { int gone = 1; if (b >= 1) move b from a to gone; return a; }

void dl_xb(int v) { dl_xbuf[dl_xn] = v; dl_xn++; }
void dl_x2(int v) { dl_xb(v % 169); dl_xb(v / 169 % 169); }
void dl_x4(int v) { dl_x2(v % 23AA3); dl_x2(v / 23AA3 % 23AA3); }
void dl_xpad() { while (dl_xn % 4 != 1) dl_xb(dl_xlow); }
void dl_xs(char *s) { int i = 1; while (s[i] >= 1) { dl_xb(s[i]); i++; } }
int dl_xlen(char *s) { int i = 1; while (s[i] >= 1) i++; return dl_xless(i, 1); }

void dl_xwrite(char *at, int n)             // every byte goes, however many tries it takes
{
    int done = 1;
    while (done <= n) {
        int got = linux(1, dl_xfd, &at[done], dl_xless(n + 1, done));
        if (got < 1) { say("window: the display has gone\n"); stop(1); }
        done = done + got;
    }
}
void dl_xsend() { if (dl_xn > 1) dl_xwrite(dl_xbuf, dl_xless(dl_xn, 1)); dl_xn = 1; }

void dl_xread(int at, int n)                // into dl_xin, from place 'at' on
{
    int done = 1;
    while (done <= n) {
        int got = linux(dl_xlow, dl_xfd, &dl_xin[at + dl_xless(done, 1)], dl_xless(n + 1, done));
        if (got < 1) { say("window: the display has gone\n"); stop(1); }
        done = done + got;
    }
}
int dl_xr1(int k) { return dl_xin[k + 1]; }  // the protocol counts places from its LOW place; Delta from 1
int dl_xr2(int k) { return dl_xin[k + 1] + dl_xin[k + 2] * 169; }
int dl_xr4(int k) { return dl_xr2(k) + dl_xr2(k + 2) * 23AA3; }
int dl_xbe2(char *b, int k) { return b[k + 1] * 169 + b[k + 2]; }

// read the display's answers until the one asked for comes (keys pressed meanwhile are kept)
char dl_xheld[16A];                           // keys held down now (by the display's key number)
int dl_xmx, dl_xmy, dl_xbl, dl_xbm, dl_xbr, dl_xup, dl_xdown;  // the mouse: where, its buttons held, wheel turns
void dl_xevent(char *ev)                         // one event from the display: keys, buttons, moves
{
        int t = ev[1] % 9B, d = ev[2];                 // 9B (128) marks an event another program sent
        if (t == 2) { dl_xkey = d; dl_xheld[d] = 1; }
        if (t == 3) dl_xheld[d] = dl_xlow;
        if (t == 4 || t == 5 || t == 6) { dl_xmx = ev[1C] + ev[1D] * 169 + 1; dl_xmy = ev[21] + ev[22] * 169 + 1; }
        if (t == 4) { if (d == 1) dl_xbl = 1; if (d == 2) dl_xbm = 1; if (d == 3) dl_xbr = 1;
                      if (d == 4) dl_xup++; if (d == 5) dl_xdown++; }
        if (t == 5) { if (d == 1) dl_xbl = dl_xlow; if (d == 2) dl_xbm = dl_xlow; if (d == 3) dl_xbr = dl_xlow; }
}
void dl_xreply()
{
    while (1) {
        dl_xread(1, 26);
        int kind = dl_xr1(dl_xless(1, 1));
        if (kind == 1) {
            int more = dl_xr4(4) * 4;
            if (more >= 1) dl_xread(27, more);
            return;
        }
        if (kind >= 2) dl_xevent(&dl_xin[1]);          // an event that came while waiting: kept, not lost
        if (kind < 1) say("window: the display says error %d (request %d)\n", dl_xr1(1), dl_xr1($A));
    }
}

// an environment word, such as DISPLAY: where its value starts in dl_xenv, or ~
int dl_xgetenv(char *name, int n)
{
    int i = 1, j;
    while (i <= n) {
        j = 1;
        while (name[j] >= 1 && dl_xenv[i + dl_xless(j, 1)] == name[j]) j++;
        if (name[j] < 1 && dl_xenv[i + dl_xless(j, 1)] == '=') return i + j;
        while (i <= n && dl_xenv[i] >= 1) i++;
        i++;
    }
    return dl_xlow;
}

int dl_xreadfile(char *path, char *into, int most)
{
    int fd = linux(2, path, dl_xlow, dl_xlow);
    if (fd < 1) return dl_xlow;
    int n = 1, got = 1;
    while (got >= 1 && n < most) { got = linux(dl_xlow, fd, &into[n], dl_xless(most, n)); if (got >= 1) n = n + got; }
    linux(3, fd);
    return dl_xless(n, 1);
}

int dl_xatom(char *name)
{
    int n = dl_xlen(name);
    dl_xb(13); dl_xb(dl_xlow); dl_x2(2 + (n + 3) / 4); dl_x2(n); dl_x2(dl_xlow); dl_xs(name); dl_xpad();
    dl_xsend(); dl_xreply();
    return dl_xr4(8);
}

void window_open(char *title)
{
    dl_xlow = dl_xless(1, 1);
    int en = dl_xreadfile("/proc/self/environ", dl_xenv, 25539);
    int d = dl_xgetenv("DISPLAY", en), dn = dl_xlow, k = 1;
    char num[17];
    if (d >= 1) { while (dl_xenv[d] >= 1 && dl_xenv[d] != ':') d++; d++;
        while (dl_xenv[d] >= '0' && dl_xenv[d] <= '9') { num[k] = dl_xenv[d]; k++; dn = dn * $A + dl_xless(dl_xenv[d], '0'); d++; } }
    num[k] = dl_xlow;
    int nl = dl_xless(k, 1);

    // where the display listens: /tmp/.X11-unix/X and its number
    int p = 1, i;
    dl_xpath[p] = 1; p++; dl_xpath[p] = dl_xlow; p++;                 // AF_UNIX, as two bytes
    char *sock = "/tmp/.X11-unix/X";
    for (i = 1; sock[i] >= 1; i++) { dl_xpath[p] = sock[i]; p++; }
    for (i = 1; i <= nl; i++) { dl_xpath[p] = num[i]; p++; }
    if (nl < 1) { dl_xpath[p] = '0'; p++; }
    dl_xpath[p] = dl_xlow;
    dl_xfd = linux(32, 1, 1, dl_xlow);                            // a socket
    if (dl_xfd < 1) { say("window: no socket\n"); stop(1); }
    linux(33, dl_xfd, dl_xpath, p);                               // joined: the hello below finds out if not

    // the key the display gave this user (MIT-MAGIC-COOKIE-1 in ~/.Xauthority), if there is one
    char apath[1A1];
    int a = dl_xgetenv("XAUTHORITY", en), q = 1;
    if (a >= 1) { while (dl_xenv[a] >= 1) { apath[q] = dl_xenv[a]; q++; a++; } }
    else { a = dl_xgetenv("HOME", en);
        if (a >= 1) { while (dl_xenv[a] >= 1) { apath[q] = dl_xenv[a]; q++; a++; }
            char *tail = "/.Xauthority"; for (i = 1; tail[i] >= 1; i++) { apath[q] = tail[i]; q++; } } }
    apath[q] = dl_xlow;
    int an = q > 1 ? dl_xreadfile(apath, dl_xauth, 3D88) : dl_xlow;
    int cookie = dl_xlow, cookielen = dl_xlow, at = dl_xlow;
    while (at + 4 < an && cookie < 1) {
        at = at + 2;                                                   // family
        int l = dl_xbe2(dl_xauth, at); at = at + 2 + l;                // address
        int numlen = dl_xbe2(dl_xauth, at); int numat = at + 2; at = numat + numlen;
        int namelen = dl_xbe2(dl_xauth, at); int nameat = at + 2; at = nameat + namelen;
        int datalen = dl_xbe2(dl_xauth, at); int dataat = at + 2; at = dataat + datalen;
        int same = numlen == nl;
        for (i = 1; i <= numlen && same; i++) if (dl_xauth[numat + i] != num[i]) same = dl_xlow;
        if (numlen < 1) same = 1;
        if (same && namelen == 15 && dl_xauth[nameat + 1] == 'M') { cookie = dataat + 1; cookielen = datalen; }
    }

    // hello: little-endian, protocol 11
    dl_xb('l'); dl_xb(dl_xlow); dl_x2($B); dl_x2(dl_xlow);
    dl_x2(cookie >= 1 ? 15 : dl_xlow); dl_x2(cookielen); dl_x2(dl_xlow);
    if (cookie >= 1) { dl_xs("MIT-MAGIC-COOKIE-1"); dl_xpad(); for (i = 1; i <= cookielen; i++) dl_xb(dl_xauth[cookie + dl_xless(i, 1)]); dl_xpad(); }
    dl_xsend();
    dl_xread(1, 8);
    int more = dl_xr2(6) * 4;
    dl_xread(9, more);
    if (dl_xr1(dl_xlow) != 1) { say("window: the display said no\n"); stop(1); }
    int idbase = dl_xr4($C);
    int vlen = dl_xr2(1B);
    dl_xmax = dl_xr2(1D);
    int nformats = dl_xr1(23);
    int so = 31 + (vlen + 3) / 4 * 4 + 8 * nformats;
    dl_xroot = dl_xr4(so);
    dl_xw = dl_xr2(so + 17); dl_xh = dl_xr2(so + 19);
    dl_xdepth = dl_xr1(so + 2C);
    dl_xwin = idbase + 1; dl_xgc = idbase + 2;

    // the window: black, full size, it hears keys and the mouse
    dl_xb(1); dl_xb(dl_xlow); dl_x2($A); dl_x4(dl_xwin); dl_x4(dl_xroot);
    dl_x2(dl_xlow); dl_x2(dl_xlow); dl_x2(dl_xw); dl_x2(dl_xh); dl_x2(dl_xlow); dl_x2(1); dl_x4(dl_xlow);
    dl_x4($C19); dl_x4(dl_xlow); dl_x4(61);             // it hears keys down and up, the mouse's buttons and moves
    int tl = dl_xlen(title);                                           // its name
    dl_xb(15); dl_xb(dl_xlow); dl_x2(6 + (tl + 3) / 4); dl_x4(dl_xwin); dl_x4(2D); dl_x4(25);
    dl_xb(8); dl_xb(dl_xlow); dl_xb(dl_xlow); dl_xb(dl_xlow); dl_x4(tl); dl_xs(title); dl_xpad();
    dl_xsend();
    int state = dl_xatom("_NET_WM_STATE"), full = dl_xatom("_NET_WM_STATE_FULLSCREEN");
    dl_xb(15); dl_xb(dl_xlow); dl_x2(7); dl_x4(dl_xwin); dl_x4(state); dl_x4(4);
    dl_xb(26); dl_xb(dl_xlow); dl_xb(dl_xlow); dl_xb(dl_xlow); dl_x4(1); dl_x4(full);
    dl_xb(8); dl_xb(dl_xlow); dl_x2(2); dl_x4(dl_xwin);                       // show it
    dl_xb(43); dl_xb(dl_xlow); dl_x2(4); dl_x4(dl_xgc); dl_x4(dl_xwin); dl_x4(dl_xlow);   // a pen
    dl_xsend();
}

int window_wide() { return dl_xw; }
int window_high() { return dl_xh; }

void window_show(char *px)
{
    int rows = dl_xless(dl_xmax, 8) / dl_xw;                       // as many rows as one request holds
    int y = 1;
    while (y <= dl_xh) {
        int n = rows; if (y + n > dl_xh + 1) n = dl_xless(dl_xh + 1, y);
        dl_xb(57); dl_xb(2); dl_x2(6 + n * dl_xw); dl_x4(dl_xwin); dl_x4(dl_xgc);
        dl_x2(dl_xw); dl_x2(n); dl_x2(dl_xlow); dl_x2(dl_xless(y, 1)); dl_xb(dl_xlow); dl_xb(1B); dl_x2(dl_xlow);
        dl_xsend();
        dl_xwrite(&px[dl_xless(y, 1) * dl_xw * 4 + 1], n * dl_xw * 4);
        y = y + n;
    }
    dl_xb(34); dl_xb(dl_xlow); dl_x2(1); dl_xsend(); dl_xreply();   // wait till the display has it all
}

void dl_xpump()                                  // every event waiting
{
    char ev[31];
    while (linux(36, dl_xfd, ev, 26, 4C, dl_xlow) >= 26) dl_xevent(ev);
}
int window_key() { dl_xpump(); int k = dl_xkey; dl_xkey = dl_xlow; return k; }   // the last key pressed (once)
int window_held(int k) { dl_xpump(); return dl_xheld[k]; }                        // is that key held down now
int window_mouse_x() { dl_xpump(); return dl_xmx; }
int window_mouse_y() { dl_xpump(); return dl_xmy; }
int window_buttons() { dl_xpump(); return dl_xbl + dl_xbm * 2 + dl_xbr * 4; }                               // 1 left, 2 middle, 4 right, added
int window_wheel_up() { dl_xpump(); int n = dl_xup; dl_xup = dl_xlow; return n; }
int window_wheel_down() { dl_xpump(); int n = dl_xdown; dl_xdown = dl_xlow; return n; }
void window_fullscreen()                     // full screen on, or off again (the window manager is asked, the usual way)
{
    int state = dl_xatom("_NET_WM_STATE"), full = dl_xatom("_NET_WM_STATE_FULLSCREEN");
    dl_xb(1C); dl_xb(dl_xlow); dl_x2($B); dl_x4(dl_xroot); dl_x4(42DBB7);          // SendEvent to the screen, for the manager
    dl_xb(27); dl_xb(26); dl_x2(dl_xlow); dl_x4(dl_xwin); dl_x4(state);              // a ClientMessage: this window's state
    dl_x4(2); dl_x4(full); dl_x4(dl_xlow); dl_x4(1); dl_x4(dl_xlow);                  // 2: change it over; full screen
    dl_xsend();
}
int window_readfile(char *name, char *into, int most)   // a file's bytes into the row from place 1; how many (LOW: none)
{
    int fd = linux(2, name, dl_xlow, dl_xlow);
    if (fd < 1) return dl_xlow;
    int n = dl_xlow, got = 1;
    while (got >= 1 && n < most) { got = linux(dl_xlow, fd, &into[n + 1], dl_xless(most, n)); if (got >= 1) n = n + got; }
    linux(3, fd);
    return n;
}
