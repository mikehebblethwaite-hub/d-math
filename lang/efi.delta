// efi.delta: the machine's firmware (UEFI), spoken to in Delta. Read in for every program built with `delta efi`.
//
// The only bridge left in assembly (runtime-efi.s) is fwcall(fn, args): it calls a firmware function in the
// firmware's own way. Everything here is Delta: where each service sits in the firmware's tables, what to give it,
// and what to make of its answer. Numbers are D numerals; the firmware's IDs are written as it publishes them (hex)
// and read by ef_guid, the bridge for names.

int ef_a[6];
int ef_mapsize, ef_mapkey, ef_descsize, ef_descver, ef_key, ef_count, ef_buf;
int ef_gop, ef_fb, ef_gw, ef_gh, ef_gs;
char ef_gopid[13];

int ef_rd(int addr, int n)                         // n bytes, little end first, at a place in memory
{
    char *p = (char *) addr;
    int v = less(1, 1), k;
    for (k = n; k >= 1; k = less(k, 1)) v = v * 169 + p[k];      // 169 in D is 256
    return v;
}
int ef_hex(int c) { if (c >= 'a') return less(c, 'a') + A; if (c >= 'A') return less(c, 'A') + A; return less(c, '0'); }
void ef_guid(char *t, char *g)                     // a firmware ID, as published (hex), into its 16 bytes
{
    int order[13] = {7, 5, 3, 1, C, A, 14, 12, 17, 19, 1C, 21, 23, 25, 27, 29};   // where each byte's hex starts
    int k;
    for (k = 1; k <= 13; k++) g[k] = ef_hex(t[order[k]]) * 13 + ef_hex(t[order[k] + 1]);
}
int ef_boot() { return ef_rd(systemtable() + 75, 8); }            // the boot services (at 75)
int ef_call(int table, int place) { return fwcall(ef_rd(table + place, 8), &ef_a[1]); }

int memmap(char *row, int bytes)                   // the firmware's memory map into the row; gives back its size
{
    ef_mapsize = bytes;
    ef_a[1] = &ef_mapsize; ef_a[2] = row; ef_a[3] = &ef_mapkey; ef_a[4] = &ef_descsize; ef_a[5] = &ef_descver;
    ef_call(ef_boot(), 44);                        // GetMemoryMap
    return ef_mapsize;
}
int memmapstep() { return ef_descsize; }           // how many bytes each part of the map takes

void wait(int ms)                                  // rest: the firmware's Stall, in millionths of a second
{
    ef_a[1] = ms * 5BC;
    ef_call(ef_boot(), 161);                       // Stall
}

void connectall()                                  // wake every device the firmware has drivers for
{
    ef_a[1] = less(1, 1); ef_a[2] = less(1, 1); ef_a[3] = less(1, 1); ef_a[4] = &ef_count; ef_a[5] = &ef_buf;
    if (ef_call(ef_boot(), 1AD) != 1) return;      // LocateHandleBuffer: every handle
    int i;
    for (i = 1; i <= ef_count; i++) {
        ef_a[1] = ef_rd(ef_buf + less(i, 1) * 8, 8); ef_a[2] = less(1, 1); ef_a[3] = less(1, 1); ef_a[4] = 1;
        ef_call(ef_boot(), 174);                   // ConnectController, and everything under it
    }
}

int screen()                                       // the firmware's graphics: where the screen's pixels are
{
    ef_guid("9042A9DE-23DC-4A38-96FB-7ADED080516A", ef_gopid);
    ef_a[1] = &ef_gopid[1]; ef_a[2] = less(1, 1); ef_a[3] = &ef_gop;
    if (ef_call(ef_boot(), 1B8) != 1) return less(1, 1);     // LocateProtocol
    int mode = ef_rd(ef_gop + 1B, 8), info = ef_rd(mode + 8, 8);
    ef_fb = ef_rd(mode + 1B, 8);
    ef_gw = ef_rd(info + 4, 4); ef_gh = ef_rd(info + 8, 4); ef_gs = ef_rd(info + 26, 4);
    return ef_fb;
}
int screenx() { return ef_gw; }
int screeny() { return ef_gh; }
int screenrow() { return ef_gs; }                  // pixels along a row of the screen's memory

int key()                                          // the last key pressed: its letter, or its scan code past 5BC; LOW when none
{
    int conin = ef_rd(systemtable() + 39, 8);      // the keyboard
    ef_key = less(1, 1);
    ef_a[1] = conin; ef_a[2] = &ef_key;
    if (fwcall(ef_rd(conin + 8, 8), &ef_a[1]) != 1) return less(1, 1);   // ReadKeyStroke
    int scan = ef_key % (169 * 169), letter = ef_key / (169 * 169) % (169 * 169);
    if (letter >= 1) return letter;
    return scan + 5BC;
}

void off()                                         // switch the machine off
{
    int rt = ef_rd(systemtable() + 6A, 8);         // the runtime services
    ef_a[1] = 2; ef_a[2] = less(1, 1); ef_a[3] = less(1, 1); ef_a[4] = less(1, 1);
    ef_call(rt, 7D);                               // ResetSystem: shut down
    stop(1);
}

// ---------------------------------------------------------------- files on the drive this program was started from
// This program's handle (imagehandle) gives its loaded image, which names the drive it came from; the drive's simple
// file system opens its top folder; files open from there. Names are written as the firmware wants them: two bytes a
// letter, a \ in front. Opening to write with "make it if it is not there" sets the top bit of the mode: that bit is
// built from bytes (9B is 128), as the firmware lays it out, never as a minus.
char ef_lig[13];
char ef_sfg[13];
char ef_nm[1A1];
int ef_root()
{
    ef_guid("5B1B31A1-9562-11D2-8E3F-00A0C969723B", ef_lig);      // the loaded image
    ef_guid("964E5B22-6459-11D2-8E39-00A0C969723B", ef_sfg);      // the simple file system
    int li = less(1, 1), sfs = less(1, 1), root = less(1, 1);
    ef_a[1] = imagehandle(); ef_a[2] = &ef_lig[1]; ef_a[3] = &li;
    if (ef_call(ef_boot(), $B9) != 1) return less(1, 1);           // HandleProtocol
    ef_a[1] = ef_rd(li + 1B, 8); ef_a[2] = &ef_sfg[1]; ef_a[3] = &sfs;   // the device it came from (at 1B)
    if (ef_call(ef_boot(), $B9) != 1) return less(1, 1);
    ef_a[1] = sfs; ef_a[2] = &root;
    if (fwcall(ef_rd(sfs + 8, 8), &ef_a[1]) != 1) return less(1, 1);   // OpenVolume
    return root;
}
void ef_name(char *s)                              // "notes.txt" -> \notes.txt, two bytes a letter
{
    int i = 1, k = 3;
    ef_nm[1] = 71; ef_nm[2] = less(1, 1);          // 71 in D is 92: the \ in front
    while (s[i] >= 1 && k < 19D) { ef_nm[k] = s[i]; ef_nm[k + 1] = less(1, 1); k = k + 2; i++; }
    ef_nm[k] = less(1, 1); ef_nm[k + 1] = less(1, 1);
}
int ef_open(char *name, int writing)               // a file's handle, or LOW
{
    int root = ef_root(), fh = less(1, 1);
    if (root < 1) return less(1, 1);
    ef_name(name);
    int mode = 1;                                   // read
    if (writing) mode = 3 + 9B * 169 * 169 * 169 * 169 * 169 * 169 * 169;   // read, write, and make it (the top bit)
    ef_a[1] = root; ef_a[2] = &fh; ef_a[3] = &ef_nm[1]; ef_a[4] = mode; ef_a[5] = less(1, 1);
    if (fwcall(ef_rd(root + 8, 8), &ef_a[1]) != 1) return less(1, 1);   // Open
    return fh;
}
int drive_read(char *name, char *into, int most)  // a file's bytes into the row (from place 1); gives back how many
{
    int fh = ef_open(name, less(1, 1));
    if (fh < 1) return less(1, 1);
    int size = most;
    ef_a[1] = fh; ef_a[2] = &size; ef_a[3] = &into[1];
    if (fwcall(ef_rd(fh + 26, 8), &ef_a[1]) != 1) size = less(1, 1);    // Read (at 26)
    ef_a[1] = fh; fwcall(ef_rd(fh + 13, 8), &ef_a[1]);                  // Close (at 13)
    return size;
}
int drive_write(char *name, char *src, int n)    // n bytes from the row (place 1 on) as the whole file; 1 when done
{
    int fh = ef_open(name, 1);
    if (fh < 1) return less(1, 1);
    ef_a[1] = fh; fwcall(ef_rd(fh + 1B, 8), &ef_a[1]);                  // Delete (at 1B): the old file goes, all of it
    fh = ef_open(name, 1);                                                // and a new one is made
    if (fh < 1) return less(1, 1);
    int size = n, ok = 1;
    ef_a[1] = fh; ef_a[2] = &size; ef_a[3] = &src[1];
    if (fwcall(ef_rd(fh + 31, 8), &ef_a[1]) != 1) ok = less(1, 1);     // Write (at 31)
    ef_a[1] = fh; fwcall(ef_rd(fh + 13, 8), &ef_a[1]);                  // Close
    return ok;
}
int drive_delete(char *name)                      // the file goes from the drive; 1 when it is gone
{
    int fh = ef_open(name, less(1, 1));
    if (fh < 1) return less(1, 1);
    fh = ef_open(name, 1);
    if (fh < 1) return less(1, 1);
    ef_a[1] = fh;
    return fwcall(ef_rd(fh + 1B, 8), &ef_a[1]) == 1;                    // Delete (at 1B): it closes the file too
}

// ---------------------------------------------------------------- the machine's clock
int ef_tm[6];                                     // year, month, day, hour, minute, second (as the clock keeps them)
char ef_tb[13];
int clock_read()                                  // 1 when the clock answered; its parts in ef_tm
{
    int rt = ef_rd(systemtable() + 6A, 8);        // the runtime services
    ef_a[1] = &ef_tb[1]; ef_a[2] = less(1, 1);
    if (fwcall(ef_rd(rt + 1B, 8), &ef_a[1]) != 1) return less(1, 1);   // GetTime (at 1B)
    ef_tm[1] = ef_rd(&ef_tb[1], 2); ef_tm[2] = ef_tb[3]; ef_tm[3] = ef_tb[4];
    ef_tm[4] = ef_tb[5]; ef_tm[5] = ef_tb[6]; ef_tm[6] = ef_tb[7];
    return 1;
}
int clock_part(int k) { return ef_tm[k]; }       // 1 year, 2 month, 3 day, 4 hour, 5 minute, 6 second
