..1894891..692.297....792.296..23...594..495...32........792297..............189981...............1551....................................................................";
    hexcircle();
    ready = low; ours = low; firmware = low; held = low; all = low; devices = low;
    tlen = low; typed[1] = low; akind = low;
    countmemory();
    connectall();                                  // wake every device, the mouse too
    int got = screen();
    if (got < 1) { say("  the firmware gave no screen\n"); stop(1); }
    char *fb = (char *) got;
    W = screenx(); H = screeny(); CW = W * 4;
    int rowb = screenrow() * 4;
    ix1 = W; ix2 = 1; iy1 = H; iy2 = 1;
    MX = W / 2; MY = H / 2;
    findmouse();
    background();
    layout();
    FR = 1;
    while (1) {
        copy(&px[1], &bg[1], (W * H + W + 2) * 4);
        listen();
        pollmouse();
        int mb = MB, mx = MX, my = MY;
        clicks(mx, my, mb);
        int ex = W / 2, ey = H * 3 / $A, er = H / 6;
        pushed = MODE == 3 && mb >= 1 && apart(mx, ex) * apart(mx, ex) + apart(my, ey) * apart(my, ey) < er * er;
        if (pushed) TURN = TURN + 9; else TURN = TURN + 2;               // a push: the spirals take the energy
        if (MODE == 1) desktop();
        if (MODE == 2) dragonfly();
        if (MODE == 3) saypanel();
        if (MODE == 4) memorypanel();
        tx = 1B; ty = 1B; text("Delta Hex OS 0.08", $B8, $B8, $BB); text("   no zero, written in Delta", 93, 99, $A8);
        if (mx >= 1) pointer(mx, my);
        int y;
        for (y = 1; y <= H; y++) copy(&fb[less(y, 1) * rowb + 1], &px[at(1, y)], CW);
        wait(31);
        FR++;
    }
    return 1;
}
