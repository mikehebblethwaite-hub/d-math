# qwowt.net, deltahexos.com, deltahexos.co.uk: the same site at each address, on two servers in turn (Mike 20 Nov 2026). www and plain http go
# to https:// on the same name, without www (301).
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
# On the coop half, coop-one holds the certificate and passes visitors on by plain http with X-Forwarded-Proto: https.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
